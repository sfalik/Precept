precept ApartmentRentalApplication

# ============================================================================
# DOMAIN: Real Estate Rentals — Apartment Rental Application Workflow
# ============================================================================
# Demonstrates: choice types, set types, optional fields, guard conditions
#   on transitions, event ensure constraints, multi-path review flow, and
#   terminal-state discipline (two distinct terminal outcomes).
# ============================================================================

# ============================================================================
# APPLICANT INFORMATION
# ============================================================================
field ApplicantName as string optional
field EmailAddress as string optional
field PhoneNumber as string optional
field CurrentAddress as string optional

# ============================================================================
# APPLICATION DETAILS
# ============================================================================
field ApplicationType as choice of string("Individual", "Joint", "Corporate") default "Individual"
field PetPreference as choice of string("None", "Dog", "Cat", "Bird", "Other") default "None"
field LeaseTerm as choice of string("6 months", "12 months", "18 months", "24 months") default "12 months"
field MoveInDate as instant optional

# ============================================================================
# FINANCIAL INFORMATION
# ============================================================================
field MonthlyIncome as money in 'USD' default '0.00 USD'
field CreditScore as integer default 0 nonnegative
field SecurityDeposit as money in 'USD' default '0.00 USD'
field ApplicationFeePaid as boolean default false

# ============================================================================
# EMERGENCY CONTACTS — set of string (collection type demonstration)
# ============================================================================
field EmergencyContacts as set of string

# ============================================================================
# OPTIONAL: PET INFORMATION (optional field demonstration)
# ============================================================================
field PetDescription as string optional

# ============================================================================
# OPTIONAL: CO-APPLICANT (optional field demonstration for joint applications)
# ============================================================================
field CoApplicantName as string optional
field CoApplicantIncome as money in 'USD' default '0.00 USD'

# ============================================================================
# REVIEW & STATUS TRACKING
# ============================================================================
field ReviewerName as string optional
field ReviewNotes as string optional
field RejectionReason as string optional
field PropertyUnit as string default ""
field RequiredMonthlyRent as money in 'USD' default '0.00 USD'

# ============================================================================
# STATES — 6 total (1 initial, 2 terminal, 3 intermediate)
# ============================================================================
state ApplicationSubmitted initial
state UnderReview
state Approved
state Rejected terminal
state LeaseSigned terminal
state LeaseCancelled

# ============================================================================
# RULES — Domain Invariants (2 rules)
# ============================================================================
rule EmergencyContacts.count >= 2 because "At least two emergency contacts are required for a rental application"
rule if ApplicationType == "Joint" then CoApplicantName is set else true
    because "Joint applications require a co-applicant name"

# ============================================================================
# EVENT ENSURES — Constraints validated on every event invocation
# ============================================================================
on SubmitApplication ensure ApplicantName is set because "Applicant name is required"
on SignLease ensure SecurityDeposit >= RequiredMonthlyRent because
    "Security deposit must be at least one month's rent"

# ============================================================================
# EVENTS
# ============================================================================

# Applicant submits initial rental application
event SubmitApplication(
    EmailAddress as string,
    PhoneNumber as string,
    CurrentAddress as string,
    MonthlyIncome as money in 'USD',
    CreditScore as integer,
    EmergencyContacts as set of string,
    PropertyUnit as string,
    RequiredMonthlyRent as money in 'USD',
    MoveInDate as instant) initial

# Landlord requests additional information during review
event RequestAdditionalInfo(Notes as string)

# Applicant submits the requested additional information
event SubmitInfo(PetDescription as string optional, CoApplicantName as string optional)

# Landlord reviews and approves the application
event ReviewApplication(ReviewerName as string, ReviewNotes as string optional)

# Landlord rejects the application
event RejectApplication(RejectionReason as string)

# Tenant signs the lease (only possible after approval + deposit)
event SignLease

# Landlord or tenant cancels the approved lease
event CancelLease

# ============================================================================
# TRANSITIONS — ~18 transitions across 6 states and 6 events
# ============================================================================

# --- ApplicationSubmitted state ---

# SubmitApplication: initial construction row
from ApplicationSubmitted on SubmitApplication
    -> set ApplicantName = SubmitApplication.EmailAddress
    -> set EmailAddress = SubmitApplication.EmailAddress
    -> set PhoneNumber = SubmitApplication.PhoneNumber
    -> set CurrentAddress = SubmitApplication.CurrentAddress
    -> set MonthlyIncome = SubmitApplication.MonthlyIncome
    -> set CreditScore = SubmitApplication.CreditScore
    -> set EmergencyContacts = SubmitApplication.EmergencyContacts
    -> set PropertyUnit = SubmitApplication.PropertyUnit
    -> set RequiredMonthlyRent = SubmitApplication.RequiredMonthlyRent
    -> set MoveInDate = SubmitApplication.MoveInDate
    -> set ApplicationFeePaid = true
    -> transition UnderReview

# --- UnderReview state ---

# RequestAdditionalInfo: landlord flags gaps in the application
from UnderReview on RequestAdditionalInfo
    -> set ReviewNotes = RequestAdditionalInfo.Notes
    -> transition ApplicationSubmitted

# SubmitInfo: applicant provides requested details
from UnderReview on SubmitInfo
    -> set PetDescription = SubmitInfo.PetDescription
    -> set CoApplicantName = SubmitInfo.CoApplicantName
    -> transition UnderReview

# ReviewApplication: meets financial thresholds
from UnderReview on ReviewApplication
    when MonthlyIncome >= RequiredMonthlyRent * 3 and CreditScore >= 600
    -> set ReviewerName = ReviewApplication.ReviewerName
    -> set ReviewNotes = ReviewApplication.ReviewNotes
    -> set SecurityDeposit = RequiredMonthlyRent
    -> transition Approved

# ReviewApplication: below income threshold
from UnderReview on ReviewApplication
    when MonthlyIncome < RequiredMonthlyRent * 3
    -> reject "Income requirement not met — monthly income must be at least 3x the required rent of {RequiredMonthlyRent}"

# ReviewApplication: below credit threshold
from UnderReview on ReviewApplication
    when CreditScore < 600
    -> reject "Credit score requirement not met — minimum score is 600 (current: {CreditScore})"

# RejectApplication: landlord declines the application
from UnderReview on RejectApplication
    -> set ReviewerName = ""
    -> set RejectionReason = RejectApplication.RejectionReason
    -> transition Rejected

# --- Approved state ---

# RejectApplication: landlord changes mind before lease signing
from Approved on RejectApplication
    -> set RejectionReason = RejectApplication.RejectionReason
    -> transition Rejected

# SignLease: deposit already paid
from Approved on SignLease
    when SecurityDeposit >= RequiredMonthlyRent
    -> set ApplicationType = ApplicationType
    -> set PetPreference = PetPreference
    -> set LeaseTerm = LeaseTerm
    -> transition LeaseSigned

# SignLease: deposit not yet sufficient
from Approved on SignLease
    -> reject "Security deposit ({SecurityDeposit}) must be at least one month's rent ({RequiredMonthlyRent})"

# CancelLease: cancel the approved lease
from Approved on CancelLease
    -> transition LeaseCancelled

# RequestAdditionalInfo after approval — informational only
from Approved on RequestAdditionalInfo
    when ReviewNotes is set
    -> set ReviewNotes = ReviewNotes + "; " + RequestAdditionalInfo.Notes
    -> no transition
from Approved on RequestAdditionalInfo
    when ReviewNotes is not set
    -> set ReviewNotes = RequestAdditionalInfo.Notes
    -> no transition

# SubmitInfo after approval — applicant updates info
from Approved on SubmitInfo
    -> set PetDescription = SubmitInfo.PetDescription
    -> set CoApplicantName = SubmitInfo.CoApplicantName
    -> no transition

# --- Rejected terminal state ---
# No outgoing transitions — terminal

# --- LeaseSigned terminal state ---
# No outgoing transitions — terminal

# --- LeaseCancelled state ---
# Lease can be cancelled and then re-signed (not terminal)
from LeaseCancelled on SignLease
    when SecurityDeposit >= RequiredMonthlyRent
    -> transition LeaseSigned

# ============================================================================
# STATE CONSTRAINTS — Access control per state
# ============================================================================
in ApplicationSubmitted modify ApplicantName, EmailAddress, PhoneNumber,
    CurrentAddress, ApplicationType, PetPreference, LeaseTerm, MoveInDate,
    MonthlyIncome, CreditScore, SecurityDeposit, EmergencyContacts,
    PetDescription, CoApplicantName, CoApplicantIncome editable

in UnderReview modify ReviewNotes, PetDescription, CoApplicantName editable
in Approved modify ReviewNotes, PetDescription, CoApplicantName editable
in Approved ensure ReviewerName is set because "Approved applications must have a reviewer"
in Rejected ensure RejectionReason is set because "Rejected applications must document the reason"

