precept WarrantyRepairRequest

# A warranty repair request — the customer enriches identifying details in
# Draft, submits for approval, and the manufacturer either denies or accepts
# the repair. Accepted requests log the repair steps as a stack so the last
# step can be reversed cleanly. Free-Construction Pattern: the customer fills
# in product identity progressively rather than supplying everything atomically.

# Customer and product identity — filled progressively in Draft.
field CustomerName as string optional maxlength 200
field ProductName as string optional maxlength 200
field SerialNumber as string optional maxlength 100

# Decision tracking — populated on the approve/deny transitions.
field ApprovalNote as string optional

# Repair workflow
field RepairSteps as stack of string
field LastReversedStep as string optional maxlength 200 editable
field RepairComplete as boolean default false
field ShippingLabelSent as boolean default false

# States
state Draft initial
state Submitted
state Approved
state InRepair
state ReadyToReturn
state Closed terminal
state Denied terminal

# Editable window — the customer enriches identity in Draft.
in Draft modify CustomerName, ProductName, SerialNumber editable

# State ensures
in ReadyToReturn ensure RepairComplete because "A repair must be marked complete before the unit is ready to return — partial repairs are not shippable"
in Closed ensure ShippingLabelSent because "A closed warranty case must have a return shipping label on record so the customer can ship the unit back"

# Entry hook — generate the return label automatically on entry to ReadyToReturn.
to ReadyToReturn -> set ShippingLabelSent = true

# Events
event Submit
event Approve(Note as string optional)
event Deny(Note as string notempty)
event StartRepair
event LogRepairStep(StepName as string notempty maxlength 200)
event UndoLastStep
event FinishRepair
event ConfirmReturn

# Submit — all three identifiers must be on record before the manufacturer can review.
from Draft on Submit when CustomerName is set and ProductName is set and SerialNumber is set
    -> transition Submitted
from Draft on Submit
    -> reject "Customer name, product name, and serial number are all required before submission — warranty cannot be verified without them"

# Approval decision
from Submitted on Approve
    -> set ApprovalNote = Approve.Note
    -> transition Approved
from Submitted on Deny
    -> set ApprovalNote = Deny.Note
    -> transition Denied

# Repair execution
from Approved on StartRepair
    -> transition InRepair

# Repair step log — push records steps; pop reverses the most recent one.
from InRepair on LogRepairStep
    -> push RepairSteps LogRepairStep.StepName
    -> no transition
from InRepair on UndoLastStep when RepairSteps.count > 0
    -> pop RepairSteps into LastReversedStep
    -> no transition
from InRepair on UndoLastStep
    -> reject "There is no logged repair step to undo — the step log is empty"
from InRepair on FinishRepair when RepairSteps.count > 0
    -> set RepairComplete = true
    -> transition ReadyToReturn
from InRepair on FinishRepair
    -> reject "At least one repair step must be logged before the repair can finish — undocumented repairs are not auditable"

# Return — clear the step log and close the case.
from ReadyToReturn on ConfirmReturn
    -> clear RepairSteps
    -> transition Closed
