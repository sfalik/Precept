precept CalibrationManagement

# ============================================================================
# DOMAIN: Manufacturing — Calibration Management
# ============================================================================
# Demonstrates: calibration scheduling, tolerance verification, certificate
# tracking, out-of-tolerance actions, choice-typed status, and temporal
# tracking with due dates.
#
# Lifecycle: Due → Scheduled → InProgress → Passed/Failed → Recalibrated/Quarantined
#
# Collection types demonstrated:
#   - lookup  (CalibrationHistory) — key-value map of past calibrations
#   - log     (CalibrationLog) — append-only audit trail
#
# Demonstrates:
#   - Guard priority for tolerance checks (out-of-tolerance before in-tolerance)
#   - Boolean flag for tracking measurement state (avoids flow analysis issues)
#   - Optional field guards (CertificateDate is set)
#   - Split action chains — no if/then/else across chains
#   - Date arithmetic for next due date
#   - Two terminal states (Recalibrated, Quarantined)
#   - Lookup put operation for historical data
# ============================================================================

# ============================================================================
# EQUIPMENT & CALIBRATION IDENTITY
# ============================================================================
field CalibrationNumber as string
field EquipmentId as string
field EquipmentName as string optional
field InstrumentType as choice of string("Scale","PressureGauge","Thermometer",
    "Voltmeter","FlowMeter","TorqueWrench","Other")
field Manufacturer as string optional
field ModelNumber as string optional
field SerialNumber as string optional

# ============================================================================
# CALIBRATION DETAILS
# ============================================================================
field CalibrationStandard as string
field ToleranceUpper as decimal default 0.0
field ToleranceLower as decimal default 0.0
field MeasuredValue as decimal optional
field CertificateNumber as string optional
field CertificateDate as date optional
field NextDueDate as date optional
field LastCalibrationDate as date optional

# ============================================================================
# STATUS TRACKING
# ============================================================================
field CalibrationStatus as choice of string("Due","Scheduled","InProgress",
    "Passed","Failed","Recalibrated","Quarantined") default "Due"
field OutOfTolerance as boolean default false
field MeasurementRecorded as boolean default false
field QuarantineReason as string optional

# ============================================================================
# CALIBRATION LOG — append-only audit trail
# ============================================================================
field CalibrationLog as log of string

# ============================================================================
# CALIBRATION HISTORY — key-value map
# Demonstrates: lookup of string to string for historical data.
# ============================================================================
field CalibrationHistory as lookup of string to string optional

# ============================================================================
# TIMESTAMPS
# ============================================================================
field DueDate as instant optional
field ScheduledDate as instant optional
field InProgressAt as instant optional
field CompletedAt as instant optional
field QuarantinedAt as instant optional

# ============================================================================
# TECHNICAL DATA
# ============================================================================
field TechnicianName as string optional
field AdjustmentRequired as boolean default false
field AdjustmentPerformed as boolean default false
field AdjustmentNotes as string optional

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule ToleranceUpper >= ToleranceLower
    because "Upper tolerance must not be less than lower tolerance"

# ============================================================================
# STATES — 7 total lifecycle positions
# ============================================================================
state Due initial
state Scheduled
state InProgress
state Passed
state Failed
state Recalibrated terminal
state Quarantined terminal

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.CalibrationNumber != ""
    because "Calibration number is required"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    CalibrationNumber as string notempty,
    EquipmentId as string notempty,
    EquipmentName as string optional,
    InstrumentType as choice of string("Scale","PressureGauge","Thermometer",
        "Voltmeter","FlowMeter","TorqueWrench","Other"),
    Manufacturer as string optional,
    ModelNumber as string optional,
    SerialNumber as string optional,
    CalibrationStandard as string notempty,
    ToleranceUpper as decimal,
    ToleranceLower as decimal,
    NextDueDate as date) initial

event ScheduleCalibration(ScheduledDate as date, TechnicianName as string notempty)

event StartCalibration
event RecordMeasurement(MeasuredValue as decimal)
event RecordCertificate(CertificateNumber as string notempty, CertificateDate as date)

event PassCalibration
event FailCalibration(Reason as string notempty)

event PerformAdjustment(Notes as string notempty)
event CompleteRecalibration
event Quarantine(Reason as string notempty)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Scheduled ensure ScheduledDate is set
    because "Scheduled state requires scheduling timestamp"

in InProgress ensure InProgressAt is set
    because "In-progress state requires start timestamp"

in Passed ensure CompletedAt is set
    because "Passed state requires completion timestamp"

in Failed ensure CompletedAt is set
    because "Failed state requires completion timestamp"

in Recalibrated ensure CompletedAt is set
    because "Recalibrated state requires completion timestamp"

in Quarantined ensure QuarantinedAt is set
    because "Quarantined state requires quarantine timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — Due state setup
# --------------------------------------------------------------------------
from Due on Create
    -> set CalibrationNumber = Create.CalibrationNumber
    -> set EquipmentId = Create.EquipmentId
    -> set EquipmentName = Create.EquipmentName
    -> set InstrumentType = Create.InstrumentType
    -> set Manufacturer = Create.Manufacturer
    -> set ModelNumber = Create.ModelNumber
    -> set SerialNumber = Create.SerialNumber
    -> set CalibrationStandard = Create.CalibrationStandard
    -> set ToleranceUpper = Create.ToleranceUpper
    -> set ToleranceLower = Create.ToleranceLower
    -> set NextDueDate = Create.NextDueDate
    -> set CalibrationStatus = "Due"
    -> set OutOfTolerance = false
    -> set AdjustmentRequired = false
    -> set AdjustmentPerformed = false
    -> set DueDate = now()
    -> transition Due

# --------------------------------------------------------------------------
# SCHEDULE CALIBRATION — Due → Scheduled
# --------------------------------------------------------------------------
from Due on ScheduleCalibration
    -> set ScheduledDate = now()
    -> set TechnicianName = ScheduleCalibration.TechnicianName
    -> append CalibrationLog "Calibration scheduled"
    -> transition Scheduled

# --------------------------------------------------------------------------
# START CALIBRATION — Scheduled → InProgress
# --------------------------------------------------------------------------
from Scheduled on StartCalibration
    -> set InProgressAt = now()
    -> set CalibrationStatus = "InProgress"
    -> append CalibrationLog "Calibration in progress"
    -> transition InProgress

# --------------------------------------------------------------------------
# RECORD MEASUREMENT — track measured value with tolerance check
#
# Demonstrates: guard priority for conditional action.
# Row 1: reject if measurement already recorded (boolean flag)
# Row 2: out of tolerance (high side) — sets OutOfTolerance = true
# Row 3: out of tolerance (low side) — sets OutOfTolerance = true
# Row 4: in tolerance — sets OutOfTolerance = false
#
# The if/then/else cannot span action chains, so we split into separate
# transition rows ordered by guard specificity.
# --------------------------------------------------------------------------
from InProgress on RecordMeasurement when MeasurementRecorded
    -> reject "Measurement already recorded"

from InProgress on RecordMeasurement when MeasuredValue > ToleranceUpper
    -> set MeasuredValue = RecordMeasurement.MeasuredValue
    -> set OutOfTolerance = true
    -> set MeasurementRecorded = true
    -> append CalibrationLog "Out of tolerance (high)"
    -> no transition

from InProgress on RecordMeasurement when MeasuredValue < ToleranceLower
    -> set MeasuredValue = RecordMeasurement.MeasuredValue
    -> set OutOfTolerance = true
    -> set MeasurementRecorded = true
    -> append CalibrationLog "Out of tolerance (low)"
    -> no transition

from InProgress on RecordMeasurement
    -> set MeasuredValue = RecordMeasurement.MeasuredValue
    -> set OutOfTolerance = false
    -> set MeasurementRecorded = true
    -> append CalibrationLog "Within tolerance"
    -> no transition

# --------------------------------------------------------------------------
# RECORD CERTIFICATE — documentation
# --------------------------------------------------------------------------
from InProgress on RecordCertificate
    -> set CertificateNumber = RecordCertificate.CertificateNumber
    -> set CertificateDate = RecordCertificate.CertificateDate
    -> append CalibrationLog "Certificate recorded"
    -> no transition

# --------------------------------------------------------------------------
# PASS CALIBRATION — InProgress → Passed
# Requires certificate to be recorded first.
# --------------------------------------------------------------------------
from InProgress on PassCalibration when CertificateDate is set and CertificateNumber is set
    -> set CompletedAt = now()
    -> set CalibrationStatus = "Passed"
    -> set LastCalibrationDate = CertificateDate
    -> put CalibrationHistory "LastCalibration" = CertificateNumber
    -> append CalibrationLog "Calibration passed"
    -> transition Passed

from InProgress on PassCalibration when CertificateNumber is set
    -> reject "Certificate date required before passing"

from InProgress on PassCalibration
    -> reject "Certificate required before passing"

# --------------------------------------------------------------------------
# FAIL CALIBRATION — InProgress → Failed
# --------------------------------------------------------------------------
from InProgress on FailCalibration
    -> set CompletedAt = now()
    -> set CalibrationStatus = "Failed"
    -> set AdjustmentRequired = true
    -> append CalibrationLog "Calibration failed: " + FailCalibration.Reason
    -> transition Failed

# --------------------------------------------------------------------------
# PERFORM ADJUSTMENT — Failed state
# --------------------------------------------------------------------------
from Failed on PerformAdjustment
    -> set AdjustmentNotes = PerformAdjustment.Notes
    -> set AdjustmentPerformed = true
    -> append CalibrationLog "Adjustment performed"
    -> no transition

# --------------------------------------------------------------------------
# COMPLETE RECALIBRATION — Failed/Passed → Recalibrated
# --------------------------------------------------------------------------
from Failed on CompleteRecalibration
    -> set CompletedAt = now()
    -> set CalibrationStatus = "Recalibrated"
    -> append CalibrationLog "Recalibration complete"
    -> transition Recalibrated

from Passed on CompleteRecalibration
    -> set CompletedAt = now()
    -> set CalibrationStatus = "Recalibrated"
    -> append CalibrationLog "Recalibration complete"
    -> transition Recalibrated

# --------------------------------------------------------------------------
# QUARANTINE — Failed → Quarantined
# --------------------------------------------------------------------------
from Failed on Quarantine
    -> set QuarantineReason = Quarantine.Reason
    -> set QuarantinedAt = now()
    -> set CalibrationStatus = "Quarantined"
    -> append CalibrationLog "Equipment quarantined: " + Quarantine.Reason
    -> transition Quarantined