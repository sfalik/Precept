precept ItHelpdeskTicket

# An IT helpdesk ticket from intake through assignment, customer interaction,
# resolution, and closure. Tickets are progressively enriched: the requester
# files an empty ticket and signals business urgency; the agent records the
# title and technical severity at triage. Priority is computed from Severity
# and Urgency, matching standard ITSM practice (impact x urgency -> priority).
# A shared agent queue dispatches the next available agent — the queue is the
# demonstrative focus, with RegisterAgent firing from any active state to grow
# the on-call pool.

# Identity and triage data — title and severity are filled at Triage;
# Urgency is settable by the requester while the ticket is New.
# Severity: technical impact rank (1 = catastrophic outage, 5 = cosmetic).
# Urgency: business urgency rank (1 = response needed now, 5 = whenever).
field TicketTitle as string optional maxlength 200
field Severity as choice of integer(1, 2, 3, 4, 5) ordered default 3
field Urgency as choice of integer(1, 2, 3, 4, 5) ordered default 3

# Priority is derived from Severity x Urgency. Declare the choice in
# ascending rank so ordered comparisons (Priority >= "High", etc.) read
# correctly. Ordinal form mirrors the standard ITSM impact x urgency table:
#   (S<=1 and U<=1) -> Critical
#   (S<=2 or  U<=2) -> High
#   (S<=4 and U<=4) -> Medium
#   else            -> Low
field Priority as choice of string("Low", "Medium", "High", "Critical") ordered <-
    if Severity <= 1 and Urgency <= 1 then "Critical"
    else if Severity <= 2 or Urgency <= 2 then "High"
    else if Severity <= 4 and Urgency <= 4 then "Medium"
    else "Low"

# Assignment — populated when an agent is dispatched from the queue.
field AssignedAgent as string optional maxlength 200
field LastQueuedAgent as string optional maxlength 200

# Resolution
field ResolutionNote as string optional
field ReopenCount as integer default 0 nonnegative

# Shared on-call queue — agents register themselves; Assign dequeues the next.
field AgentQueue as queue of string

# States
state New initial
state Assigned
state WaitingOnCustomer
state Resolved
state Closed terminal

# State ensures
in Assigned ensure AssignedAgent is set because "An assigned ticket must name the responsible agent"
in Assigned ensure TicketTitle is set because "An assigned ticket must have a triaged title — assignment without intake context produces unactionable work"
in Resolved ensure ResolutionNote is set because "A resolved ticket must carry the resolution note so future readers understand how it was fixed"

# Editable windows — the requester signals business urgency before triage.
in New modify Urgency editable

# Events
event RegisterAgent(AgentName as string notempty maxlength 200)
event Triage(Title as string notempty maxlength 200, Level as choice of integer(1, 2, 3, 4, 5) ordered default 3, RequesterUrgency as choice of integer(1, 2, 3, 4, 5) ordered default 3)
event Assign
event CustomerReply
event Resolve(Note as string notempty)
event CloseTicket
event Reopen(Note as string optional)

# Cross-cutting — any active state can grow the on-call pool.
from New, Assigned, WaitingOnCustomer, Resolved on RegisterAgent
    -> enqueue AgentQueue RegisterAgent.AgentName
    -> no transition

# Triage — title, technical severity, and business urgency are captured
# before assignment becomes possible. The agent may override the requester's
# urgency signal at triage.
from New on Triage
    -> set TicketTitle = Triage.Title
    -> set Severity = Triage.Level
    -> set Urgency = Triage.RequesterUrgency
    -> no transition

# Assign — the next queued agent picks up the ticket. Title must already exist.
from New, WaitingOnCustomer on Assign when AgentQueue.count > 0 and TicketTitle is set
    -> set LastQueuedAgent = AgentQueue.peek
    -> set AssignedAgent = AgentQueue.peek
    -> dequeue AgentQueue
    -> transition Assigned
from New, WaitingOnCustomer on Assign when AgentQueue.count > 0
    -> reject "Triage the ticket title before assigning an agent — agents cannot work an unidentified issue"
from New, WaitingOnCustomer on Assign
    -> reject "No support agent is currently available — RegisterAgent first"

# Customer interaction and resolution
from Assigned on CustomerReply
    -> transition WaitingOnCustomer
from Assigned on Resolve
    -> set ResolutionNote = Resolve.Note
    -> transition Resolved

# Closure and reopen
from Resolved on CloseTicket
    -> transition Closed
from Resolved on Reopen
    -> set ReopenCount = ReopenCount + 1
    -> transition New
