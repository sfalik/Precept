precept SaasUserProvisioningAndDeprovisioning

# ============================================================================
# DOMAIN: SaaS User Provisioning — License and Role Management
# ============================================================================
# Demonstrates: user lifecycle with role-based access, license allocation
# tracking, conditional rules for seat limits, choice-typed roles and
# statuses, guarded transitions, log for audit trail, and a lifecycle
# covering full user provisioning lifecycle.
#
# Lifecycle:
#   Requested → Approved → Active → Suspended → Deactivated
#
# Key Precept features demonstrated:
#   - Choice-typed roles (Admin, Editor, Viewer)
#   - Choice-typed user statuses
#   - License tracking with lookup collections
#   - Log for audit trail
#   - Conditional rules (license limit enforcement)
#   - Guarded transitions with specific-before-general ordering
#   - State constraints (access restrictions)
#   - Event ensure constraints on role assignments

# ============================================================================
# ACCOUNT AND USER IDENTIFICATION
# ============================================================================
field SubscriptionId as string
field UserId as string
field UserEmail as string
field UserDisplayName as string
field Department as string

# ============================================================================
# USER ROLES AND ACCESS
# ============================================================================
field UserRole as choice of string("Admin", "Editor", "Viewer") default "Viewer"
field UserRoleEffectiveDate as instant optional
field RoleHistory as log of string

# ============================================================================
# USER STATUS
# ============================================================================
field UserStatus as choice of string(
    "Requested",
    "Approved",
    "Active",
    "Suspended",
    "Deactivated"
) default "Requested"
field RequestedAt as instant optional
field ApprovedAt as instant optional
field ActiveAt as instant optional
field SuspendedAt as instant optional
field DeactivatedAt as instant optional

# ============================================================================
# LICENSE TRACKING
# ============================================================================
field LicenseAssigned as boolean default false
field LicenseType as choice of string("Full", "Limited", "Trial") default "Full"
field LicenseExpirationDate as instant optional
field SeatNumber as integer default 0 nonnegative

# ============================================================================
# ACCESS CONTROLS — lookup of resource to access level
# ============================================================================
field ResourceAccess as lookup of string to string
field PendingAccessChanges as lookup of string to string

# ============================================================================
# PERMISSIONS
# ============================================================================
field CanCreate as boolean default false
field CanEdit as boolean default false
field CanDelete as boolean default false
field CanManageUsers as boolean default false
field CanViewReports as boolean default false

# ============================================================================
# AUDIT LOG
# ============================================================================
field AuditLog as log of string
field LastActivityDate as instant optional
field LoginCount as integer default 0 nonnegative
field FailedLoginAttempts as integer default 0 nonnegative

# ============================================================================
# ASSIGNMENT DATA
# ============================================================================
field TotalLicensesPurchased as integer default 0 nonnegative
field LicensesInUse as integer default 0 nonnegative
field LicensesAvailable as integer default 0 nonnegative

# ============================================================================
# STATES
# ============================================================================
state Requested initial
state Approved
state Active
state Suspended
state Deactivated terminal

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Requested ensure RequestedAt is set
    because "Requested state requires a request timestamp"
in Approved ensure ApprovedAt is set
    because "Approved state requires an approval timestamp"
in Active ensure ActiveAt is set
    because "Active state requires an activation timestamp"
in Suspended ensure SuspendedAt is set
    because "Suspended state requires a suspension timestamp"
in Deactivated ensure DeactivatedAt is set
    because "Deactivated state requires a deactivation timestamp"
in Active ensure LicenseAssigned == true
    because "Active users must have a license assigned"
in Suspended ensure LicenseAssigned == true
    because "Suspended users must still hold a license"

# ============================================================================
# EVENTS
# ============================================================================

# Entity construction
event Create(
    SubscriptionId as string notempty,
    UserId as string notempty,
    UserEmail as string notempty,
    UserDisplayName as string notempty,
    Department as string notempty,
    TotalLicensesPurchased as integer) initial

# Request user access
event RequestAccess(
    UserRole as choice of string("Admin", "Editor", "Viewer"),
    LicenseType as choice of string("Full", "Limited", "Trial"))

# Approve access
event ApproveAccess(ApprovedBy as string notempty)

# Provision user account
event ProvisionUser

# Suspend user access
event SuspendUser(Reason as string notempty)

# Reactivate user
event ReactivateUser

# Revoke access and deactivate
event RevokeAccess(Reason as string notempty)

# Update user role
event UpdateRole(NewRole as choice of string("Admin", "Editor", "Viewer"))
on UpdateRole ensure UpdateRole.NewRole == "Admin" or UpdateRole.NewRole == "Editor" or UpdateRole.NewRole == "Viewer"
    because "Role must be Admin, Editor, or Viewer"

# Grant resource access
event GrantResourceAccess(ResourceName as string notempty, AccessLevel as string notempty)

# Revoke resource access
event RevokeResourceAccess(ResourceName as string notempty)

# Record login
event RecordLogin

# Record failed login
event RecordFailedLogin

# Update license tracking
event UpdateLicenseUsage(InUse as integer)
on UpdateLicenseUsage ensure UpdateLicenseUsage.InUse >= 0 and UpdateLicenseUsage.InUse <= TotalLicensesPurchased
    because "License usage cannot exceed purchased licenses"

# ============================================================================
# RULES
# ============================================================================
rule LicensesInUse <= TotalLicensesPurchased
    because "In-use licenses cannot exceed purchased licenses"
rule LicensesAvailable == TotalLicensesPurchased - LicensesInUse
    because "Available licenses equal purchased minus in-use"
rule UserRole == "Admin" when CanManageUsers == true
    because "Admin role requires user management permission"
rule UserRole == "Editor" when CanEdit == true
    because "Editor role requires edit permission"

# ============================================================================
# TRANSITIONS
# ============================================================================

# CONSTRUCTION — Requested → Requested
from Requested on Create
    -> set SubscriptionId = Create.SubscriptionId
    -> set UserId = Create.UserId
    -> set UserEmail = Create.UserEmail
    -> set UserDisplayName = Create.UserDisplayName
    -> set Department = Create.Department
    -> set TotalLicensesPurchased = Create.TotalLicensesPurchased
    -> set LicensesInUse = 0
    -> set LicensesAvailable = Create.TotalLicensesPurchased
    -> set UserStatus = "Requested"
    -> set RequestedAt = now()
    -> set UserRole = "Viewer"
    -> append AuditLog "User requested: " + Create.UserId
    -> transition Requested

# Request access — Requested → Requested
from Requested on RequestAccess
    -> set UserRole = RequestAccess.UserRole
    -> set LicenseType = RequestAccess.LicenseType
    -> set RequestedAt = now()
    -> append AuditLog "Access requested with role: " + RequestAccess.UserRole
    -> no transition

# Approve access — Requested → Approved
from Requested on ApproveAccess
    -> set UserStatus = "Approved"
    -> set ApprovedAt = now()
    -> set LicenseAssigned = true
    -> set LicensesInUse = LicensesInUse + 1
    -> set LicensesAvailable = LicensesAvailable - 1
    -> append AuditLog "Access approved by " + ApproveAccess.ApprovedBy
    -> transition Approved

# Provision user — Approved → Active
from Approved on ProvisionUser
    -> set UserStatus = "Active"
    -> set ActiveAt = now()
    -> set LicenseExpirationDate = now() + '365 days'
    -> set SeatNumber = LicensesInUse
    -> set UserRole = "Editor"
    -> set CanCreate = false
    -> set CanEdit = true
    -> set CanDelete = false
    -> set CanManageUsers = false
    -> set CanViewReports = true
    -> append AuditLog "User provisioned and activated"
    -> transition Active

# Grant resource access — Active
from Active on GrantResourceAccess
    -> set ResourceAccess[GrantResourceAccess.ResourceName] = GrantResourceAccess.AccessLevel
    -> set LastActivityDate = now()
    -> append AuditLog "Resource access granted: " + GrantResourceAccess.ResourceName + " = " + GrantResourceAccess.AccessLevel
    -> no transition

# Revoke resource access — Active
from Active on RevokeResourceAccess
    -> remove ResourceAccess[RevokeResourceAccess.ResourceName]
    -> set LastActivityDate = now()
    -> append AuditLog "Resource access revoked: " + RevokeResourceAccess.ResourceName
    -> no transition

# Record login — Active
from Active on RecordLogin
    -> add LoginCount 1
    -> set FailedLoginAttempts = 0
    -> set LastActivityDate = now()
    -> append AuditLog "User logged in"
    -> no transition

# Record failed login — Active
from Active on RecordFailedLogin
    -> add FailedLoginAttempts 1
    -> set LastActivityDate = now()
    -> append AuditLog "Failed login attempt (total: " + FailedLoginAttempts + ")"
    -> no transition

# Update role — Active
from Active on UpdateRole
    -> set UserRole = UpdateRole.NewRole
    -> set UserRoleEffectiveDate = now()
    -> set LastActivityDate = now()
    -> append AuditLog "Role updated to: " + UpdateRole.NewRole
    -> no transition

# Suspend user — Active → Suspended
from Active on SuspendUser
    -> set UserStatus = "Suspended"
    -> set SuspendedAt = now()
    -> set LicenseAssigned = true
    -> set ResourceAccess = lookup {}
    -> set CanCreate = false
    -> set CanEdit = false
    -> set CanDelete = false
    -> set CanManageUsers = false
    -> set CanViewReports = false
    -> append AuditLog "User suspended: " + SuspendUser.Reason
    -> no transition

# Reactivate user — Suspended → Active
from Suspended on ReactivateUser
    -> set UserStatus = "Active"
    -> set ActiveAt = now()
    -> set LicenseAssigned = true
    -> set LastActivityDate = now()
    -> append AuditLog "User reactivated"
    -> transition Active

# Suspend from Active — Active → Suspended (security concern)
from Active on SuspendUser when FailedLoginAttempts >= 5
    -> set UserStatus = "Suspended"
    -> set SuspendedAt = now()
    -> set LicenseAssigned = true
    -> set ResourceAccess = lookup {}
    -> set CanCreate = false
    -> set CanEdit = false
    -> set CanDelete = false
    -> set CanManageUsers = false
    -> set CanViewReports = false
    -> append AuditLog "User auto-suspended due to " + FailedLoginAttempts + " failed login attempts"
    -> no transition

# Revoke access and deactivate — Active → Deactivated
from Active on RevokeAccess
    -> set UserStatus = "Deactivated"
    -> set DeactivatedAt = now()
    -> set LicenseAssigned = false
    -> set LicensesInUse = LicensesInUse - 1
    -> set LicensesAvailable = LicensesAvailable + 1
    -> set ResourceAccess = lookup {}
    -> set CanCreate = false
    -> set CanEdit = false
    -> set CanDelete = false
    -> set CanManageUsers = false
    -> set CanViewReports = false
    -> append AuditLog "User deactivated: " + RevokeAccess.Reason
    -> transition Deactivated

# Revoke access and deactivate — Suspended → Deactivated
from Suspended on RevokeAccess
    -> set UserStatus = "Deactivated"
    -> set DeactivatedAt = now()
    -> set LicenseAssigned = false
    -> set LicensesInUse = LicensesInUse - 1
    -> set LicensesAvailable = LicensesAvailable + 1
    -> append AuditLog "Suspended user deactivated: " + RevokeAccess.Reason
    -> transition Deactivated

# Update license usage
from Requested on UpdateLicenseUsage
    -> set LicensesInUse = UpdateLicenseUsage.InUse
    -> set LicensesAvailable = TotalLicensesPurchased - UpdateLicenseUsage.InUse
    -> no transition

from Approved on UpdateLicenseUsage
    -> set LicensesInUse = UpdateLicenseUsage.InUse
    -> set LicensesAvailable = TotalLicensesPurchased - UpdateLicenseUsage.InUse
    -> no transition

from Active on UpdateLicenseUsage
    -> set LicensesInUse = UpdateLicenseUsage.InUse
    -> set LicensesAvailable = TotalLicensesPurchased - UpdateLicenseUsage.InUse
    -> no transition

from Suspended on UpdateLicenseUsage
    -> set LicensesInUse = UpdateLicenseUsage.InUse
    -> set LicensesAvailable = TotalLicensesPurchased - UpdateLicenseUsage.InUse
    -> no transition
