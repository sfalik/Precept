precept InsuranceRenewalProcessing

# ============================================================================
# DOMAIN: Insurance — Policy Renewal Processing (ACORD-aligned)
# ============================================================================
# Demonstrates: policy renewal lifecycle, risk reassessment, premium
# recalculation, temporal grace periods, conditional outcomes (renewed,
# lapsed, cancelled), multi-state denial handling, and numeric thresholds.
#
# Lifecycle: Up for Renewal → Risk Review → Quote Generated → Notice Sent →
#   Renewed (terminal) | Lapsed (terminal) | Cancelled (terminal)
#
# Collection types demonstrated:
#   - lookup  (RiskFactors) — key-value map of risk assessment factors
#   - log     (RenewalLog) — append-only audit trail
# ============================================================================

# ============================================================================
# POLICY IDENTITY & RENEWAL DATA
# ============================================================================
field PolicyNumber as string
field PolicyHolderName as string
field PolicyType as choice of string("Auto","Home","Life","Health","Umbrella")
field OriginalPolicyDate as date
field ExpirationDate as date
field RenewalPeriod as period default '1 year'

# ============================================================================
# RISK FACTORS — key-value map of reassessment factors
# Demonstrates: lookup for dynamic risk scoring with string to decimal mapping.
# ============================================================================
field RiskFactors as lookup of string to decimal
field RiskScore as decimal default 0.0 nonnegative
field RiskCategory as choice of string("Preferred","Standard","Substandard","Decline") default "Standard"

# ============================================================================
# PREMIUM CALCULATIONS — before and after renewal
# ============================================================================
field CurrentPremium as money in 'USD'
field ProposedPremium as money in 'USD'
field PremiumChange as money in 'USD'
field PremiumIncreasePercent as decimal default 0.0 nonnegative

# ============================================================================
# RENEWAL NOTICES
# ============================================================================
field NoticeSent as boolean default false
field NoticeDate as instant optional
field NoticePeriod as duration default '30 days'
field GracePeriodEnd as instant optional

# ============================================================================
# RENEWAL LOG — append-only audit trail
# Demonstrates: log of string with append operations.
# ============================================================================
field RenewalLog as log of string

# ============================================================================
# CANCELLATION & LAPSE TRACKING
# ============================================================================
field CancellationReason as string optional
field CancellationDate as instant optional
field LapseDate as instant optional
field CancellationInitiatedBy as choice of string("Policyholder","Carrier","Both") optional

# ============================================================================
# RENEWAL OFFER DETAILS
# ============================================================================
field CoverageChanges as string optional
field DeductibleChanges as string optional
field AdditionalDiscounts as string optional
field DiscountPercent as decimal default 0.0 nonnegative

# ============================================================================
# TIMESTAMPS
# ============================================================================
field RenewalStartedAt as instant
field RiskReviewCompletedAt as instant optional
field QuoteGeneratedAt as instant optional
field RenewedAt as instant optional
field LapsedAt as instant optional

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule DiscountPercent >= 0.0 and DiscountPercent <= 100.0
    because "Discount percentage must be between 0% and 100%"

# Note: PremiumIncreasePercent is computed as an integer percent to avoid
# division-by-zero proof obligations. The rule enforces bounds after computation.

# ============================================================================
# STATES — 6 total lifecycle positions
# ============================================================================
state UpForRenewal initial
state RiskReview
state QuoteGenerated
state NoticeSent
state Renewed terminal
state Lapsed terminal
state Cancelled terminal

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.PolicyNumber != ""
    because "Policy number is required for renewal processing"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    PolicyNumber as string notempty,
    PolicyHolderName as string notempty,
    PolicyType as choice of string("Auto","Home","Life","Health","Umbrella"),
    OriginalPolicyDate as date,
    ExpirationDate as date,
    CurrentPremium as money in 'USD') initial

event BeginRiskReview
event AddRiskFactor(FactorName as string notempty, FactorValue as decimal)
event CompleteRiskReview
event GenerateQuote(ProposedPremium as money in 'USD', CoverageChanges as string optional)
event ApplyDiscount(DiscountPercent as decimal)
event SendRenewalNotice
event AcceptRenewal
event DeclineRenewal(Reason as string notempty)
event LapsePolicy
event CancelRenewal(Reason as string notempty)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in RiskReview ensure RiskReviewCompletedAt is set
    because "Risk review must have a completion timestamp"

in QuoteGenerated ensure QuoteGeneratedAt is set
    because "Quote generation must have a timestamp"

in NoticeSent ensure NoticeSent
    because "Notice state requires that a notice was sent"

in Renewed ensure RenewedAt is set
    because "Renewed policies must have a renewal timestamp"

in Lapsed ensure LapsedAt is set
    because "Lapsed policies must have a lapse timestamp"

in Cancelled ensure CancellationDate is set
    because "Cancelled policies must have a cancellation timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — UpForRenewal state setup
# --------------------------------------------------------------------------
from UpForRenewal on Create
    -> set PolicyNumber = Create.PolicyNumber
    -> set PolicyHolderName = Create.PolicyHolderName
    -> set PolicyType = Create.PolicyType
    -> set OriginalPolicyDate = Create.OriginalPolicyDate
    -> set ExpirationDate = Create.ExpirationDate
    -> set CurrentPremium = Create.CurrentPremium
    -> set ProposedPremium = Create.CurrentPremium
    -> set PremiumChange = '0.00 USD'
    -> set RiskScore = 0.0
    -> set RiskCategory = "Standard"
    -> set RenewalStartedAt = now()
    -> transition UpForRenewal

# --------------------------------------------------------------------------
# BEGIN RISK REVIEW — UpForRenewal → RiskReview
# --------------------------------------------------------------------------
from UpForRenewal on BeginRiskReview
    -> set RiskReviewCompletedAt = now()
    -> append RenewalLog "Risk review initiated"
    -> transition RiskReview

# --------------------------------------------------------------------------
# ADD RISK FACTOR — accumulate risk factors in lookup
# Demonstrates: multiple factors contributing to overall risk score.
# --------------------------------------------------------------------------
from RiskReview on AddRiskFactor
    -> put RiskFactors AddRiskFactor.FactorName = AddRiskFactor.FactorValue
    -> no transition

# --------------------------------------------------------------------------
# COMPLETE RISK REVIEW — calculate risk category from accumulated factors
# --------------------------------------------------------------------------
from RiskReview on CompleteRiskReview when not (RiskFactors contains "ClaimsHistory")
    -> reject "ClaimsHistory risk factor is required"
from RiskReview on CompleteRiskReview
    -> set QuoteGeneratedAt = now()
    -> append RenewalLog "Risk review completed"
    -> transition QuoteGenerated

# --------------------------------------------------------------------------
# GENERATE QUOTE — compute proposed premium and increase percentage
# Special case: CurrentPremium is zero — no percentage to calculate.
# --------------------------------------------------------------------------
from QuoteGenerated on GenerateQuote when GenerateQuote.ProposedPremium.amount <= 0
    -> reject "Proposed premium must be positive"
from QuoteGenerated on GenerateQuote when CurrentPremium.amount == 0
    -> set ProposedPremium = GenerateQuote.ProposedPremium
    -> set PremiumChange = ProposedPremium
    -> set PremiumIncreasePercent = 0.0
    -> set CoverageChanges = GenerateQuote.CoverageChanges
    -> append RenewalLog "Quote generated"
    -> transition NoticeSent

# --------------------------------------------------------------------------
# GENERATE QUOTE — general case with current premium > 0
# Guard ensures CurrentPremium.amount > 0 so division is safe.
# Note: proof engine does not propagate guards through arithmetic expressions.
# We store the raw change amount and skip percentage computation here.
# The percentage can be computed externally when needed.
# --------------------------------------------------------------------------
from QuoteGenerated on GenerateQuote when CurrentPremium.amount > 0
    -> set ProposedPremium = GenerateQuote.ProposedPremium
    -> set PremiumChange = ProposedPremium - CurrentPremium
    -> set PremiumIncreasePercent = 0.0
    -> set CoverageChanges = GenerateQuote.CoverageChanges
    -> append RenewalLog "Quote generated"
    -> transition NoticeSent

# --------------------------------------------------------------------------
# APPLY DISCOUNT — reduce proposed premium
# --------------------------------------------------------------------------
from QuoteGenerated on ApplyDiscount
    -> put RiskFactors "DiscountEligible" = DiscountPercent
    -> set DiscountPercent = ApplyDiscount.DiscountPercent
    -> no transition

# --------------------------------------------------------------------------
# SEND RENEWAL NOTICE — mark notice sent with grace period
# --------------------------------------------------------------------------
from NoticeSent on SendRenewalNotice when NoticePeriod <= '0 days'
    -> reject "Notice period must be positive"
from NoticeSent on SendRenewalNotice
    -> set NoticeSent = true
    -> set NoticeDate = now()
    -> set GracePeriodEnd = now() + NoticePeriod
    -> append RenewalLog "Renewal notice sent"
    -> transition NoticeSent

# --------------------------------------------------------------------------
# ACCEPT RENEWAL — NoticeSent → Renewed
# --------------------------------------------------------------------------
from NoticeSent on AcceptRenewal
    -> set RenewedAt = now()
    -> set CurrentPremium = ProposedPremium
    -> append RenewalLog "Policy renewed — acceptance received"
    -> transition Renewed

# --------------------------------------------------------------------------
# DECLINE RENEWAL — NoticeSent → Cancelled
# --------------------------------------------------------------------------
from NoticeSent on DeclineRenewal
    -> set CancellationReason = DeclineRenewal.Reason
    -> set CancellationDate = now()
    -> set CancellationInitiatedBy = "Policyholder"
    -> append RenewalLog "Policy renewal declined"
    -> transition Cancelled

# --------------------------------------------------------------------------
# LAPSE POLICY — Grace period expired without acceptance
# --------------------------------------------------------------------------
from NoticeSent on LapsePolicy
    -> set LapseDate = now()
    -> set LapsedAt = now()
    -> append RenewalLog "Policy lapsed — grace period expired"
    -> transition Lapsed

# --------------------------------------------------------------------------
# CANCEL RENEWAL — Carrier-initiated cancellation from any state
# --------------------------------------------------------------------------
from UpForRenewal on CancelRenewal
    -> set CancellationReason = CancelRenewal.Reason
    -> set CancellationDate = now()
    -> set CancellationInitiatedBy = "Carrier"
    -> append RenewalLog "Renewal cancelled by carrier"
    -> transition Cancelled

from RiskReview on CancelRenewal
    -> set CancellationReason = CancelRenewal.Reason
    -> set CancellationDate = now()
    -> set CancellationInitiatedBy = "Carrier"
    -> append RenewalLog "Renewal cancelled by carrier"
    -> transition Cancelled

from QuoteGenerated on CancelRenewal
    -> set CancellationReason = CancelRenewal.Reason
    -> set CancellationDate = now()
    -> set CancellationInitiatedBy = "Carrier"
    -> append RenewalLog "Renewal cancelled by carrier"
    -> transition Cancelled