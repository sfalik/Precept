precept SaasSubscriptionBilling

field SubscriptionId as string notempty
field CustomerId as string notempty
field CustomerName as string notempty
field PlanId as string notempty
field PlanName as choice of string("Free", "Basic", "Professional", "Enterprise") default "Free"
field BillingCycle as choice of string("Monthly", "Annual") default "Monthly"
field SubscriptionStatus as choice of string("Active", "Cancelled", "Expired", "PastDue", "Suspended") default "Active"
field CurrentPeriodStart as instant
field CurrentPeriodEnd as instant
field NextBillingDate as instant
field Amount as money in 'USD' default '0.00 USD'
field DiscountPercent as decimal default 0.0 nonnegative max 100
field DiscountEndDate as instant optional
field PaymentMethod as choice of string("CreditCard", "BankTransfer", "Invoice") optional
field LastPaymentDate as instant optional
field LastPaymentAmount as money in 'USD' optional
field LastPaymentStatus as choice of string("Success", "Failed", "Pending") optional
field OutstandingBalance as money in 'USD' default '0.00 USD'
field AutoRenew as boolean default true
field CancellationDate as instant optional
field CancellationReason as string optional
field DaysPastDue as integer default 0 nonnegative

rule SubscriptionId != "" because "Subscription ID is required"
rule CustomerId != "" because "Customer ID is required"
rule CustomerName != "" because "Customer name is required"
rule PlanId != "" because "Plan ID is required"
rule Amount > '0.00 USD' because "Amount must be positive"
rule DiscountPercent >= 0.0 and DiscountPercent <= 100.0 because "Discount must be 0-100%"

state Active initial
state PastDue
state Cancelled
state Expired

event CreateSubscription(CustomerId as string notempty, CustomerName as string notempty, PlanId as string notempty, PlanName as choice of string("Free", "Basic", "Professional", "Enterprise"), BillingCycle as choice of string("Monthly", "Annual"), Amount as money in 'USD') initial
event ProcessPayment(Amount as money in 'USD', PaymentMethod as choice of string("CreditCard", "BankTransfer", "Invoice"))
event PaymentSuccess(PaymentDate as instant, Amount as money in 'USD')
event PaymentFailed(Reason as string)
event CancelSubscription(Reason as string)
event ReactivateSubscription
event RenewSubscription(NewPeriodStart as instant, NewPeriodEnd as instant, NewAmount as money in 'USD')
event UpdatePlan(NewPlanId as string, NewPlanName as choice of string("Free", "Basic", "Professional", "Enterprise"), NewAmount as money in 'USD')

on CreateSubscription ensure CreateSubscription.CustomerId != "" and CreateSubscription.CustomerName != "" and CreateSubscription.PlanId != "" because "All required fields must be provided"

from any on CreateSubscription -> set SubscriptionId = "SUB-" + CreateSubscription.CustomerId -> set CustomerId = CreateSubscription.CustomerId -> set CustomerName = CreateSubscription.CustomerName -> set PlanId = CreateSubscription.PlanId -> set PlanName = CreateSubscription.PlanName -> set BillingCycle = CreateSubscription.BillingCycle -> set Amount = CreateSubscription.Amount -> set DiscountPercent = 0.0 -> set AutoRenew = true -> set CurrentPeriodStart = now() -> set CurrentPeriodEnd = now() -> set NextBillingDate = now() -> set SubscriptionStatus = 'Active' -> set OutstandingBalance = '0.00 USD' -> set DaysPastDue = 0 -> transition Active
from Active on ProcessPayment -> set PaymentMethod = ProcessPayment.PaymentMethod -> set LastPaymentAmount = ProcessPayment.Amount -> set SubscriptionStatus = 'PastDue' -> transition PastDue
from Active on CancelSubscription -> set CancellationDate = now() -> set CancellationReason = CancelSubscription.Reason -> set SubscriptionStatus = 'Cancelled' -> set AutoRenew = false -> transition Cancelled
from Active on UpdatePlan -> set PlanId = UpdatePlan.NewPlanId -> set PlanName = UpdatePlan.NewPlanName -> set Amount = UpdatePlan.NewAmount -> set NextBillingDate = now() -> no transition
from PastDue on ProcessPayment -> set LastPaymentDate = now() -> set LastPaymentAmount = ProcessPayment.Amount -> set LastPaymentStatus = 'Success' -> set OutstandingBalance = '0.00 USD' -> set SubscriptionStatus = 'Active' -> transition Active
from PastDue on PaymentFailed -> set LastPaymentStatus = 'Failed' -> set DaysPastDue = DaysPastDue + 1 -> set OutstandingBalance = OutstandingBalance + Amount -> no transition
from PastDue on PaymentSuccess -> set LastPaymentDate = PaymentSuccess.PaymentDate -> set LastPaymentAmount = PaymentSuccess.Amount -> set LastPaymentStatus = 'Success' -> set OutstandingBalance = '0.00 USD' -> set SubscriptionStatus = 'Active' -> transition Active
from Cancelled on ReactivateSubscription -> set SubscriptionStatus = 'Active' -> set OutstandingBalance = '0.00 USD' -> transition Active
from Expired on RenewSubscription -> set CurrentPeriodStart = RenewSubscription.NewPeriodStart -> set CurrentPeriodEnd = RenewSubscription.NewPeriodEnd -> set Amount = RenewSubscription.NewAmount -> set NextBillingDate = RenewSubscription.NewPeriodEnd -> set SubscriptionStatus = 'Active' -> transition Active

in Active ensure SubscriptionStatus == 'Active' because "Active subscriptions have active status"
in PastDue ensure OutstandingBalance > '0.00 USD' because "Past due subscriptions have outstanding balance"
in Cancelled ensure CancellationDate is set because "Cancelled subscriptions must have cancellation date"
