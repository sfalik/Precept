precept SaasSubscriptionBilling

# ============================================================================
# DOMAIN: SaaS Subscription Billing Management
# ============================================================================
# Demonstrates: choice-typed plan tiers, money types for billing amounts,
# usage metering with lookup collections, billing cycle management, proration
# calculations, upgrade/downgrade workflows, invoice generation, and a rich
# state machine covering the full subscription lifecycle.
#
# State machine:
#   Draft -> Active -> Suspended -> Reactivated -> Active ... -> Cancelled terminal
#   Active/Reactivated -> Upgrading -> Active (upgrade) / Downgrading -> Active (downgrade)
#
# Key Precept features demonstrated:
#   - Choice-typed plan tiers (Free, Pro, Enterprise)
#   - Money types for subscription fees, proration, and invoices
#   - Lookup collection for usage metering
#   - Log for billing/invoice history
#   - Guarded transitions with specific-before-general ordering
#   - Event ensure constraints on billing events
#   - State constraints (in-state rules)
#   - Conditional rules (metered cap enforcement)

# ============================================================================
# IDENTIFICATION AND PLAN - set at creation time
# ============================================================================

field SubscriptionId as string
field CustomerName as string optional
field CustomerEmail as string optional
field Plan as choice of string("Free", "Pro", "Enterprise")

# ============================================================================
# BILLING DATA - money amounts, billing cycle, currency
# ============================================================================

field Currency as currency default 'USD'
field BillingCycle as choice of string("monthly", "quarterly", "annual") default "monthly"

# Base subscription fee - changes when plan changes.
field MonthlyFee as money in 'USD' default '0.00 USD'
field BilledAmount as money in 'USD' default '0.00 USD'
field ProrationCharge as money in 'USD' default '0.00 USD'
field DiscountAmount as money in 'USD' default '0.00 USD'
field TotalDue as money in 'USD' default '0.00 USD'

# Usage-based overage charges
field OverageCharge as money in 'USD' default '0.00 USD'
field CreditsApplied as money in 'USD' default '0.00 USD'

# ============================================================================
# USAGE METRIC TRACKING - lookup key: metric name, value: current usage count
# ============================================================================

# Tracks per-metric usage: apiCalls, storageGigabytes, seats, supportTickets
field UsageMetrics as lookup of string to integer

# Per-metric limits - lookup key: metric name, value: limit count
field MetricLimits as lookup of string to integer

# ============================================================================
# INVOICE LOG - append-only history of generated invoices
# ============================================================================

field InvoiceHistory as log of string
field InvoiceCount as integer default 0 nonnegative
field LastInvoiceNumber as string

# ============================================================================
# USAGE METRICS DATA - default limits per plan tier
# ============================================================================

# Free tier limits
field FreeApiLimit as integer default 10000 nonnegative
field FreeStorageLimit as integer default 5 nonnegative
field FreeSeatLimit as integer default 3 nonnegative
field FreeTicketLimit as integer default 0 nonnegative

# Pro tier limits
field ProApiLimit as integer default 100000 nonnegative
field ProStorageLimit as integer default 50 nonnegative
field ProSeatLimit as integer default 25 nonnegative
field ProTicketLimit as integer default 10 nonnegative

# Enterprise tier limits
field EnterpriseApiLimit as integer default 1000000 nonnegative
field EnterpriseStorageLimit as integer default 500 nonnegative
field EnterpriseSeatLimit as integer default 200 nonnegative
field EnterpriseTicketLimit as integer default 50 nonnegative

# ============================================================================
# TIMESTAMPS
# ============================================================================

field CreatedAt as instant
field LastBillingDate as instant optional
field SuspendedAt as instant optional
field ReactivatedAt as instant optional
field CancelledAt as instant optional
field NextBillingDate as instant optional
field UpgradedAt as instant optional
field DowngradedAt as instant optional

# ============================================================================
# BILLING PERIOD - duration for next-billing calculations
# ============================================================================

field BillingPeriod as duration default '30 days'
field OneDayPeriod as duration default '1 days'

# ============================================================================
# PLAN CHANGES - tracks pending changes and upgrade/downgrade targets
# ============================================================================

field PendingPlan as choice of string("Free", "Pro", "Enterprise") optional
field ChangeEffectiveAt as instant optional

# ============================================================================
# PAYMENT TRACKING
# ============================================================================

field PaymentMethod as string optional
field PaymentStatus as choice of string("pending", "paid", "failed", "refunded") default "pending"
field FailedPaymentReason as string optional
field LastPaymentAt as instant optional

# ============================================================================
# SUSPENSION AND CANCELLATION REASONS
# ============================================================================

field SuspensionReason as string
field CancellationReason as string

# ============================================================================
# FRAUD AND COMPLIANCE FLAGS
# ============================================================================

field RiskScore as integer default 0 nonnegative max 100
field IsRestricted as boolean default false
field RestrictionReason as string optional

# ============================================================================
# RULES - Domain Invariants
# ============================================================================

# Total due cannot be negative (credits cannot exceed charges)
rule TotalDue >= '0.00 USD' because "Total due cannot be negative"

# Overage charge cannot exceed a reasonable cap relative to base fee
rule OverageCharge <= BilledAmount * 5
    because "Overage charges capped at 5x the billed amount"

# Risk score must stay within bounds (enforced by max modifier, but rule adds semantic guard)
rule RiskScore >= 0 and RiskScore <= 100
    because "Risk score must be between 0 and 100"

# Metered usage rules - enforced conditionally
rule (UsageMetrics for "apiCalls") <= FreeApiLimit when Plan == "Free"
    because "Free tier API calls must not exceed {FreeApiLimit}"

rule (UsageMetrics for "apiCalls") <= ProApiLimit when Plan == "Pro"
    because "Pro tier API calls must not exceed {ProApiLimit}"

rule (UsageMetrics for "apiCalls") <= EnterpriseApiLimit when Plan == "Enterprise"
    because "Enterprise tier API calls must not exceed {EnterpriseApiLimit}"

# ============================================================================
# STATES - full subscription lifecycle
# ============================================================================

state Draft initial
state Active
state Suspended
state Upgrading
state Downgrading
state Cancelled terminal

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================

# In Active state, the subscription must have a payment method on file.
in Active ensure PaymentMethod is set
    because "Active subscriptions must have a payment method on file"

# In Suspended state, usage is frozen.
in Suspended ensure SuspendedAt is set
    because "Suspended subscriptions must have a suspension timestamp"

# In Upgrading/Downgrading, the target plan must be selected.
in Upgrading ensure PendingPlan is set
    because "Upgrade requires a target plan selection"

in Downgrading ensure PendingPlan is set
    because "Downgrade requires a target plan selection"

# In Cancelled state, the cancellation timestamp must be recorded.
in Cancelled ensure CancelledAt is set
    because "Cancelled subscriptions must have a cancellation timestamp"

# While in Active, only billing and usage fields are writable beyond core identity.
in Active modify MonthlyFee, BilledAmount, ProrationCharge, DiscountAmount,
                 TotalDue, OverageCharge, CreditsApplied,
                 UsageMetrics, MetricLimits, PaymentMethod,
                 PaymentStatus, FailedPaymentReason, RiskScore, IsRestricted
                 editable

# ============================================================================
# EVENTS
# ============================================================================

# Entity construction - creates a new subscription in Draft state.
event Create(
    SubscriptionId as string notempty,
    CustomerName as string optional,
    CustomerEmail as string optional,
    InitialPlan as choice of string,
    PaymentMethod as string notempty,
    BillingCycle as choice of string) initial

# Billing events
event RecordUsage(
    MetricName as string notempty,
    AdditionalCount as integer positive)

event ApplyCredit(Amount as money in 'USD' nonnegative)

event GenerateInvoice

event UpdatePaymentMethod(NewMethod as string notempty)

# Plan change events
event RequestUpgrade(TargetPlan as choice of string)
event RequestDowngrade(TargetPlan as choice of string)
event ConfirmPlanChange
event CancelPlanChange

# Lifecycle events
event Suspend(Reason as string optional)
event Reactivate
event Cancel(Reason as string notempty)

# Payment events
event ProcessPayment
event MarkPaymentFailed(Reason as string notempty)

# ============================================================================
# EVENT ENSURE - construction validation
# ============================================================================

on Create ensure Create.InitialPlan == "Free" or Create.InitialPlan == "Pro" or Create.InitialPlan == "Enterprise"
    because "Initial plan must be Free, Pro, or Enterprise"

on Create ensure Create.BillingCycle == "monthly" or Create.BillingCycle == "quarterly" or Create.BillingCycle == "annual"
    because "Billing cycle must be monthly, quarterly, or annual"

# ============================================================================
# CONSTRUCTION - specific-before-general rows for plan-dependent setup
# ============================================================================

# Row 1: Free tier
from Draft on Create when Create.InitialPlan == "Free"
    -> set SubscriptionId = Create.SubscriptionId
    -> set CustomerName = Create.CustomerName
    -> set CustomerEmail = Create.CustomerEmail
    -> set Plan = Create.InitialPlan
    -> set BillingCycle = Create.BillingCycle
    -> set PaymentMethod = Create.PaymentMethod
    -> set CreatedAt = now()
    -> set LastBillingDate = now()
    -> set MonthlyFee = '0.00 USD'
    -> put MetricLimits "apiCalls" = FreeApiLimit
    -> put MetricLimits "storageGigabytes" = FreeStorageLimit
    -> put MetricLimits "seats" = FreeSeatLimit
    -> put MetricLimits "supportTickets" = FreeTicketLimit
    -> put UsageMetrics "apiCalls" = 0
    -> put UsageMetrics "storageGigabytes" = 0
    -> put UsageMetrics "seats" = 0
    -> put UsageMetrics "supportTickets" = 0
    -> set BilledAmount = '0.00 USD'
    -> set ProrationCharge = '0.00 USD'
    -> set DiscountAmount = '0.00 USD'
    -> set TotalDue = '0.00 USD'
    -> set OverageCharge = '0.00 USD'
    -> set CreditsApplied = '0.00 USD'
    -> set InvoiceCount = 0
    -> set PaymentStatus = "pending"
    -> set NextBillingDate = now() + BillingPeriod
    -> set LastInvoiceNumber = "INV-0"
    -> set SuspensionReason = "None"
    -> set CancellationReason = "None"
    -> transition Active

# Row 2: Pro tier
from Draft on Create when Create.InitialPlan == "Pro"
    -> set SubscriptionId = Create.SubscriptionId
    -> set CustomerName = Create.CustomerName
    -> set CustomerEmail = Create.CustomerEmail
    -> set Plan = Create.InitialPlan
    -> set BillingCycle = Create.BillingCycle
    -> set PaymentMethod = Create.PaymentMethod
    -> set CreatedAt = now()
    -> set LastBillingDate = now()
    -> set MonthlyFee = '49.00 USD'
    -> put MetricLimits "apiCalls" = ProApiLimit
    -> put MetricLimits "storageGigabytes" = ProStorageLimit
    -> put MetricLimits "seats" = ProSeatLimit
    -> put MetricLimits "supportTickets" = ProTicketLimit
    -> put UsageMetrics "apiCalls" = 0
    -> put UsageMetrics "storageGigabytes" = 0
    -> put UsageMetrics "seats" = 0
    -> put UsageMetrics "supportTickets" = 0
    -> set BilledAmount = '0.00 USD'
    -> set ProrationCharge = '0.00 USD'
    -> set DiscountAmount = '0.00 USD'
    -> set TotalDue = '0.00 USD'
    -> set OverageCharge = '0.00 USD'
    -> set CreditsApplied = '0.00 USD'
    -> set InvoiceCount = 0
    -> set PaymentStatus = "pending"
    -> set NextBillingDate = now() + BillingPeriod
    -> set LastInvoiceNumber = "INV-0"
    -> set SuspensionReason = "None"
    -> set CancellationReason = "None"
    -> transition Active

# Row 3: Enterprise tier (general/fallback)
from Draft on Create
    -> set SubscriptionId = Create.SubscriptionId
    -> set CustomerName = Create.CustomerName
    -> set CustomerEmail = Create.CustomerEmail
    -> set Plan = Create.InitialPlan
    -> set BillingCycle = Create.BillingCycle
    -> set PaymentMethod = Create.PaymentMethod
    -> set CreatedAt = now()
    -> set LastBillingDate = now()
    -> set MonthlyFee = '199.00 USD'
    -> put MetricLimits "apiCalls" = EnterpriseApiLimit
    -> put MetricLimits "storageGigabytes" = EnterpriseStorageLimit
    -> put MetricLimits "seats" = EnterpriseSeatLimit
    -> put MetricLimits "supportTickets" = EnterpriseTicketLimit
    -> put UsageMetrics "apiCalls" = 0
    -> put UsageMetrics "storageGigabytes" = 0
    -> put UsageMetrics "seats" = 0
    -> put UsageMetrics "supportTickets" = 0
    -> set BilledAmount = '0.00 USD'
    -> set ProrationCharge = '0.00 USD'
    -> set DiscountAmount = '0.00 USD'
    -> set TotalDue = '0.00 USD'
    -> set OverageCharge = '0.00 USD'
    -> set CreditsApplied = '0.00 USD'
    -> set InvoiceCount = 0
    -> set PaymentStatus = "pending"
    -> set NextBillingDate = now() + BillingPeriod
    -> set LastInvoiceNumber = "INV-0"
    -> set SuspensionReason = "None"
    -> set CancellationReason = "None"
    -> transition Active

# ============================================================================
# USAGE METRIC RECORDING
# ============================================================================

# Guard: subscription must be active to record usage.
from Active on RecordUsage when IsRestricted
    -> reject "Cannot record usage - account is restricted"

# Guard: API calls limit exceeded for current plan - reject with upgrade prompt.
from Active on RecordUsage when RecordUsage.MetricName == "apiCalls" and
    (Plan == "Free" and RecordUsage.AdditionalCount > FreeApiLimit) or
    (Plan == "Pro" and RecordUsage.AdditionalCount > ProApiLimit) or
    (Plan == "Enterprise" and RecordUsage.AdditionalCount > EnterpriseApiLimit)
    -> reject "Usage exceeds {Plan} tier limit - request upgrade"

# Guard: storage overage - allow but flag for overage billing.
from Active on RecordUsage when RecordUsage.MetricName == "storageGigabytes" and
    (UsageMetrics for "storageGigabytes") + RecordUsage.AdditionalCount >
    (if Plan == "Free" then FreeStorageLimit
     else if Plan == "Pro" then ProStorageLimit
     else EnterpriseStorageLimit)
    -> put UsageMetrics RecordUsage.MetricName = (UsageMetrics for RecordUsage.MetricName) + RecordUsage.AdditionalCount
    -> set OverageCharge = OverageCharge + '0.50 USD'
    -> append InvoiceHistory "Overage flagged: {RecordUsage.MetricName} +{RecordUsage.AdditionalCount}"
    -> transition Active

# Success: record usage for the metric.
from Active on RecordUsage
    -> put UsageMetrics RecordUsage.MetricName = (UsageMetrics for RecordUsage.MetricName) + RecordUsage.AdditionalCount
    -> transition Active

# ============================================================================
# CREDIT APPLICATION
# ============================================================================

from Active on ApplyCredit when CreditsApplied + ApplyCredit.Amount > '500.00 USD'
    -> reject "Total credits cannot exceed $500.00"
from Active on ApplyCredit
    -> set CreditsApplied = CreditsApplied + ApplyCredit.Amount
    -> set TotalDue = TotalDue - ApplyCredit.Amount
    -> transition Active

from Active on ApplyCredit when TotalDue < '0.00 USD'
    -> set TotalDue = '0.00 USD'
    -> transition Active

# ============================================================================
# INVOICE GENERATION
# ============================================================================

from Active on GenerateInvoice when BilledAmount == '0.00 USD' and OverageCharge == '0.00 USD'
    -> reject "Nothing to bill"
from Active on GenerateInvoice
    -> set TotalDue = BilledAmount + OverageCharge - CreditsApplied
    -> set LastInvoiceNumber = "INV-{InvoiceCount + 1}"
    -> append InvoiceHistory "Generated {LastInvoiceNumber}: Base={BilledAmount} Overage={OverageCharge} Credits={CreditsApplied} Total={TotalDue}"
    -> set InvoiceCount = InvoiceCount + 1
    -> set LastBillingDate = now()
    -> set NextBillingDate = now() + BillingPeriod
    -> set PaymentStatus = "pending"
    -> transition Active

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

from Active on ProcessPayment when TotalDue == '0.00 USD'
    -> reject "No outstanding balance to process"
from Active on ProcessPayment when PaymentStatus == "paid"
    -> reject "Payment already processed for this billing cycle"
from Active on ProcessPayment when PaymentMethod is set
    -> set PaymentStatus = "paid"
    -> set LastPaymentAt = now()
    -> append InvoiceHistory "Payment processed: {TotalDue} via {PaymentMethod}"
    -> set CreditsApplied = '0.00 USD'
    -> set BilledAmount = '0.00 USD'
    -> set OverageCharge = '0.00 USD'
    -> set TotalDue = '0.00 USD'
    -> transition Active

from Active on ProcessPayment
    -> reject "No payment method on file"

from Active on MarkPaymentFailed
    -> set PaymentStatus = "failed"
    -> set FailedPaymentReason = MarkPaymentFailed.Reason
    -> append InvoiceHistory "Payment failed: {MarkPaymentFailed.Reason}"
    -> set RiskScore = min(100, RiskScore + 10)
    -> transition Active

# ============================================================================
# PAYMENT METHOD MANAGEMENT
# ============================================================================

from Active on UpdatePaymentMethod
    -> set PaymentMethod = UpdatePaymentMethod.NewMethod
    -> transition Active

# ============================================================================
# UPGRADE WORKFLOW
# ============================================================================

# Guard: cannot upgrade to the same plan.
from Active on RequestUpgrade when RequestUpgrade.TargetPlan == Plan
    -> reject "Cannot upgrade to the current plan"
# Guard: target plan must be valid.
from Active on RequestUpgrade when RequestUpgrade.TargetPlan != "Pro" and RequestUpgrade.TargetPlan != "Enterprise"
    -> reject "Upgrade target must be Pro or Enterprise"
from Active on RequestUpgrade when RequestUpgrade.TargetPlan == "Enterprise"
    -> set PendingPlan = RequestUpgrade.TargetPlan
    -> set ProrationCharge = '50.00 USD'
    -> set ChangeEffectiveAt = now() + OneDayPeriod
    -> transition Upgrading

from Active on RequestUpgrade when RequestUpgrade.TargetPlan == "Pro"
    -> set PendingPlan = RequestUpgrade.TargetPlan
    -> set ProrationCharge = '5.00 USD'
    -> set ChangeEffectiveAt = now() + OneDayPeriod
    -> transition Upgrading

# In Upgrading state - confirm the upgrade.
from Upgrading on ConfirmPlanChange when PendingPlan is not set
    -> reject "No pending upgrade to confirm"
from Upgrading on ConfirmPlanChange when PendingPlan == "Free"
    -> reject "Cannot upgrade to Free from an active plan"
from Upgrading on ConfirmPlanChange when PendingPlan is set and PendingPlan == "Pro"
    -> set Plan = PendingPlan
    -> clear PendingPlan
    -> set MonthlyFee = '49.00 USD'
    -> set UpgradedAt = now()
    -> put MetricLimits "apiCalls" = ProApiLimit
    -> put MetricLimits "storageGigabytes" = ProStorageLimit
    -> put MetricLimits "seats" = ProSeatLimit
    -> put MetricLimits "supportTickets" = ProTicketLimit
    -> append InvoiceHistory "Upgrade confirmed to {Plan} proration={ProrationCharge}"
    -> clear ChangeEffectiveAt
    -> transition Active
from Upgrading on ConfirmPlanChange when PendingPlan is set and PendingPlan == "Enterprise"
    -> set Plan = PendingPlan
    -> clear PendingPlan
    -> set MonthlyFee = '199.00 USD'
    -> set UpgradedAt = now()
    -> put MetricLimits "apiCalls" = EnterpriseApiLimit
    -> put MetricLimits "storageGigabytes" = EnterpriseStorageLimit
    -> put MetricLimits "seats" = EnterpriseSeatLimit
    -> put MetricLimits "supportTickets" = EnterpriseTicketLimit
    -> append InvoiceHistory "Upgrade confirmed to {Plan} proration={ProrationCharge}"
    -> clear ChangeEffectiveAt
    -> transition Active

# In Upgrading state - cancel the pending upgrade.
from Upgrading on CancelPlanChange
    -> clear PendingPlan
    -> set ProrationCharge = '0.00 USD'
    -> clear ChangeEffectiveAt
    -> transition Active

# ============================================================================
# DOWNGRADE WORKFLOW
# ============================================================================

# Guard: cannot downgrade to the same plan.
from Active on RequestDowngrade when RequestDowngrade.TargetPlan == Plan
    -> reject "Cannot downgrade to the current plan"
# Guard: target plan must be valid for downgrade.
from Active on RequestDowngrade when RequestDowngrade.TargetPlan != "Free" and RequestDowngrade.TargetPlan != "Pro"
    -> reject "Downgrade target must be Free or Pro"
from Active on RequestDowngrade when RequestDowngrade.TargetPlan == "Free"
    -> set PendingPlan = RequestDowngrade.TargetPlan
    -> set ChangeEffectiveAt = now() + OneDayPeriod
    -> transition Downgrading

from Active on RequestDowngrade when RequestDowngrade.TargetPlan == "Pro"
    -> set PendingPlan = RequestDowngrade.TargetPlan
    -> set ChangeEffectiveAt = now() + OneDayPeriod
    -> transition Downgrading

# In Downgrading state - confirm the downgrade.
from Downgrading on ConfirmPlanChange when PendingPlan is not set
    -> reject "No pending downgrade to confirm"
from Downgrading on ConfirmPlanChange when PendingPlan == "Enterprise"
    -> reject "Cannot downgrade to Enterprise from a lower plan"
from Downgrading on ConfirmPlanChange when PendingPlan is set and PendingPlan == "Free"
    -> set Plan = PendingPlan
    -> clear PendingPlan
    -> set MonthlyFee = '0.00 USD'
    -> set DowngradedAt = now()
    -> put MetricLimits "apiCalls" = FreeApiLimit
    -> put MetricLimits "storageGigabytes" = FreeStorageLimit
    -> put MetricLimits "seats" = FreeSeatLimit
    -> put MetricLimits "supportTickets" = FreeTicketLimit
    -> append InvoiceHistory "Downgrade confirmed to {Plan}"
    -> clear ChangeEffectiveAt
    -> transition Active
from Downgrading on ConfirmPlanChange when PendingPlan is set and PendingPlan == "Pro"
    -> set Plan = PendingPlan
    -> clear PendingPlan
    -> set MonthlyFee = '49.00 USD'
    -> set DowngradedAt = now()
    -> put MetricLimits "apiCalls" = ProApiLimit
    -> put MetricLimits "storageGigabytes" = ProStorageLimit
    -> put MetricLimits "seats" = ProSeatLimit
    -> put MetricLimits "supportTickets" = ProTicketLimit
    -> append InvoiceHistory "Downgrade confirmed to {Plan}"
    -> clear ChangeEffectiveAt
    -> transition Active

# In Downgrading state - cancel the pending downgrade.
from Downgrading on CancelPlanChange
    -> clear PendingPlan
    -> clear ChangeEffectiveAt
    -> transition Active

# ============================================================================
# SUSPENSION
# ============================================================================

from Active on Suspend when PaymentStatus == "failed"
    -> reject "Cannot suspend - payment failure requires resolution first"
from Active on Suspend when IsRestricted
    -> reject "Cannot suspend a restricted account"
from Active on Suspend
    -> set SuspendedAt = now()
    -> set PaymentStatus = "pending"
    -> set SuspensionReason = if Suspend.Reason is set then Suspend.Reason else "No reason provided"
    -> append InvoiceHistory "Subscription suspended: {SuspensionReason}"
    -> transition Suspended

# ============================================================================
# REACTIVATION
# ============================================================================

from Suspended on Reactivate when SuspendedAt is not set
    -> reject "No suspension record found"
from Suspended on Reactivate
    -> set ReactivatedAt = now()
    -> clear SuspendedAt
    -> set SuspensionReason = "Reactivated"
    -> set PaymentStatus = "pending"
    -> append InvoiceHistory "Subscription reactivated"
    -> transition Active

# ============================================================================
# CANCELLATION
# ============================================================================

from Active on Cancel when CancelledAt is set
    -> reject "Subscription already cancelled"
from Active on Cancel
    -> set CancelledAt = now()
    -> set PaymentStatus = "refunded"
    -> set CancellationReason = Cancel.Reason
    -> append InvoiceHistory "Subscription cancelled: {CancellationReason}"
    -> transition Cancelled

from Suspended on Cancel
    -> set CancelledAt = now()
    -> set PaymentStatus = "refunded"
    -> set CancellationReason = Cancel.Reason
    -> append InvoiceHistory "Subscription cancelled (was suspended): {CancellationReason}"
    -> transition Cancelled

from Upgrading on Cancel
    -> set CancelledAt = now()
    -> set PaymentStatus = "refunded"
    -> clear PendingPlan
    -> set CancellationReason = Cancel.Reason
    -> append InvoiceHistory "Subscription cancelled during upgrade: {CancellationReason}"
    -> transition Cancelled

from Downgrading on Cancel
    -> set CancelledAt = now()
    -> set PaymentStatus = "refunded"
    -> clear PendingPlan
    -> set CancellationReason = Cancel.Reason
    -> append InvoiceHistory "Subscription cancelled during downgrade: {CancellationReason}"
    -> transition Cancelled
