precept SaasLicenseManagementAndUtilization

# ============================================================================
# DOMAIN: SaaS License Management — Allocation and Utilization
# ============================================================================
# Demonstrates: license pool management with allocation tracking, utilization
# metrics, conditional rules for reassignment, choice-typed license types
# and statuses, guarded transitions, log for audit trail, and a lifecycle
# covering the full license lifecycle from purchase to expiration.
#
# Lifecycle:
#   Purchased → Allocated → InUse → Expired/Reallocated/Returned
#
# Key Precept features demonstrated:
#   - Choice-typed license types (Perpetual, Subscription, Trial, Named, Concurrent)
#   - Choice-typed license statuses
#   - Numeric utilization tracking with percentages
#   - Lookup for license assignments
#   - Log for license audit trail
#   - Conditional rules (utilization cap enforcement)
#   - Guarded transitions with specific-before-general ordering
#   - State constraints (license requirements)
#   - Event ensure constraints on license management

# ============================================================================
# LICENSE IDENTIFICATION
# ============================================================================
field LicenseId as string
field CustomerId as string
field ProductName as string
field LicenseKey as string optional

# ============================================================================
# LICENSE CONFIGURATION
# ============================================================================
field LicenseType as choice of string(
    "Perpetual",
    "Subscription",
    "Trial",
    "Named",
    "Concurrent"
) default "Subscription"
field LicenseCategory as choice of string(
    "FullAccess",
    "LimitedAccess",
    "Readonly",
    "Developer"
) default "FullAccess"
field LicenseStatus as choice of string(
    "Purchased",
    "Allocated",
    "InUse",
    "Expiring",
    "Expired",
    "Reallocated",
    "Returned"
) default "Purchased"

# ============================================================================
# LICENSE PERIOD
# ============================================================================
field PurchaseDate as instant optional
field ActivationDate as instant optional
field ExpirationDate as instant optional
field RenewalDate as instant optional
field DaysUntilExpiration as integer default 0 nonnegative

# ============================================================================
# LICENSE QUANTITY
# ============================================================================
field TotalLicensesPurchased as integer default 0 nonnegative
field LicensesAllocated as integer default 0 nonnegative
field LicensesInUse as integer default 0 nonnegative
field LicensesAvailable as integer default 0 nonnegative
field LicensesReserved as integer default 0 nonnegative

# ============================================================================
# UTILIZATION METRICS
# ============================================================================
field UtilizationPercentage as integer default 0 nonnegative
field MaxUtilizationThreshold as integer default 90 nonnegative
field AvgUtilizationPeriod as integer default 30 nonnegative
field PeakUsageDate as instant optional
field PeakUsageCount as integer default 0 nonnegative

# ============================================================================
# LICENSE ASSIGNMENT — lookup of user email to license info
# ============================================================================
field LicenseAssignments as lookup of string to string
field ReassignmentHistory as log of string

# ============================================================================
# AUDIT LOG
# ============================================================================
field LicenseAuditLog as log of string
field LastAuditDate as instant optional
field AuditTrailCount as integer default 0 nonnegative

# ============================================================================
# RENEWAL TRACKING
# ============================================================================
field RenewalCount as integer default 0 nonnegative
field LastRenewalDate as instant optional
field NextRenewalAmount as money in 'USD' default '0.00 USD'
field RenewalDiscountApplied as money in 'USD' default '0.00 USD'

# ============================================================================
# COST TRACKING
# ============================================================================
field TotalLicenseCost as money in 'USD' default '0.00 USD'
field CostPerLicense as money in 'USD' default '0.00 USD'
field Currency as currency default 'USD'
field BillingCycle as choice of string("Monthly", "Annual") default "Annual"
field LastPaymentDate as instant optional
field OutstandingBalance as money in 'USD' default '0.00 USD'

# ============================================================================
# STATES
# ============================================================================
state Purchased initial
state Allocated
state InUse
state Expiring
state Expired terminal
state Reallocated terminal
state Returned terminal

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Purchased ensure PurchaseDate is set
    because "Purchased state requires a purchase date"
in Allocated ensure LicensesAllocated > 0
    because "Allocated state must have allocated licenses"
in InUse ensure LicensesInUse > 0
    because "InUse state must have active usage"
in Expiring ensure ExpirationDate is set
    because "Expiring state requires an expiration date"
in Expired ensure ExpirationDate is set
    because "Expired state requires an expiration date"
in Reallocated ensure ReassignmentHistory.count > 0
    because "Reallocated state must have reassignment history"
in Returned ensure LastAuditDate is set
    because "Returned state requires an audit timestamp"

# ============================================================================
# EVENTS
# ============================================================================

# Entity construction
event Create(
    LicenseId as string notempty,
    CustomerId as string notempty,
    ProductName as string notempty,
    TotalLicensesPurchased as integer,
    TotalLicenseCost as money in 'USD',
    CostPerLicense as money in 'USD',
    BillingCycle as choice of string("Monthly", "Annual")) initial

# Purchase licenses
event PurchaseLicenses(
    PurchaseDateAsInstant as instant,
    ExpirationDateAsInstant as instant optional)
on PurchaseLicenses ensure PurchaseLicenses.PurchaseDateAsInstant <= now() + '1 days'
    because "Purchase date must be today or yesterday"

# Allocate licenses to users
event AllocateLicenses(UserEmail as string notempty, LicenseType as choice of string("FullAccess", "LimitedAccess", "Readonly", "Developer"))

# Activate license usage
event ActivateUsage(UserEmail as string notempty)

# Reassign license
event ReassignLicense(OldUserEmail as string notempty, NewUserEmail as string notempty)

# Return unused license
event ReturnLicense(Reason as string notempty)

# Monitor utilization
event MonitorUtilization(CurrentInUse as integer)
on MonitorUtilization ensure MonitorUtilization.CurrentInUse >= 0 and MonitorUtilization.CurrentInUse <= TotalLicensesPurchased
    because "Current usage must be within purchased range"

# Update renewal info
event UpdateRenewal(RenewalDateAsInstant as instant, RenewalAmount as money in 'USD')
on UpdateRenewal ensure UpdateRenewal.RenewalDateAsInstant > now()
    because "Renewal date must be in the future"

# Renew license
event RenewLicense(DiscountAmount as money in 'USD')
on RenewLicense ensure RenewLicense.DiscountAmount >= '0.00 USD'
    because "Discount amount must be non-negative"

# Process expiration
event ProcessExpiration(Reason as string notempty)

# Mark as expiring
event MarkAsExpiring

# ============================================================================
# RULES
# ============================================================================
rule LicensesInUse <= LicensesAllocated
    because "In-use licenses cannot exceed allocated licenses"
rule LicensesAllocated <= TotalLicensesPurchased
    because "Allocated licenses cannot exceed purchased licenses"
rule LicensesAvailable == TotalLicensesPurchased - LicensesAllocated
    because "Available licenses equal purchased minus allocated"
rule UtilizationPercentage == (LicensesInUse * 100 / LicensesAllocated) when LicensesAllocated > 0
    because "Utilization percentage must reflect in-use ratio"
rule CostPerLicense > '0.00 USD'
    because "License cost must be positive"

# ============================================================================
# TRANSITIONS
# ============================================================================

# CONSTRUCTION — Purchased → Purchased
from Purchased on Create
    -> set LicenseId = Create.LicenseId
    -> set CustomerId = Create.CustomerId
    -> set ProductName = Create.ProductName
    -> set TotalLicensesPurchased = Create.TotalLicensesPurchased
    -> set LicensesAllocated = 0
    -> set LicensesInUse = 0
    -> set LicensesAvailable = Create.TotalLicensesPurchased
    -> set TotalLicenseCost = Create.TotalLicenseCost
    -> set CostPerLicense = Create.CostPerLicense
    -> set LicenseStatus = "Purchased"
    -> set BillingCycle = Create.BillingCycle
    -> set PurchaseDate = now()
    -> set LicenseAuditLog "License pool created: " + Create.TotalLicensesPurchased + " licenses"
    -> transition Purchased

# Purchase licenses — Purchased
from Purchased on PurchaseLicenses
    -> set PurchaseDate = PurchaseLicenses.PurchaseDateAsInstant
    -> set ExpirationDate = PurchaseLicenses.ExpirationDateAsInstant
    -> set LicenseStatus = "Allocated"
    -> set LicensesAvailable = TotalLicensesPurchased
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "Licenses purchased on " + PurchaseLicenses.PurchaseDateAsInstant
    -> no transition

# Allocate licenses — Purchased → Allocated
from Purchased on AllocateLicenses
    -> set LicenseStatus = "Allocated"
    -> add LicensesAllocated 1
    -> set LicensesAvailable = TotalLicensesPurchased - LicensesAllocated
    -> set LicenseAssignments[AllocateLicenses.UserEmail] = AllocateLicenses.LicenseType
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "License allocated to: " + AllocateLicenses.UserEmail
    -> transition Allocated

# Allocate additional licenses — Allocated
from Allocated on AllocateLicenses
    -> add LicensesAllocated 1
    -> set LicensesAvailable = TotalLicensesPurchased - LicensesAllocated
    -> set LicenseAssignments[AllocateLicenses.UserEmail] = AllocateLicenses.LicenseType
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "Additional license allocated to: " + AllocateLicenses.UserEmail
    -> no transition

# Activate usage — Allocated → InUse
from Allocated on ActivateUsage
    -> set LicenseStatus = "InUse"
    -> add LicensesInUse 1
    -> set ActivationDate = now()
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "License activated by: " + ActivateUsage.UserEmail
    -> transition InUse

# Activate usage — InUse
from InUse on ActivateUsage
    -> add LicensesInUse 1
    -> set LastAuditDate = now()
    -> set PeakUsageCount = LicensesInUse
    -> set PeakUsageDate = now()
    -> append LicenseAuditLog "License usage recorded by: " + ActivateUsage.UserEmail
    -> no transition

# Reassign license — InUse
from InUse on ReassignLicense
    -> remove LicenseAssignments[ReassignLicense.OldUserEmail]
    -> set LicenseAssignments[ReassignLicense.NewUserEmail] = LicenseAssignments[ReassignLicense.OldUserEmail]
    -> set LastAuditDate = now()
    -> append ReassignmentHistory "License reassigned from " + ReassignLicense.OldUserEmail + " to " + ReassignLicense.NewUserEmail
    -> append LicenseAuditLog "License reassigned"
    -> no transition

# Return license — InUse → Returned
from InUse on ReturnLicense
    -> set LicenseStatus = "Returned"
    -> add LicensesAllocated (-1)
    -> add LicensesAvailable 1
    -> remove LicenseAssignments[ReturnLicense.Reason]
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "License returned: " + ReturnLicense.Reason
    -> transition Returned

# Return license — Allocated → Returned
from Allocated on ReturnLicense
    -> set LicenseStatus = "Returned"
    -> add LicensesAllocated (-1)
    -> add LicensesAvailable 1
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "Unallocated license returned: " + ReturnLicense.Reason
    -> transition Returned

# Reassign license — InUse → Reallocated
from InUse on ReassignLicense when LicensesInUse > 0
    -> remove LicenseAssignments[ReassignLicense.OldUserEmail]
    -> set LicenseStatus = "Reallocated"
    -> set LicenseAssignments[ReassignLicense.NewUserEmail] = LicenseAssignments[ReassignLicense.OldUserEmail]
    -> set LastAuditDate = now()
    -> append ReassignmentHistory "License reassigned from " + ReassignLicense.OldUserEmail + " to " + ReassignLicense.NewUserEmail
    -> append LicenseAuditLog "License reallocated"
    -> transition Reallocated

# Monitor utilization — InUse
from InUse on MonitorUtilization
    -> set LicensesInUse = MonitorUtilization.CurrentInUse
    -> set UtilizationPercentage = LicensesInUse * 100 / LicensesAllocated
    -> set LastAuditDate = now()
    -> if UtilizationPercentage >= MaxUtilizationThreshold then append LicenseAuditLog "High utilization alert: " + UtilizationPercentage + "%" else no action
    -> no transition

# Mark as expiring — InUse → Expiring
from InUse on MarkAsExpiring
    -> set LicenseStatus = "Expiring"
    -> set DaysUntilExpiration = 30
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "License marked as expiring"
    -> no transition

# Update renewal — Expiring
from Expiring on UpdateRenewal
    -> set RenewalDate = UpdateRenewal.RenewalDateAsInstant
    -> set NextRenewalAmount = UpdateRenewal.RenewalAmount
    -> set DaysUntilExpiration = 30
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "Renewal information updated"
    -> no transition

# Renew license — Expiring → InUse
from Expiring on RenewLicense
    -> set LicenseStatus = "InUse"
    -> add RenewalCount 1
    -> set LastRenewalDate = now()
    -> set RenewalDiscountApplied = RenewLicense.DiscountAmount
    -> set TotalLicenseCost = TotalLicenseCost + NextRenewalAmount - RenewalDiscountApplied
    -> set ExpirationDate = now() + '365 days'
    -> set DaysUntilExpiration = 365
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "License renewed with " + RenewalDiscountApplied + " discount"
    -> transition InUse

# Process expiration — InUse → Expired
from InUse on ProcessExpiration
    -> set LicenseStatus = "Expired"
    -> set ExpirationDate = now()
    -> set DaysUntilExpiration = 0
    -> set LicensesInUse = LicensesInUse - 1
    -> set LicensesAllocated = LicensesAllocated - 1
    -> set LicensesAvailable = LicensesAvailable + 1
    -> remove LicenseAssignments[ProcessExpiration.Reason]
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "License expired: " + ProcessExpiration.Reason
    -> transition Expired

# Process expiration — Expiring → Expired
from Expiring on ProcessExpiration
    -> set LicenseStatus = "Expired"
    -> set ExpirationDate = now()
    -> set DaysUntilExpiration = 0
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "Expiring license expired: " + ProcessExpiration.Reason
    -> transition Expired

# Process expiration — Allocated → Expired
from Allocated on ProcessExpiration
    -> set LicenseStatus = "Expired"
    -> set ExpirationDate = now()
    -> set DaysUntilExpiration = 0
    -> set LicensesAllocated = LicensesAllocated - 1
    -> set LicensesAvailable = LicensesAvailable + 1
    -> set LastAuditDate = now()
    -> append LicenseAuditLog "Allocated license expired: " + ProcessExpiration.Reason
    -> transition Expired
