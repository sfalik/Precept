precept InsuranceSubrogation

# ============================================================================
# DOMAIN: Insurance — Subrogation (ACORD-aligned)
# ============================================================================
# Demonstrates: subrogation lifecycle tracking, multi-party workflows,
# conditional legal processes, financial recovery tracking, choice-typed
# legal status, lookup for liability documentation, and log for audit trail.
#
# Lifecycle: Identified → Investigation → Demand Sent → Negotiation →
#   Settlement → Recovered/Closed | Litigation → Recovered/Closed
#
# Collection types demonstrated:
#   - lookup  (LiabilityDocuments) — key-value map of evidence documentation
#   - log     (SubrogationLog) — append-only audit trail
# ============================================================================

# ============================================================================
# CLAIM & SUBROGATION IDENTITY
# ============================================================================
field ClaimNumber as string
field SubrogationNumber as string
field OriginalInsuredName as string
field AtFaultParty as string
field AtFaultInsurance as string optional
field IncidentDate as date
field IncidentType as choice of string("Auto","Premises","Product","Medical","Other")

# ============================================================================
# LIABILITY ASSESSMENT
# Demonstrates: lookup of string to decimal for liability percentages.
# ============================================================================
field LiabilityDocuments as lookup of string to string optional
field LiabilityPercentage as decimal default 0.0 nonnegative
field LiabilityDisputed as boolean default false

# ============================================================================
# FINANCIAL TRACKING
# ============================================================================
field RecoveryAmount as money in 'USD'
field TotalRecovered as money in 'USD'
field LegalCosts as money in 'USD' default '0.00 USD'
field NetRecovery as money in 'USD'
field RecoveryPercentage as decimal default 0.0 nonnegative

# ============================================================================
# LEGAL STATUS
# ============================================================================
field LegalStatus as choice of string("No Legal","Demand Letter","Litigation","Arbitration","Mediation","SettlementConference") default "No Legal"
field AttorneyName as string optional
field AttorneyContact as string optional
field CourtFiled as boolean default false
field FilingDate as date optional

# ============================================================================
# SETTLEMENT & RECOVERY TRACKING
# ============================================================================
field SettlementAmount as money in 'USD' optional
field SettlementDate as date optional
field SettlementTerms as string optional
field RecoveryMethod as choice of string("Check","Wire","ACH","Offset","DirectDeposit") optional
field RecoveryDate as date optional

# ============================================================================
# SUBROGATION LOG — append-only audit trail
# ============================================================================
field SubrogationLog as log of string

# ============================================================================
# TIMESTAMPS
# ============================================================================
field IdentifiedAt as instant
field InvestigationStartedAt as instant optional
field InvestigationCompletedAt as instant optional
field DemandSentAt as instant optional
field NegotiationStartedAt as instant optional
field LitigationStartedAt as instant optional
field SettlementExecutedAt as instant optional
field ClosedAt as instant optional

# ============================================================================
# NOTES & REASONS
# ============================================================================
field RecoveryNotes as string optional
field LitigationReason as string optional
field ClosureReason as string optional

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule RecoveryPercentage >= 0.0 and RecoveryPercentage <= 100.0
    because "Recovery percentage must be between 0% and 100%"

rule TotalRecovered.amount <= RecoveryAmount.amount
    because "Total recovered must not exceed total recovery amount"

# ============================================================================
# STATES — 9 total lifecycle positions
# ============================================================================
state Identified initial
state Investigation
state DemandSent
state Negotiation
state Litigation
state Settlement
state Recovered
state Closed terminal
state Abandoned terminal

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.ClaimNumber != ""
    because "Claim number is required for subrogation tracking"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    ClaimNumber as string notempty,
    SubrogationNumber as string notempty,
    OriginalInsuredName as string notempty,
    AtFaultParty as string notempty,
    AtFaultInsurance as string optional,
    IncidentDate as date,
    IncidentType as choice of string("Auto","Premises","Product","Medical","Other"),
    RecoveryAmount as money in 'USD') initial

event AddDocument(DocumentType as string notempty, DocumentContent as string notempty)
event SetLiability(LiabilityPercentage as decimal, Disputed as boolean)

event StartInvestigation
event CompleteInvestigation

event SendDemand(AttorneyName as string notempty)
event StartNegotiation

event BeginLitigation(
    AttorneyName as string notempty,
    AttorneyContact as string notempty,
    FilingDate as date)
event FileCourtDocuments
event AddLitigationCosts(CostAmount as money in 'USD')

event OfferSettlement(
    SettlementAmount as money in 'USD',
    SettlementTerms as string optional)
event AcceptSettlement
event RejectSettlement(Reason as string notempty)

event ExecuteRecovery(RecoveryMethod as choice of string("Check","Wire","ACH","Offset","DirectDeposit"))
event RecordPartialRecovery(Amount as money in 'USD')
event RecordFinalRecovery

event Close
event Abandon(Reason as string notempty)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Investigation ensure InvestigationStartedAt is set
    because "Investigation must have a start timestamp"

in DemandSent ensure DemandSentAt is set
    because "Demand state requires a demand timestamp"

in Negotiation ensure NegotiationStartedAt is set
    because "Negotiation must have a start timestamp"

in Litigation ensure LitigationStartedAt is set
    because "Litigation must have a start timestamp"

in Recovered ensure RecoveryDate is set
    because "Recovered state requires a recovery date"

in Closed ensure ClosedAt is set
    because "Closed state requires a closure timestamp"

in Abandoned ensure ClosedAt is set
    because "Abandoned state requires a closure timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — Identified state setup
# --------------------------------------------------------------------------
from Identified on Create
    -> set ClaimNumber = Create.ClaimNumber
    -> set SubrogationNumber = Create.SubrogationNumber
    -> set OriginalInsuredName = Create.OriginalInsuredName
    -> set AtFaultParty = Create.AtFaultParty
    -> set AtFaultInsurance = Create.AtFaultInsurance
    -> set IncidentDate = Create.IncidentDate
    -> set IncidentType = Create.IncidentType
    -> set RecoveryAmount = Create.RecoveryAmount
    -> set TotalRecovered = '0.00 USD'
    -> set NetRecovery = '0.00 USD'
    -> set RecoveryPercentage = 0.0
    -> set LegalStatus = "No Legal"
    -> set IdentifiedAt = now()
    -> set RecoveryNotes = ""
    -> set ClosureReason = ""
    -> transition Identified

# --------------------------------------------------------------------------
# ADD DOCUMENT — accumulate liability evidence
# --------------------------------------------------------------------------
from Identified on AddDocument
    -> put LiabilityDocuments AddDocument.DocumentType = AddDocument.DocumentContent
    -> append SubrogationLog "Document added: " + AddDocument.DocumentType
    -> no transition

from Investigation on AddDocument
    -> put LiabilityDocuments AddDocument.DocumentType = AddDocument.DocumentContent
    -> append SubrogationLog "Document added: " + AddDocument.DocumentType
    -> no transition

# --------------------------------------------------------------------------
# SET LIABILITY — determine fault percentage
# --------------------------------------------------------------------------
from Investigation on SetLiability
    -> set LiabilityPercentage = SetLiability.LiabilityPercentage
    -> set LiabilityDisputed = SetLiability.Disputed
    -> append SubrogationLog "Liability assessed"
    -> no transition

# --------------------------------------------------------------------------
# START INVESTIGATION — move into investigation state
# --------------------------------------------------------------------------
from Identified on StartInvestigation
    -> set InvestigationStartedAt = now()
    -> append SubrogationLog "Investigation started"
    -> transition Investigation

# --------------------------------------------------------------------------
# COMPLETE INVESTIGATION — Investigation → DemandSent
# --------------------------------------------------------------------------
from Investigation on CompleteInvestigation
    -> set InvestigationCompletedAt = now()
    -> append SubrogationLog "Investigation completed"
    -> transition DemandSent

# --------------------------------------------------------------------------
# SEND DEMAND — initiate demand letter process
# --------------------------------------------------------------------------
from DemandSent on SendDemand when DemandSentAt is set
    -> reject "Demand already sent"
from DemandSent on SendDemand
    -> set AttorneyName = SendDemand.AttorneyName
    -> set DemandSentAt = now()
    -> append SubrogationLog "Demand letter sent"
    -> transition DemandSent

# --------------------------------------------------------------------------
# START NEGOTIATION — DemandSent → Negotiation
# --------------------------------------------------------------------------
from DemandSent on StartNegotiation
    -> set NegotiationStartedAt = now()
    -> append SubrogationLog "Negotiation started"
    -> transition Negotiation

# --------------------------------------------------------------------------
# BEGIN LITIGATION — Negotiation → Litigation
# --------------------------------------------------------------------------
from Negotiation on BeginLitigation
    -> set AttorneyName = BeginLitigation.AttorneyName
    -> set AttorneyContact = BeginLitigation.AttorneyContact
    -> set CourtFiled = true
    -> set FilingDate = BeginLitigation.FilingDate
    -> set LitigationStartedAt = now()
    -> set LegalStatus = "Litigation"
    -> append SubrogationLog "Litigation began"
    -> transition Litigation

# --------------------------------------------------------------------------
# FILE COURT DOCUMENTS — litigation process
# --------------------------------------------------------------------------
from Litigation on FileCourtDocuments
    -> append SubrogationLog "Court documents filed"
    -> no transition

# --------------------------------------------------------------------------
# ADD LITIGATION COSTS — track expenses
# --------------------------------------------------------------------------
from Litigation on AddLitigationCosts
    -> set LegalCosts = LegalCosts + AddLitigationCosts.CostAmount
    -> append SubrogationLog "Litigation costs added"
    -> no transition

# --------------------------------------------------------------------------
# OFFER SETTLEMENT — from Negotiation or Litigation
# Demonstrates: same event from two different states.
# --------------------------------------------------------------------------
from Negotiation on OfferSettlement when OfferSettlement.SettlementAmount.amount <= 0
    -> reject "Settlement amount must be positive"
from Negotiation on OfferSettlement
    -> set SettlementAmount = OfferSettlement.SettlementAmount
    -> set SettlementTerms = OfferSettlement.SettlementTerms
    -> append SubrogationLog "Settlement offer made"
    -> transition Settlement

from Litigation on OfferSettlement when OfferSettlement.SettlementAmount.amount <= 0
    -> reject "Settlement amount must be positive"
from Litigation on OfferSettlement
    -> set SettlementAmount = OfferSettlement.SettlementAmount
    -> set SettlementTerms = OfferSettlement.SettlementTerms
    -> append SubrogationLog "Settlement offer made in litigation"
    -> transition Settlement

# --------------------------------------------------------------------------
# ACCEPT SETTLEMENT — Settlement → Recovered
# --------------------------------------------------------------------------
from Settlement on AcceptSettlement
    -> set RecoveryMethod = "Check"
    -> append SubrogationLog "Settlement accepted"
    -> transition Recovered

# --------------------------------------------------------------------------
# REJECT SETTLEMENT — return to Negotiation or Litigation
# --------------------------------------------------------------------------
from Settlement on RejectSettlement
    -> append SubrogationLog "Settlement rejected"
    -> transition Negotiation

# --------------------------------------------------------------------------
# EXECUTE RECOVERY — mark recovery method
# --------------------------------------------------------------------------
from Recovered on ExecuteRecovery
    -> set RecoveryMethod = ExecuteRecovery.RecoveryMethod
    -> set TotalRecovered = RecoveryAmount
    -> set RecoveryPercentage = 100.0
    -> set NetRecovery = RecoveryAmount - LegalCosts
    -> append SubrogationLog "Recovery executed"
    -> no transition

# --------------------------------------------------------------------------
# RECORD PARTIAL RECOVERY — track payments received
# Special case: no total to divide by.
# --------------------------------------------------------------------------
from Recovered on RecordPartialRecovery when RecordPartialRecovery.Amount.amount <= 0
    -> reject "Partial recovery amount must be positive"
from Recovered on RecordPartialRecovery when RecoveryAmount.amount == 0
    -> set TotalRecovered = TotalRecovered + RecordPartialRecovery.Amount
    -> set RecoveryPercentage = 0.0
    -> append SubrogationLog "Partial recovery recorded"
    -> no transition

# --------------------------------------------------------------------------
# RECORD PARTIAL RECOVERY — general case with non-zero total
# Note: proof engine does not propagate guards through arithmetic expressions.
# Store 0.0 here; percentage computed externally when needed.
# --------------------------------------------------------------------------
from Recovered on RecordPartialRecovery
    -> set TotalRecovered = TotalRecovered + RecordPartialRecovery.Amount
    -> set RecoveryPercentage = 0.0
    -> append SubrogationLog "Partial recovery recorded"
    -> no transition

# --------------------------------------------------------------------------
# RECORD FINAL RECOVERY — mark fully recovered
# --------------------------------------------------------------------------
from Recovered on RecordFinalRecovery
    -> set TotalRecovered = RecoveryAmount
    -> set RecoveryPercentage = 100.0
    -> set NetRecovery = RecoveryAmount - LegalCosts
    -> append SubrogationLog "Full recovery confirmed"
    -> no transition

# --------------------------------------------------------------------------
# CLOSE — Recovered → Closed
# --------------------------------------------------------------------------
from Recovered on Close
    -> set ClosedAt = now()
    -> set ClosureReason = "Recovery complete"
    -> append SubrogationLog "Subrogation closed"
    -> transition Closed

# --------------------------------------------------------------------------
# ABANDON — from any state
# --------------------------------------------------------------------------
from Identified on Abandon
    -> set ClosedAt = now()
    -> set ClosureReason = Abandon.Reason
    -> append SubrogationLog "Subrogation abandoned"
    -> transition Abandoned

from Investigation on Abandon
    -> set ClosedAt = now()
    -> set ClosureReason = Abandon.Reason
    -> append SubrogationLog "Subrogation abandoned during investigation"
    -> transition Abandoned

from DemandSent on Abandon
    -> set ClosedAt = now()
    -> set ClosureReason = Abandon.Reason
    -> append SubrogationLog "Subrogation abandoned — demand stage"
    -> transition Abandoned

from Negotiation on Abandon
    -> set ClosedAt = now()
    -> set ClosureReason = Abandon.Reason
    -> append SubrogationLog "Subrogation abandoned — negotiation stage"
    -> transition Abandoned

from Litigation on Abandon
    -> set ClosedAt = now()
    -> set ClosureReason = Abandon.Reason
    -> append SubrogationLog "Subrogation abandoned — litigation stage"
    -> transition Abandoned

from Settlement on Abandon
    -> set ClosedAt = now()
    -> set ClosureReason = Abandon.Reason
    -> append SubrogationLog "Subrogation abandoned — settlement stage"
    -> transition Abandoned