precept SaasCustomerSuccessAndHealthScoring

# ============================================================================
# DOMAIN: SaaS Customer Success — Health Scoring
# ============================================================================
# Demonstrates: choice-typed health statuses, score tracking with numeric
# fields, lookup for features used, log for outreach history, guarded
# transitions with specific-before-general ordering, event ensures,
# state constraints, conditional rules, and a rich lifecycle covering
# customer health assessment and interventions.
#
# Lifecycle:
#   Onboarded → Active → AtRisk → Intervention → Recovered/Churned
#
# Key Precept features demonstrated:
#   - Numeric score tracking for health metrics
#   - Choice-typed health statuses and risk levels
#   - Lookup for feature usage tracking
#   - Log for outreach history
#   - Guarded transitions with specific-before-general ordering
#   - Event ensure constraints on outreach
#   - State constraints (intervention requires action log)
#   - Conditional rules (risk factor enforcement)

# ============================================================================
# CUSTOMER IDENTIFICATION
# ============================================================================
field CustomerId as string
field CustomerName as string
field CustomerEmail as string
field AccountTier as choice of string("Startup", "Growth", "Enterprise")

# ============================================================================
# HEALTH METRICS
# ============================================================================
field HealthStatus as choice of string("Onboarded", "Active", "AtRisk", "Intervention", "Recovered", "Churned")
field OverallHealthScore as integer default 0 nonnegative
field UsageScore as integer default 0 nonnegative
field EngagementScore as integer default 0 nonnegative
field SatisfactionScore as integer default 0 nonnegative

# ============================================================================
# RISK FACTORS
# ============================================================================
field RiskFactors as set of string
field RiskLevel as choice of string("Low", "Medium", "High") default "Low"
field LastRiskAssessmentAt as instant optional

# ============================================================================
# ENGAGEMENT TRACKING
# ============================================================================
field LastContactAt as instant optional
field LastLoginDate as instant optional
field DaysSinceLastLogin as integer default 0 nonnegative
field LoginCountThisMonth as integer default 0 nonnegative
field SupportTicketsOpen as integer default 0 nonnegative

# ============================================================================
# SUCCESS PLAN
# ============================================================================
field SuccessPlan as string optional
field KeyMetricsTracked as set of string
field MilestonesCompleted as integer default 0 nonnegative
field TotalMilestones as integer default 0 nonnegative

# ============================================================================
# OUTREACH HISTORY
# ============================================================================
field OutreachHistory as log of string
field OutreachCount as integer default 0 nonnegative
field LastOutreachType as string optional
field NextOutreachScheduled as instant optional

# ============================================================================
# ACCOUNT HEALTH DATA
# ============================================================================
field DaysSinceOnboarding as integer default 0 nonnegative
field ContractValue as money in 'USD' default '0.00 USD'
field RenewalDate as instant optional
field RenewalRisk as choice of string("Low", "Medium", "High") default "Low"
field CompletedAt as instant optional

# ============================================================================
# FEATURES USED — lookup of feature name to last used date
# ============================================================================
field FeaturesUsed as lookup of string to string

# ============================================================================
# STATES
# ============================================================================
state Onboarded initial
state Active
state AtRisk
state Intervention
state Recovered terminal
state Churned terminal

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Active ensure OverallHealthScore >= 50
    because "Active customers must have a health score of at least 50"
in AtRisk ensure OverallHealthScore < 50 and OverallHealthScore > 0
    because "At-risk customers must have a health score below 50"
in Intervention ensure OutreachHistory.count > 0
    because "Intervention requires at least one outreach action"
in Recovered ensure LastContactAt is set
    because "Recovered customers must have a contact timestamp"
in Churned ensure LastContactAt is set
    because "Churned customers must have a contact timestamp"

# ============================================================================
# EVENTS
# ============================================================================

# Entity construction
event Create(
    CustomerId as string notempty,
    CustomerName as string notempty,
    CustomerEmail as string notempty,
    AccountTier as choice of string("Startup", "Growth", "Enterprise"),
    ContractValue as money in 'USD') initial

# Update health scores — high score (>= 70)
event UpdateHighScores(Usage as integer, Engagement as integer, Satisfaction as integer)
on UpdateHighScores ensure UpdateHighScores.Usage >= 50 and UpdateHighScores.Usage <= 100
    because "Usage score must be between 50 and 100"
on UpdateHighScores ensure UpdateHighScores.Engagement >= 50 and UpdateHighScores.Engagement <= 100
    because "Engagement score must be between 50 and 100"
on UpdateHighScores ensure UpdateHighScores.Satisfaction >= 50 and UpdateHighScores.Satisfaction <= 100
    because "Satisfaction score must be between 50 and 100"

# Update health scores — medium score (50-69)
event UpdateMediumScores(Usage as integer, Engagement as integer, Satisfaction as integer)
on UpdateMediumScores ensure UpdateMediumScores.Usage >= 0 and UpdateMediumScores.Usage <= 69
    because "Usage score must be between 0 and 69"
on UpdateMediumScores ensure UpdateMediumScores.Engagement >= 0 and UpdateMediumScores.Engagement <= 69
    because "Engagement score must be between 0 and 69"
on UpdateMediumScores ensure UpdateMediumScores.Satisfaction >= 0 and UpdateMediumScores.Satisfaction <= 69
    because "Satisfaction score must be between 0 and 69"

# Update health scores — low score (< 50)
event UpdateLowScores(Usage as integer, Engagement as integer, Satisfaction as integer)
on UpdateLowScores ensure UpdateLowScores.Usage >= 0 and UpdateLowScores.Usage < 50
    because "Usage score must be between 0 and 49"
on UpdateLowScores ensure UpdateLowScores.Engagement >= 0 and UpdateLowScores.Engagement < 50
    because "Engagement score must be between 0 and 49"
on UpdateLowScores ensure UpdateLowScores.Satisfaction >= 0 and UpdateLowScores.Satisfaction < 50
    because "Satisfaction score must be between 0 and 49"

# Log feature usage
event LogFeatureUsage(FeatureName as string notempty, LastUsedDate as string)

# Add risk factor
event AddRiskFactor(Factor as string notempty)

# Remove risk factor
event RemoveRiskFactor(Factor as string notempty)

# Initiate proactive outreach
event InitiateOutreach(OutreachType as string notempty, ScheduledDate as instant)
on InitiateOutreach ensure InitiateOutreach.ScheduledDate > now()
    because "Outreach date must be in the future"

# Complete outreach and update engagement
event CompleteOutreach(Outcome as string notempty, SatisfactionDelta as integer)
on CompleteOutreach ensure CompleteOutreach.SatisfactionDelta >= -10 and CompleteOutreach.SatisfactionDelta <= 10
    because "Satisfaction delta must be between -10 and 10"

# Escalate to intervention
event EscalateToIntervention

# Recover customer
event RecoverCustomer(SuccessPlan as string notempty)

# Churn customer
event ChurnCustomer(Reason as string notempty)

# ============================================================================
# RULES
# ============================================================================
rule OverallHealthScore >= 0
    because "Health score must be non-negative"
rule RiskLevel == "High" when RiskFactors.count >= 3
    because "High risk requires three or more risk factors"
rule RiskLevel == "Medium" when RiskFactors.count == 2
    because "Medium risk requires two risk factors"
rule RiskLevel == "Low" when RiskFactors.count <= 1
    because "Low risk requires fewer than two risk factors"

# ============================================================================
# TRANSITIONS
# ============================================================================

# CONSTRUCTION — Onboarded → Onboarded
from Onboarded on Create
    -> set CustomerId = Create.CustomerId
    -> set CustomerName = Create.CustomerName
    -> set CustomerEmail = Create.CustomerEmail
    -> set AccountTier = Create.AccountTier
    -> set ContractValue = Create.ContractValue
    -> set HealthStatus = "Onboarded"
    -> set OverallHealthScore = 50
    -> set UsageScore = 50
    -> set EngagementScore = 50
    -> set SatisfactionScore = 50
    -> set RiskLevel = "Low"
    -> append OutreachHistory "Customer onboarded: " + Create.CustomerId
    -> transition Onboarded

# Update HIGH scores — stay in current state or move to Active
from Onboarded on UpdateHighScores
    -> set UsageScore = UpdateHighScores.Usage
    -> set EngagementScore = UpdateHighScores.Engagement
    -> set SatisfactionScore = UpdateHighScores.Satisfaction
    -> set OverallHealthScore = (UpdateHighScores.Usage + UpdateHighScores.Engagement + UpdateHighScores.Satisfaction) / 3
    -> set HealthStatus = "Active"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "High scores updated"
    -> no transition

from Active on UpdateHighScores
    -> set UsageScore = UpdateHighScores.Usage
    -> set EngagementScore = UpdateHighScores.Engagement
    -> set SatisfactionScore = UpdateHighScores.Satisfaction
    -> set OverallHealthScore = (UpdateHighScores.Usage + UpdateHighScores.Engagement + UpdateHighScores.Satisfaction) / 3
    -> set HealthStatus = "Active"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "High scores updated"
    -> no transition

from AtRisk on UpdateHighScores
    -> set UsageScore = UpdateHighScores.Usage
    -> set EngagementScore = UpdateHighScores.Engagement
    -> set SatisfactionScore = UpdateHighScores.Satisfaction
    -> set OverallHealthScore = (UpdateHighScores.Usage + UpdateHighScores.Engagement + UpdateHighScores.Satisfaction) / 3
    -> set HealthStatus = "Active"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Scores improved to high range"
    -> transition Active

from Intervention on UpdateHighScores
    -> set UsageScore = UpdateHighScores.Usage
    -> set EngagementScore = UpdateHighScores.Engagement
    -> set SatisfactionScore = UpdateHighScores.Satisfaction
    -> set OverallHealthScore = (UpdateHighScores.Usage + UpdateHighScores.Engagement + UpdateHighScores.Satisfaction) / 3
    -> set HealthStatus = "Active"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Scores improved to high range"
    -> transition Active

# Update MEDIUM scores — stay in current state or move to Active
from Onboarded on UpdateMediumScores
    -> set UsageScore = UpdateMediumScores.Usage
    -> set EngagementScore = UpdateMediumScores.Engagement
    -> set SatisfactionScore = UpdateMediumScores.Satisfaction
    -> set OverallHealthScore = (UpdateMediumScores.Usage + UpdateMediumScores.Engagement + UpdateMediumScores.Satisfaction) / 3
    -> set HealthStatus = "Onboarded"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Medium scores updated"
    -> no transition

from Active on UpdateMediumScores
    -> set UsageScore = UpdateMediumScores.Usage
    -> set EngagementScore = UpdateMediumScores.Engagement
    -> set SatisfactionScore = UpdateMediumScores.Satisfaction
    -> set OverallHealthScore = (UpdateMediumScores.Usage + UpdateMediumScores.Engagement + UpdateMediumScores.Satisfaction) / 3
    -> set HealthStatus = "Active"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Medium scores updated"
    -> no transition

from AtRisk on UpdateMediumScores
    -> set UsageScore = UpdateMediumScores.Usage
    -> set EngagementScore = UpdateMediumScores.Engagement
    -> set SatisfactionScore = UpdateMediumScores.Satisfaction
    -> set OverallHealthScore = (UpdateMediumScores.Usage + UpdateMediumScores.Engagement + UpdateMediumScores.Satisfaction) / 3
    -> set HealthStatus = "Active"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Scores improved to medium range"
    -> transition Active

from Intervention on UpdateMediumScores
    -> set UsageScore = UpdateMediumScores.Usage
    -> set EngagementScore = UpdateMediumScores.Engagement
    -> set SatisfactionScore = UpdateMediumScores.Satisfaction
    -> set OverallHealthScore = (UpdateMediumScores.Usage + UpdateMediumScores.Engagement + UpdateMediumScores.Satisfaction) / 3
    -> set HealthStatus = "Intervention"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Medium scores updated"
    -> no transition

# Update LOW scores — move to AtRisk if not already
from Onboarded on UpdateLowScores
    -> set UsageScore = UpdateLowScores.Usage
    -> set EngagementScore = UpdateLowScores.Engagement
    -> set SatisfactionScore = UpdateLowScores.Satisfaction
    -> set OverallHealthScore = (UpdateLowScores.Usage + UpdateLowScores.Engagement + UpdateLowScores.Satisfaction) / 3
    -> set HealthStatus = "Onboarded"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Low scores updated"
    -> no transition

from Active on UpdateLowScores
    -> set UsageScore = UpdateLowScores.Usage
    -> set EngagementScore = UpdateLowScores.Engagement
    -> set SatisfactionScore = UpdateLowScores.Satisfaction
    -> set OverallHealthScore = (UpdateLowScores.Usage + UpdateLowScores.Engagement + UpdateLowScores.Satisfaction) / 3
    -> set HealthStatus = "AtRisk"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Scores dropped to low range"
    -> transition AtRisk

from AtRisk on UpdateLowScores
    -> set UsageScore = UpdateLowScores.Usage
    -> set EngagementScore = UpdateLowScores.Engagement
    -> set SatisfactionScore = UpdateLowScores.Satisfaction
    -> set OverallHealthScore = (UpdateLowScores.Usage + UpdateLowScores.Engagement + UpdateLowScores.Satisfaction) / 3
    -> set HealthStatus = "AtRisk"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Low scores updated"
    -> no transition

from Intervention on UpdateLowScores
    -> set UsageScore = UpdateLowScores.Usage
    -> set EngagementScore = UpdateLowScores.Engagement
    -> set SatisfactionScore = UpdateLowScores.Satisfaction
    -> set OverallHealthScore = (UpdateLowScores.Usage + UpdateLowScores.Engagement + UpdateLowScores.Satisfaction) / 3
    -> set HealthStatus = "Intervention"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Low scores updated during intervention"
    -> no transition

# Log feature usage
from Onboarded on LogFeatureUsage
    -> append OutreachHistory "Feature used: " + LogFeatureUsage.FeatureName
    -> no transition

from Active on LogFeatureUsage
    -> append OutreachHistory "Feature used: " + LogFeatureUsage.FeatureName
    -> no transition

# Add risk factor — Active → AtRisk
from Active on AddRiskFactor when RiskFactors.count < 2
    -> add RiskFactors AddRiskFactor.Factor
    -> set RiskLevel = "Medium"
    -> set HealthStatus = "AtRisk"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Risk factor added: " + AddRiskFactor.Factor
    -> no transition

from Active on AddRiskFactor when RiskFactors.count >= 2
    -> add RiskFactors AddRiskFactor.Factor
    -> set RiskLevel = "High"
    -> set HealthStatus = "AtRisk"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Critical risk factor added: " + AddRiskFactor.Factor
    -> no transition

from AtRisk on AddRiskFactor when RiskFactors.count >= 2
    -> add RiskFactors AddRiskFactor.Factor
    -> set RiskLevel = "High"
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "High risk factor added: " + AddRiskFactor.Factor
    -> no transition

# Remove risk factor — AtRisk → Active (if enough factors removed)
from AtRisk on RemoveRiskFactor
    -> remove RiskFactors RemoveRiskFactor.Factor
    -> set LastRiskAssessmentAt = now()
    -> append OutreachHistory "Risk factor removed: " + RemoveRiskFactor.Factor
    -> no transition

# Initiate proactive outreach — Active (no state change)
from Active on InitiateOutreach
    -> set NextOutreachScheduled = InitiateOutreach.ScheduledDate
    -> set LastOutreachType = InitiateOutreach.OutreachType
    -> set OutreachCount = OutreachCount + 1
    -> append OutreachHistory "Outreach initiated: " + InitiateOutreach.OutreachType
    -> no transition

# Initiate proactive outreach — AtRisk → Intervention
from AtRisk on InitiateOutreach
    -> set HealthStatus = "Intervention"
    -> set NextOutreachScheduled = InitiateOutreach.ScheduledDate
    -> set LastOutreachType = InitiateOutreach.OutreachType
    -> set OutreachCount = OutreachCount + 1
    -> append OutreachHistory "Intervention outreach: " + InitiateOutreach.OutreachType
    -> no transition

# Complete outreach — Intervention → Active (if scores improved enough)
from Intervention on CompleteOutreach
    -> set EngagementScore = EngagementScore + 5
    -> set SatisfactionScore = SatisfactionScore + CompleteOutreach.SatisfactionDelta
    -> set OverallHealthScore = (UsageScore + EngagementScore + SatisfactionScore) / 3
    -> set LastContactAt = now()
    -> set OutreachCount = OutreachCount + 1
    -> set LastOutreachType = "Complete"
    -> set HealthStatus = "Recovered"
    -> append OutreachHistory "Outreach completed: " + CompleteOutreach.Outcome
    -> transition Recovered

# Escalate to intervention — AtRisk → Intervention
from AtRisk on EscalateToIntervention
    -> set HealthStatus = "Intervention"
    -> append OutreachHistory "Escalated to intervention"
    -> no transition

# Recover customer — Intervention → Recovered
from Intervention on RecoverCustomer
    -> set HealthStatus = "Recovered"
    -> set SuccessPlan = RecoverCustomer.SuccessPlan
    -> set LastContactAt = now()
    -> set CompletedAt = now()
    -> append OutreachHistory "Customer recovered with plan: " + RecoverCustomer.SuccessPlan
    -> transition Recovered

# Churn customer — AtRisk → Churned
from AtRisk on ChurnCustomer
    -> set HealthStatus = "Churned"
    -> set LastContactAt = now()
    -> set CompletedAt = now()
    -> append OutreachHistory "Customer churned: " + ChurnCustomer.Reason
    -> transition Churned
