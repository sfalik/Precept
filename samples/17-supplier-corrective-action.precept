precept SupplierCorrectiveAction

# ============================================================================
# DOMAIN: Manufacturing — Supplier Corrective Action Request (SCAR)
# ============================================================================
# Demonstrates: 8D problem-solving workflow, complex multi-stage corrective
# action lifecycle, temporal tracking, conditional outcomes, lookup for
# evidence documentation, and log for audit trail.
#
# Lifecycle: Open → Investigating → CorrectiveActionProposed →
#   Implemented → Verified → Closed | Reopened
#
# Collection types demonstrated:
#   - lookup  (EvidenceDocuments) — key-value map of investigation evidence
#   - log     (SCARLog) — append-only audit trail
# ============================================================================

# ============================================================================
# SCAR IDENTITY
# ============================================================================
field SCARNumber as string
field SupplierNumber as string
field SupplierName as string
field IssueDate as date
field DueDate as date
field IssueCategory as choice of string("Defect","Delivery","Documentation","Process","QualitySystem","Other")
field Severity as choice of string("Minor","Major","Critical")

# ============================================================================
# PROBLEM DESCRIPTION
# ============================================================================
field ProblemDescription as string
field QuantityAffected as integer default 0 nonnegative
field DateOfOccurrence as date optional
field DetectionDate as date optional

# ============================================================================
# 8D WORKFLOW DATA
# ============================================================================
# D0: Preparation and escalation
# D1: Form the team
field TeamMembers as lookup of string to string optional
# D2: Describe the problem
# (already captured in ProblemDescription)
# D3: Interim containment actions
field ContainmentActions as string optional
field ContainmentDate as date optional
# D4: Determine root cause
field RootCauseCategory as choice of string("HumanError","Equipment","Material","Method","Environment","Design","Other") optional
field RootCauseDescription as string optional
# D5: Choose permanent corrective actions
field CorrectiveActions as choice of string("Training","ProcessChange","EquipmentRepair","DesignChange","InspectionIncrease","Other") optional
field CorrectiveActionDescription as string optional
# D6: Implement and validate
# D7: Prevent recurrence
field PreventiveActions as string optional
# D8: Recognize the team
field TeamRecognition as string optional

# ============================================================================
# TIMELINE
# ============================================================================
field InvestigatedAt as instant optional
field ActionProposedAt as instant optional
field ImplementedAt as instant optional
field VerifiedAt as instant optional
field ClosedAt as instant optional

# ============================================================================
# VERIFICATION DATA
# ============================================================================
field VerificationMethod as choice of string("OnSiteAudit","DocumentReview","SampleInspection","PerformanceData","Other") optional
field VerificationResults as string optional
field EffectivenessConfirmed as boolean default false
field ReopenReason as string optional

# ============================================================================
# STATUS TRACKING
# ============================================================================
field SCARStatus as choice of string("Open","Investigating","CorrectiveActionProposed","Implemented","Verified","Closed","Reopened") default "Open"
field AssignedTo as string optional

# ============================================================================
# SCAR LOG — append-only audit trail
# ============================================================================
field SCARLog as log of string

# ============================================================================
# EVIDENCE — key-value map of investigation evidence
# ============================================================================
field EvidenceDocuments as lookup of string to string optional

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule DueDate > IssueDate
    because "Due date must be after issue date"

# ============================================================================
# STATES — 7 total lifecycle positions
# ============================================================================
state Open initial
state Investigating
state CorrectiveActionProposed
state Implemented
state Verified
state Closed terminal
state Reopened

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.SCARNumber != ""
    because "SCAR number is required for corrective action tracking"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    SCARNumber as string notempty,
    SupplierNumber as string notempty,
    SupplierName as string notempty,
    IssueDate as date,
    DueDate as date,
    IssueCategory as choice of string("Defect","Delivery","Documentation","Process","QualitySystem","Other"),
    Severity as choice of string("Minor","Major","Critical")) initial

event AssignOwner(AssignedTo as string notempty)
event AddTeamMember(MemberRole as string notempty, MemberName as string notempty)
event AddEvidence(DocumentType as string notempty, DocumentContent as string notempty)

event BeginInvestigation
event SubmitContainment(Actions as string notempty, Date as date)
event CompleteInvestigation(
    RootCauseCategory as choice of string("HumanError","Equipment","Material","Method","Environment","Design","Other"),
    RootCauseDescription as string notempty)

event ProposeCorrectiveAction(
    ActionCategory as choice of string("Training","ProcessChange","EquipmentRepair","DesignChange","InspectionIncrease","Other"),
    ActionDescription as string notempty)

event ImplementActions(ImplementationDate as date, Details as string notempty)
event RequestVerification

event PerformVerification(
    Method as choice of string("OnSiteAudit","DocumentReview","SampleInspection","PerformanceData","Other"),
    Results as string notempty)
event ConfirmEffectiveness
event RejectVerification(Reason as string notempty)

event CloseSCAR
event Reopen(Reason as string notempty)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Investigating ensure InvestigatedAt is set
    because "Investigating state requires investigation timestamp"

in CorrectiveActionProposed ensure ActionProposedAt is set
    because "Action proposed state requires proposal timestamp"

in Implemented ensure ImplementedAt is set
    because "Implemented state requires implementation timestamp"

in Verified ensure VerifiedAt is set
    because "Verified state requires verification timestamp"

in Closed ensure ClosedAt is set
    because "Closed state requires closure timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — Open state setup
# --------------------------------------------------------------------------
from Open on Create
    -> set SCARNumber = Create.SCARNumber
    -> set SupplierNumber = Create.SupplierNumber
    -> set SupplierName = Create.SupplierName
    -> set ProblemDescription = "SCAR opened"
    -> set IssueDate = Create.IssueDate
    -> set DueDate = Create.DueDate
    -> set IssueCategory = Create.IssueCategory
    -> set Severity = Create.Severity
    -> set SCARStatus = "Open"
    -> set EffectivenessConfirmed = false
    -> set InvestigatedAt = now()
    -> transition Open

# --------------------------------------------------------------------------
# ASSIGN OWNER — initial assignment
# --------------------------------------------------------------------------
from Open on AssignOwner
    -> set AssignedTo = AssignOwner.AssignedTo
    -> append SCARLog "SCAR assigned to: " + AssignOwner.AssignedTo
    -> no transition

# --------------------------------------------------------------------------
# ADD TEAM MEMBER — build investigation team
# --------------------------------------------------------------------------
from Open on AddTeamMember
    -> put TeamMembers AddTeamMember.MemberRole = AddTeamMember.MemberName
    -> append SCARLog "Team member added: " + AddTeamMember.MemberRole
    -> no transition

from Investigating on AddTeamMember
    -> put TeamMembers AddTeamMember.MemberRole = AddTeamMember.MemberName
    -> append SCARLog "Team member added: " + AddTeamMember.MemberRole
    -> no transition

# --------------------------------------------------------------------------
# ADD EVIDENCE — collect investigation data
# --------------------------------------------------------------------------
from Open on AddEvidence
    -> put EvidenceDocuments AddEvidence.DocumentType = AddEvidence.DocumentContent
    -> append SCARLog "Evidence added: " + AddEvidence.DocumentType
    -> no transition

from Investigating on AddEvidence
    -> put EvidenceDocuments AddEvidence.DocumentType = AddEvidence.DocumentContent
    -> append SCARLog "Evidence added: " + AddEvidence.DocumentType
    -> no transition

# --------------------------------------------------------------------------
# BEGIN INVESTIGATION — Open → Investigating
# --------------------------------------------------------------------------
from Open on BeginInvestigation
    -> set AssignedTo = "Unassigned"
    -> set InvestigatedAt = now()
    -> set SCARStatus = "Investigating"
    -> append SCARLog "Investigation initiated"
    -> transition Investigating

# --------------------------------------------------------------------------
# SUBMIT CONTAINMENT — interim action during investigation
# --------------------------------------------------------------------------
from Investigating on SubmitContainment
    -> set ContainmentActions = SubmitContainment.Actions
    -> set ContainmentDate = SubmitContainment.Date
    -> append SCARLog "Containment actions documented"
    -> no transition

# --------------------------------------------------------------------------
# COMPLETE INVESTIGATION — root cause identified
# --------------------------------------------------------------------------
from Investigating on CompleteInvestigation
    -> set RootCauseCategory = CompleteInvestigation.RootCauseCategory
    -> set RootCauseDescription = CompleteInvestigation.RootCauseDescription
    -> set ActionProposedAt = now()
    -> set SCARStatus = "CorrectiveActionProposed"
    -> append SCARLog "Investigation complete — root cause identified"
    -> transition CorrectiveActionProposed

# --------------------------------------------------------------------------
# PROPOSE CORRECTIVE ACTION — solution proposed
# --------------------------------------------------------------------------
from CorrectiveActionProposed on ProposeCorrectiveAction
    -> set CorrectiveActions = ProposeCorrectiveAction.ActionCategory
    -> set CorrectiveActionDescription = ProposeCorrectiveAction.ActionDescription
    -> append SCARLog "Corrective action proposed"
    -> transition CorrectiveActionProposed

# --------------------------------------------------------------------------
# IMPLEMENT ACTIONS — action implemented
# --------------------------------------------------------------------------
from CorrectiveActionProposed on ImplementActions
    -> set ImplementedAt = now()
    -> set SCARStatus = "Implemented"
    -> append SCARLog "Corrective actions implemented"
    -> transition Implemented

# --------------------------------------------------------------------------
# REQUEST VERIFICATION — supplier requests effectiveness check
# --------------------------------------------------------------------------
from Implemented on RequestVerification
    -> set VerifiedAt = now()
    -> set SCARStatus = "Verified"
    -> append SCARLog "Verification requested"
    -> transition Verified

# --------------------------------------------------------------------------
# PERFORM VERIFICATION — verification conducted
# --------------------------------------------------------------------------
from Verified on PerformVerification
    -> set VerificationMethod = PerformVerification.Method
    -> set VerificationResults = PerformVerification.Results
    -> append SCARLog "Verification performed"
    -> no transition

# --------------------------------------------------------------------------
# CONFIRM EFFECTIVENESS — verification successful
# --------------------------------------------------------------------------
from Verified on ConfirmEffectiveness
    -> set EffectivenessConfirmed = true
    -> append SCARLog "Effectiveness confirmed — closing SCAR"
    -> transition Closed

# --------------------------------------------------------------------------
# REJECT VERIFICATION — effectiveness not confirmed
# --------------------------------------------------------------------------
from Verified on RejectVerification
    -> set ReopenReason = RejectVerification.Reason
    -> set SCARStatus = "Reopened"
    -> append SCARLog "Verification rejected — SCAR reopened"
    -> transition Reopened

# --------------------------------------------------------------------------
# CLOSE SCAR — investigation successfully completed
# --------------------------------------------------------------------------
from Verified on CloseSCAR
    -> set ClosedAt = now()
    -> set SCARStatus = "Closed"
    -> append SCARLog "SCAR closed — corrective action effective"
    -> transition Closed

from Implemented on CloseSCAR when EffectivenessConfirmed
    -> set VerifiedAt = now()
    -> set ClosedAt = now()
    -> set SCARStatus = "Closed"
    -> append SCARLog "SCAR closed — self-verified"
    -> transition Closed

# --------------------------------------------------------------------------
# REOPEN — from Closed (rare) or from Reopened
# --------------------------------------------------------------------------
from Reopened on Reopen
    -> set SCARStatus = "Investigating"
    -> set InvestigatedAt = now()
    -> append SCARLog "SCAR reopened"
    -> transition Investigating

