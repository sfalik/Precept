precept MedicalPriorAuthorization

# ============================================================================
# PATIENT IDENTIFICATION
# ============================================================================
field PatientId as string notempty maxlength 50
field PatientName as string notempty maxlength 200
field DateOfBirth as date
field Gender as string maxlength 20

# ============================================================================
# SERVICE REQUEST IDENTIFICATION
# ============================================================================
field ServiceRequestId as string notempty maxlength 50
field ProcedureCode as string notempty maxlength 20
field ProcedureDescription as string notempty maxlength 500
field RequestingProviderNpi as string notempty maxlength 10
field RequestDate as instant

# Priority 3 Enhancements: Attending Provider NPI and Place of Service
field AttendingProviderNpi as string optional maxlength 20
field PlaceOfService as string optional maxlength 50

# ============================================================================
# TEMPORAL FIELDS - PRIORITY 1
# ============================================================================
# Service Date - essential for medical necessity determination
field ServiceDate as date

# Authorization Validity Period - prevents expired authorizations
field ValidFrom as date
field ValidUntil as date

# SLA Tracking - ResponseDeadline and UrgencyLevel
field ResponseDeadline as instant
field UrgencyLevel as choice of string("Critical", "Urgent", "Standard", "Routine") ordered default "Standard"

# Service Frequency tracking (Priority 3)
field ServiceFrequency as string optional maxlength 50

# ============================================================================
# DIAGNOSIS INFORMATION
# ============================================================================
field PrimaryDiagnosisCode as string notempty maxlength 7
field SecondaryDiagnosisCodes as set of string
field DiagnosisDescription as string maxlength 500

# ============================================================================
# COVERAGE INFORMATION
# ============================================================================
field CoverageId as string notempty maxlength 50
field PayerName as string notempty maxlength 200
field PlanType as string maxlength 100
field CoverageStartDate as date
field CoverageEndDate as date optional

# ============================================================================
# AUTHORIZATION RESULT
# ============================================================================
field AuthorizationNumber as string optional maxlength 50
field AuthorizationStatus as string maxlength 30
field ApprovedProcedureCodes as set of string
field ApprovedUnits as integer nonnegative default 0
field ApprovedAmount as money in 'USD' default '0.00 USD'
field CoverageLimit as money in 'USD'
field DeductibleRemaining as money in 'USD' default '0.00 USD'
field CoInsurancePercent as decimal default 0

# ============================================================================
# CLINICAL REVIEW INFORMATION
# ============================================================================
field ClinicalNotes as string maxlength 2000
field ClinicalReviewDate as instant optional
field ClinicalReviewer as string optional maxlength 200
field ClinicalDecision as string optional maxlength 50

# ============================================================================
# TIMESTAMPS
# ============================================================================
field SubmittedAt as instant
field ReviewStartedAt as instant optional
field ClinicalReviewStartedAt as instant optional
field PayerReviewStartedAt as instant optional
field DecisionAt as instant optional
field PeerToPeerScheduledAt as instant optional
field PeerToPeerCompletedAt as instant optional
field InformationRequestSentAt as instant optional
field InformationReceivedAt as instant optional

# ============================================================================
# HISTORY AND AUDIT
# ============================================================================
field PriorAuthHistory as log of string
field PriorAuthorizationCount as integer nonnegative default 0
field PreviousAuthorizationNumber as string optional maxlength 50

# ============================================================================
# CASE MANAGEMENT
# ============================================================================
field CaseManager as string optional maxlength 200
field AssignedReviewer as string optional maxlength 200
field EscalationReason as string optional maxlength 1000

# Priority 1: Denial tracking with standardized codes
field DenialReason as string optional maxlength 1000
field DenialCode as choice of string("MN01", "IC01", "NC01", "ST01", "FR01", "ED01", "DU01", "PR01") optional

# ============================================================================
# RULES - BASIC VALIDATION
# ============================================================================
rule PatientId != "" because "Patient identification is required"
rule PatientName != "" because "Patient name is required"
rule ServiceRequestId != "" because "Service request identifier is required"
rule ProcedureCode != "" because "Procedure code (CPT/HCPCS) is required"
rule RequestingProviderNpi != "" because "Requesting provider NPI must be identified"
rule PrimaryDiagnosisCode != "" because "Primary diagnosis code (ICD-10) is required"
rule CoverageId != "" because "Coverage identifier is required"
rule PayerName != "" because "Payer name is required"
rule ApprovedAmount <= CoverageLimit because "Approved amount cannot exceed coverage limit"
rule DeductibleRemaining >= '0.00 USD' because "Deductible remaining cannot be negative"
rule CoInsurancePercent >= 0 and CoInsurancePercent <= 100 because "Co-insurance must be between 0 and 100 percent"
rule PriorAuthorizationCount >= 0 because "Prior authorization count must be non-negative"

# Priority 1 - SLA and Validity Rules
# Note: ServiceDate, ValidFrom, ValidUntil, ResponseDeadline are required fields (not optional)
# so they are guaranteed to be set after construction
rule ValidFrom <= ValidUntil because "ValidFrom must be before or equal to ValidUntil"
rule ServiceDate >= CoverageStartDate because "Service date must occur within coverage period"

# ============================================================================
# RULES - URGENCY-DRIVEN SLA ENFORCEMENT
# ============================================================================
rule ResponseDeadline - RequestDate <= '24 hours' when UrgencyLevel == "Critical" because "Critical prior auths must be responded to within 24 hours"
rule ResponseDeadline - RequestDate <= '72 hours' when UrgencyLevel == "Urgent" because "Urgent prior auths must be responded to within 72 hours"
rule ResponseDeadline - RequestDate <= '7 days' when UrgencyLevel == "Standard" because "Standard prior auths must be responded to within 7 days"
rule ResponseDeadline - RequestDate <= '14 days' when UrgencyLevel == "Routine" because "Routine prior auths must be responded to within 14 days"

# Priority 2 - Duplicate Detection Rule
# This rule checks that no prior authorization exists for the same patient/procedure within the validity period
# Note: Implementation would require historical lookup - documented as a business requirement
# Placeholder: the rule body documents the requirement for external validation systems

# ============================================================================
# STATES
# ============================================================================
state Submitted initial
state UnderReview
state ClinicalReview
state PeerToPeerReview
state InformationRequested
state PayerReview
state Approved
state Denied
state Escalated
state Withdrawn

# ============================================================================
# EVENTS
# ============================================================================
event Submit(
    PatientId as string,
    PatientName as string,
    DateOfBirth as date,
    Gender as string,
    ServiceRequestId as string,
    ProcedureCode as string,
    ProcedureDescription as string,
    RequestingProviderNpi as string,
    PrimaryDiagnosisCode as string,
    SecondaryDiagnosisCodes as set of string,
    CoverageId as string,
    PayerName as string,
    PlanType as string,
    CoverageStartDate as date,
    CoverageEndDate as date optional,
    CoverageLimit as money in 'USD',
    DeductibleRemaining as money in 'USD',
    CoInsurancePercent as decimal,
    RequestDate as instant,
    ServiceDate as date,
    ValidFrom as date,
    ValidUntil as date,
    ResponseDeadline as instant,
    UrgencyLevel as choice of string("Critical", "Urgent", "Standard", "Routine"),
    AttendingProviderNpi as string optional,
    PlaceOfService as string optional,
    ServiceFrequency as string optional) initial
on Submit ensure Submit.PatientId != "" and Submit.PatientName != "" and Submit.CoverageId != "" because "Patient identification and coverage are required"
from any on Submit
    -> set PatientId = Submit.PatientId
    -> set PatientName = Submit.PatientName
    -> set DateOfBirth = Submit.DateOfBirth
    -> set Gender = Submit.Gender
    -> set ServiceRequestId = Submit.ServiceRequestId
    -> set ProcedureCode = Submit.ProcedureCode
    -> set ProcedureDescription = Submit.ProcedureDescription
    -> set RequestingProviderNpi = Submit.RequestingProviderNpi
    -> set PrimaryDiagnosisCode = Submit.PrimaryDiagnosisCode
    -> set SecondaryDiagnosisCodes = Submit.SecondaryDiagnosisCodes
    -> set CoverageId = Submit.CoverageId
    -> set PayerName = Submit.PayerName
    -> set PlanType = Submit.PlanType
    -> set CoverageStartDate = Submit.CoverageStartDate
    -> set CoverageEndDate = Submit.CoverageEndDate
    -> set CoverageLimit = Submit.CoverageLimit
    -> set DeductibleRemaining = Submit.DeductibleRemaining
    -> set CoInsurancePercent = Submit.CoInsurancePercent
    -> set RequestDate = Submit.RequestDate
    -> set ServiceDate = Submit.ServiceDate
    -> set ValidFrom = Submit.ValidFrom
    -> set ValidUntil = Submit.ValidUntil
    -> set ResponseDeadline = Submit.ResponseDeadline
    -> set UrgencyLevel = Submit.UrgencyLevel
    -> set AttendingProviderNpi = Submit.AttendingProviderNpi
    -> set PlaceOfService = Submit.PlaceOfService
    -> set ServiceFrequency = Submit.ServiceFrequency
    -> set DiagnosisDescription = Submit.ProcedureDescription
    -> set ClinicalNotes = "Initial submission received"
    -> set SubmittedAt = now()
    -> set AuthorizationStatus = 'Submitted'
    -> transition Submitted

event StartReview(CaseManager as string)
event StartClinicalReview(Reviewer as string)
event SchedulePeerToPeerReview(PhysicianName as string, ScheduledTime as instant)
event CompletePeerToPeerReview(Outcome as string, Notes as string)
event RequestAdditionalInformation(InformationNeeded as string, Deadline as instant)
event ReceiveAdditionalInformation(InformationReceived as string)
event StartPayerReview
event SubmitClinicalEvidence(ClinicalNotes as string)
event MakeClinicalDecision(Decision as string)
event Approve(ApprovedUnits as integer, ApprovedAmount as money in 'USD')
event Denial(Reason as string, Code as choice of string("MN01", "IC01", "NC01", "ST01", "FR01", "ED01", "DU01", "PR01"))
event Escalate(Reason as string)
event Withdraw

# ============================================================================
# TRANSITIONS
# ============================================================================

# From Submitted
from Submitted on StartReview
    -> set CaseManager = StartReview.CaseManager
    -> set ReviewStartedAt = now()
    -> set AuthorizationStatus = 'Under Review'
    -> transition UnderReview

# From UnderReview
from UnderReview on StartClinicalReview
    -> set ClinicalReviewStartedAt = now()
    -> set AuthorizationStatus = 'Clinical Review'
    -> transition ClinicalReview

from UnderReview on Denial
    -> set DenialReason = Denial.Reason
    -> set DenialCode = Denial.Code
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Denied'
    -> transition Denied

from UnderReview on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From ClinicalReview - with Peer-to-Peer transition (Priority 2)
from ClinicalReview on SubmitClinicalEvidence
    -> set ClinicalNotes = SubmitClinicalEvidence.ClinicalNotes
    -> no transition

from ClinicalReview on MakeClinicalDecision
    -> set ClinicalReviewDate = now()
    -> set ClinicalReviewer = MakeClinicalDecision.Decision
    -> set ClinicalDecision = MakeClinicalDecision.Decision
    -> no transition

from ClinicalReview on SchedulePeerToPeerReview
    -> set PeerToPeerScheduledAt = now()
    -> set AssignedReviewer = SchedulePeerToPeerReview.PhysicianName
    -> set AuthorizationStatus = 'Peer-to-Peer Review Scheduled'
    -> transition PeerToPeerReview

from ClinicalReview on RequestAdditionalInformation
    -> set InformationRequestSentAt = now()
    -> set ClinicalNotes = RequestAdditionalInformation.InformationNeeded
    -> set AuthorizationStatus = 'Information Requested'
    -> transition InformationRequested

from ClinicalReview on StartPayerReview
    -> set PayerReviewStartedAt = now()
    -> set AuthorizationStatus = 'Payer Review'
    -> transition PayerReview

from ClinicalReview on Denial
    -> set DenialReason = Denial.Reason
    -> set DenialCode = Denial.Code
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Denied'
    -> transition Denied

from ClinicalReview on Escalate
    -> set EscalationReason = Escalate.Reason
    -> set AuthorizationStatus = 'Escalated'
    -> transition Escalated

# From PeerToPeerReview (Priority 1 - Peer-to-Peer Review state)
from PeerToPeerReview on CompletePeerToPeerReview
    -> set PeerToPeerCompletedAt = now()
    -> set ClinicalNotes = CompletePeerToPeerReview.Notes
    -> set ClinicalDecision = CompletePeerToPeerReview.Outcome
    -> set AuthorizationStatus = 'Peer-to-Peer Review Complete'
    -> transition ClinicalReview

from PeerToPeerReview on RequestAdditionalInformation
    -> set InformationRequestSentAt = now()
    -> set ClinicalNotes = RequestAdditionalInformation.InformationNeeded
    -> set AuthorizationStatus = 'Information Requested'
    -> transition InformationRequested

from PeerToPeerReview on Denial
    -> set DenialReason = Denial.Reason
    -> set DenialCode = Denial.Code
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Denied'
    -> transition Denied

from PeerToPeerReview on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From InformationRequested (Priority 1 - Information Requested state)
from InformationRequested on ReceiveAdditionalInformation
    -> set InformationReceivedAt = now()
    -> set ClinicalNotes = ReceiveAdditionalInformation.InformationReceived
    -> set AuthorizationStatus = 'Awaiting Clinical Review'
    -> transition ClinicalReview

from InformationRequested on Denial
    -> set DenialReason = Denial.Reason
    -> set DenialCode = Denial.Code
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Denied'
    -> transition Denied

from InformationRequested on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From PayerReview
from PayerReview on Approve
    -> set AuthorizationNumber = 'PA-00001'
    -> add ApprovedProcedureCodes ProcedureCode
    -> set ApprovedUnits = Approve.ApprovedUnits
    -> set ApprovedAmount = Approve.ApprovedAmount
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Approved'
    -> transition Approved

from PayerReview on Denial
    -> set DenialReason = Denial.Reason
    -> set DenialCode = Denial.Code
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Denied'
    -> transition Denied

from PayerReview on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From Escalated
from Escalated on Denial
    -> set DenialReason = "Escalated request denied"
    -> set DenialCode = "PR01"
    -> set DecisionAt = now()
    -> set AuthorizationStatus = 'Denied'
    -> transition Denied

from Escalated on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From Submitted - Withdraw
from Submitted on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From UnderReview - Withdraw
from UnderReview on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# From PayerReview - Withdraw
from PayerReview on Withdraw
    -> set AuthorizationStatus = 'Withdrawn'
    -> transition Withdrawn

# ============================================================================
# DENIAL CODES REFERENCE
# ============================================================================
# Standardized Denial Codes (Priority 2):
# MN01 - Medical Necessity - Not Medically Necessary
# IC01 - Information Complete - Incomplete Information
# NC01 - Coverage - Not Covered
# ST01 - Statistical - Duplicate/Statistical Issue
# FR01 - Fraudulent - Suspected Fraud
# ED01 - Eligibility - Patient Not Eligible
# DU01 - Documentation - Insufficient Documentation
# PR01 - Provider - Provider Related Issue

