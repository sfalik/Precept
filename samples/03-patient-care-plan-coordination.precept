precept PatientCarePlan

# FHIR-aligned care plan coordination with goal tracking, task assignment, and progress monitoring
# Demonstrates: multi-stage workflow, temporal tracking, goal progression, milestone reviews
# FHIR Resources: CarePlan, Goal, Task, Condition
# Research: type-system-domain-survey.md, sample-temporal-pattern-catalog.md

# ============================================================================
# PATIENT INFORMATION
# ============================================================================
field PatientId as string notempty maxlength 50
field PatientName as string notempty maxlength 200
field DateOfBirth as date
field Gender as string maxlength 20

# ============================================================================
# CARE PLAN IDENTIFICATION
# ============================================================================
field CarePlanId as string notempty maxlength 50
field CarePlanTitle as string notempty maxlength 200
field CarePlanDescription as string maxlength 1000
field CreatedDate as date default '2024-01-01'
field CreatedBy as string optional maxlength 200
field LastModifiedAt as instant optional

# ============================================================================
# CARE TEAM MEMBERS
# ============================================================================
field PrimaryCareProvider as string notempty maxlength 200
field AssignedNurses as set of string
field SpecialistConsultants as set of string
field CareCoordinators as set of string optional

# ============================================================================
# CARE PLAN GOALS
# ============================================================================
field CarePlanGoals as set of string
field GoalStartDate as date
field GoalEndDate as date optional
field GoalStatus as choice of string("Active", "Completed", "OnHold", "Modified") ordered default "Active"
field GoalProgressPercent as integer nonnegative default 0 max 100

# ============================================================================
# PROGRESS TRACKING
# ============================================================================
field ProgressNotes as log of string
field LastProgressUpdate as instant optional
field NextScheduledReview as date optional
field ReviewFrequencyDays as duration default '14 days'

# ============================================================================
# CARE PLAN STATUS
# ============================================================================
field CarePlanStatus as choice of string("Draft", "Active", "InProgress", "MilestoneReview", "Completed", "Discontinued") ordered default "Draft"
field CarePlanReason as string optional maxlength 500

# ============================================================================
# RULES - BASIC VALIDATION
# ============================================================================
rule PatientId != "" because "Patient identification is required"
rule PatientName != "" because "Patient name is required"
rule CarePlanId != "" because "Care plan identifier is required"
rule CarePlanTitle != "" because "Care plan title is required"
rule PrimaryCareProvider != "" because "Primary care provider must be identified"
rule GoalStartDate >= CreatedDate because "Goal start date must be on or after care plan creation"

# ============================================================================
# STATES
# ============================================================================
state New initial
state Draft
state Active
state InProgress
state MilestoneReview
state Completed terminal
state Discontinued terminal

# ============================================================================
# EVENTS
# ============================================================================
event CreateCarePlan(
    PatientId as string,
    PatientName as string,
    DateOfBirth as date,
    Gender as string,
    CarePlanId as string,
    CarePlanTitle as string,
    CarePlanDescription as string,
    PrimaryCareProvider as string,
    GoalStartDate as date,
    CreatedBy as string) initial
on CreateCarePlan ensure PatientId != "" and PatientName != "" and CarePlanId != ""

from New on CreateCarePlan
    -> set PatientId = CreateCarePlan.PatientId
    -> set PatientName = CreateCarePlan.PatientName
    -> set DateOfBirth = CreateCarePlan.DateOfBirth
    -> set Gender = CreateCarePlan.Gender
    -> set CarePlanId = CreateCarePlan.CarePlanId
    -> set CarePlanTitle = CreateCarePlan.CarePlanTitle
    -> set CarePlanDescription = CreateCarePlan.CarePlanDescription
    -> set PrimaryCareProvider = CreateCarePlan.PrimaryCareProvider
    -> set GoalStartDate = CreateCarePlan.GoalStartDate
    -> set CarePlanStatus = 'Draft'
    -> transition Draft

event AddGoal(Goal as string notempty)
event AddCareTeamMember(MemberType as choice of string("Nurse", "Specialist", "Coordinator"), MemberName as string notempty)
event ActivateCarePlan
event UpdateProgress(Notes as string notempty, ProgressPercent as integer nonnegative max 100)
event RequestMilestoneReview
event CompleteMilestone(MilestoneOutcome as string, GoalAchieved as boolean)
event ReviewCarePlan(ClinicalNotes as string optional)
event MarkAsCompleted(CompletionNotes as string optional)
event DiscontinueCarePlan(Reason as string notempty)
event BeginExecution

# ============================================================================
# TRANSITIONS
# ============================================================================

# From Draft
from Draft on ActivateCarePlan
    -> set CarePlanStatus = 'Active'
    -> set LastModifiedAt = now()
    -> transition Active

from Draft on DiscontinueCarePlan
    -> set CarePlanStatus = 'Discontinued'
    -> set CarePlanReason = DiscontinueCarePlan.Reason
    -> set LastModifiedAt = now()
    -> transition Discontinued

# From Active
from Active on AddGoal
    -> add CarePlanGoals Goal
    -> no transition

from Active on AddCareTeamMember when MemberType == 'Nurse'
    -> add AssignedNurses MemberName
    -> no transition
from Active on AddCareTeamMember when MemberType == 'Specialist'
    -> add SpecialistConsultants MemberName
    -> no transition
from Active on AddCareTeamMember when MemberType == 'Coordinator'
    -> add CareCoordinators MemberName
    -> no transition

from Active on UpdateProgress
    -> set GoalProgressPercent = UpdateProgress.ProgressPercent
    -> add ProgressNotes UpdateProgress.Notes
    -> set LastProgressUpdate = now()
    -> no transition

from Active on RequestMilestoneReview
    -> set CarePlanStatus = 'MilestoneReview'
    -> set LastModifiedAt = now()
    -> transition MilestoneReview

from Active on DiscontinueCarePlan
    -> set CarePlanStatus = 'Discontinued'
    -> set CarePlanReason = DiscontinueCarePlan.Reason
    -> set LastModifiedAt = now()
    -> transition Discontinued

from Active on BeginExecution
    -> set CarePlanStatus = 'InProgress'
    -> set LastModifiedAt = now()
    -> transition InProgress

# From InProgress
from InProgress on ReviewCarePlan
    -> add ProgressNotes ClinicalNotes
    -> set LastProgressUpdate = now()
    -> set CarePlanStatus = 'Active'
    -> set LastModifiedAt = now()
    -> transition Active

from InProgress on MarkAsCompleted
    -> add ProgressNotes CompletionNotes
    -> set CarePlanStatus = 'Completed'
    -> set LastModifiedAt = now()
    -> set GoalStatus = 'Completed'
    -> transition Completed

from InProgress on DiscontinueCarePlan
    -> set CarePlanStatus = 'Discontinued'
    -> set CarePlanReason = DiscontinueCarePlan.Reason
    -> set LastModifiedAt = now()
    -> transition Discontinued

# From MilestoneReview
from MilestoneReview on CompleteMilestone when GoalAchieved == true
    -> set GoalProgressPercent = min(GoalProgressPercent + 25, 100)
    -> set GoalStatus = 'Completed'
    -> add ProgressNotes "Milestone achieved successfully"
    -> set CarePlanStatus = 'Active'
    -> set LastModifiedAt = now()
    -> transition Active
from MilestoneReview on CompleteMilestone when GoalAchieved == false
    -> set GoalStatus = 'Modified'
    -> add ProgressNotes "Milestone review failed"
    -> set CarePlanStatus = 'MilestoneReview'
    -> set LastModifiedAt = now()
    -> no transition

from MilestoneReview on ReviewCarePlan
    -> add ProgressNotes ClinicalNotes
    -> set LastProgressUpdate = now()
    -> set CarePlanStatus = 'Active'
    -> set LastModifiedAt = now()
    -> transition Active

from MilestoneReview on DiscontinueCarePlan
    -> set CarePlanStatus = 'Discontinued'
    -> set CarePlanReason = DiscontinueCarePlan.Reason
    -> set LastModifiedAt = now()
    -> transition Discontinued
