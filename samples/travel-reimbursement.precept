precept TravelReimbursement

# Pattern B: Draft is a genuine enrichment phase — the employee fills in trip details
# progressively. Finance reviews by checking totals and policy ratios.
# Built-in functions (min) keep arithmetic readable.
# RequestedTotal is a computed field — always equal to the sum of its components.

field EmployeeName as string optional
field TripDays as decimal default 1 positive
field LodgingTotal as decimal default 0 nonnegative
field MealsTotal as decimal default 0 nonnegative
field MileageTotal as decimal default 0 nonnegative maxplaces 2
field MileageRate as number default 0.67 nonnegative
field RequestedTotal as number nonnegative <- LodgingTotal + MealsTotal + MileageTotal
field ApprovedTotal as number default 0 nonnegative
field FinanceNote as string optional
rule ApprovedTotal <= RequestedTotal because "Approved total {ApprovedTotal} exceeds the submitted request of {RequestedTotal}"

state Draft initial
state Submitted
state Approved
state Paid terminal
state Rejected terminal

in Draft modify EmployeeName, TripDays, LodgingTotal, MealsTotal, MileageTotal, MileageRate editable

in Paid ensure ApprovedTotal > 0 because "Paid reimbursements must have an approved amount"

event Submit
event Approve(Amount as number, Note as string optional)
on Approve ensure Approve.Amount > 0 because "Approved amounts must be positive"

event Reject(Note as string notempty)
event Pay

# Average lodging per day is checked with division to keep the example realistic.
from Draft on Submit when EmployeeName is set and LodgingTotal / TripDays <= 350
    -> transition Submitted
from Draft on Submit when EmployeeName is set
    -> reject "Average lodging of {LodgingTotal / TripDays} per day exceeds the $350 policy cap"
from Draft on Submit
    -> reject "Employee name is required before submission"

from Submitted on Approve when Approve.Amount <= RequestedTotal
    -> set ApprovedTotal = min(Approve.Amount, RequestedTotal)
    -> set FinanceNote = Approve.Note
    -> transition Approved
from Submitted on Approve
    -> reject "Cannot approve {Approve.Amount} — the submitted total is only {RequestedTotal}"
from Submitted on Reject
    -> set FinanceNote = Reject.Note
    -> transition Rejected

from Approved on Pay
    -> transition Paid
