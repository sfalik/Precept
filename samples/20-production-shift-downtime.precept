precept ProductionShiftDowntime

# Manufacturing shift-based downtime tracking

field EquipmentId as string notempty
field ShiftNumber as string notempty
field ShiftDate as date
field PlannedOutput as integer default 0 nonnegative
field RatedThroughput as integer default 0 nonnegative
field DowntimeReason as choice of string("MachineFailure", "Maintenance", "PowerOutage", "MaterialShortage", "QualityHold", "Other") default "Other"
field CurrentDowntimeReason as choice of string("MachineFailure", "Maintenance", "PowerOutage", "MaterialShortage", "QualityHold", "Other") optional
field CurrentDowntime as duration default '0 hours'
field TotalDowntimeToday as duration default '0 hours'
field LastDowntimeStart as instant optional
field LastDowntimeEnd as instant optional
field ProducedQuantity as integer default 0 nonnegative
field ScrapQuantity as integer default 0 nonnegative
field AvailabilityPercent as decimal default 100.0 nonnegative max 100
field PerformancePercent as decimal default 100.0 nonnegative max 100
field QualityPercent as decimal default 100.0 nonnegative max 100
field MaintenanceNotes as string optional
field ShiftStartedAt as instant optional
field ShiftClosedAt as instant optional
field DowntimeLog as log of string
field DowntimeEvents as lookup of string to integer
field ShiftStatus as choice of string("Created", "Active", "Closed") default "Created"

rule AvailabilityPercent >= 0.0 and AvailabilityPercent <= 100.0 because "Availability must be 0-100%"
rule PerformancePercent >= 0.0 and PerformancePercent <= 100.0 because "Performance must be 0-100%"
rule QualityPercent >= 0.0 and QualityPercent <= 100.0 because "Quality must be 0-100%"
rule ProducedQuantity >= ScrapQuantity because "Produced >= scrap"

state Created initial
state Active
state Closed terminal

on Create ensure Create.ShiftNumber != "" and Create.PlannedOutput > 0 and Create.RatedThroughput > 0 because "Required fields"

event Create(EquipmentId as string notempty, ShiftNumber as string notempty, ShiftDate as date, PlannedOutput as integer, RatedThroughput as integer) initial
event ReportDowntime(Reason as string)
event CompleteDowntime
event StartProduction
event ProduceBatch(Quantity as integer)
event CloseShift

from Created on Create -> set EquipmentId = Create.EquipmentId -> set ShiftNumber = Create.ShiftNumber -> set ShiftDate = Create.ShiftDate -> set PlannedOutput = Create.PlannedOutput -> set RatedThroughput = Create.RatedThroughput -> set ShiftStatus = "Created" -> set DowntimeReason = "Other" -> set CurrentDowntimeReason = "Other" -> set TotalDowntimeToday = '0 hours' -> set ProducedQuantity = 0 -> set ScrapQuantity = 0 -> set AvailabilityPercent = 100.0 -> set PerformancePercent = 100.0 -> set QualityPercent = 100.0 -> transition Created
from Active on ReportDowntime when CurrentDowntimeReason is not set -> reject "No active downtime"
from Active on ReportDowntime -> set DowntimeReason = "Other" -> set CurrentDowntimeReason = "Other" -> set CurrentDowntime = '0 hours' -> set LastDowntimeStart = now() -> put DowntimeEvents "FailureCount" = 1 -> append DowntimeLog "Downtime reported" -> transition Active
from Active on CompleteDowntime when CurrentDowntimeReason is not set -> reject "No active downtime to complete"
from Active on CompleteDowntime -> set LastDowntimeEnd = now() -> set CurrentDowntime = '1 hours' -> set TotalDowntimeToday = TotalDowntimeToday + CurrentDowntime -> set CurrentDowntimeReason = "Other" -> append DowntimeLog "Downtime completed" -> transition Active
from Created on StartProduction -> set ShiftStartedAt = now() -> set ShiftStatus = "Active" -> append DowntimeLog "Production started" -> transition Active
from Active on ProduceBatch when ProduceBatch.Quantity <= 0 -> reject "Quantity must be positive"
from Active on ProduceBatch -> set ProducedQuantity = ProducedQuantity + ProduceBatch.Quantity -> append DowntimeLog "Batch produced" -> transition Active
from Active on CloseShift -> set ShiftClosedAt = now() -> set ShiftStatus = "Closed" -> transition Closed

in Active ensure ShiftStartedAt is set because "Active shift needs start time"
in Closed ensure ShiftClosedAt is set because "Closed shift needs close time"
