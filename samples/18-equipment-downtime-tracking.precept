precept EquipmentDowntimeTracking

# ============================================================================
# DOMAIN: Manufacturing — Equipment Downtime Tracking
# ============================================================================
# Demonstrates: downtime logging, reason codes, availability calculation,
# maintenance impact tracking, choice-typed reason categories, and temporal
# calculations for duration arithmetic.
#
# Lifecycle: Running → Down → Diagnosing → Repairing → Restored
#
# Collection types demonstrated:
#   - lookup  (DowntimeEvents) — key-value map of event type to count
#   - log     (DowntimeLog) — append-only audit trail
# ============================================================================

# ============================================================================
# EQUIPMENT IDENTITY
# ============================================================================
field EquipmentId as string
field EquipmentName as string optional
field EquipmentType as choice of string("CNC","Laser","Assembly","Packaging","Conveyor","Other")
field Location as string optional
field InstalledDate as date optional

# ============================================================================
# DOWNTIME CATEGORIES
# Demonstrates: choice-typed reason codes for categorization.
# ============================================================================
field DowntimeReason as choice of string(
    "PlannedMaintenance","UnplannedFailure","Changeover","MaterialShortage",
    "QualityIssue","ToolFailure","PowerOutage","Other")
field DowntimeCategory as choice of string("Availability","Performance","Quality","Other")

# ============================================================================
# TIMING — downtime tracking
# Demonstrates: instant for start/end timestamps.
# ============================================================================
field DowntimeStartedAt as instant optional
field DowntimeEndedAt as instant optional
field DiagnosisStartedAt as instant optional
field RepairStartedAt as instant optional
field RestoredAt as instant optional

# ============================================================================
# IMPACT TRACKING
# ============================================================================
field AffectedOrders as string optional
field EstimatedImpact as string optional
field ReworkRequired as boolean default false
field ScrapQuantity as integer default 0 nonnegative

# ============================================================================
# REPAIR DATA
# ============================================================================
field AssignedTechnician as string optional
field RepairDescription as string optional
field PartsUsed as string optional
field RepairCost as decimal default 0.0 nonnegative
field MeanTimeToRepair as integer optional

# ============================================================================
# AVAILABILITY METRICS
# Demonstrates: computed metrics for OEE (Overall Equipment Effectiveness).
# ============================================================================
field TotalRunTime as duration default '0 hours'
field TotalDowntime as duration default '0 hours'
field PlannedProductionTime as duration default '0 hours'
field AvailabilityPercent as number default 100.0 nonnegative
field CurrentStatus as choice of string("Running","Down","Diagnosing","Repairing","Restored") default "Running"

# ============================================================================
# DOWNTIME LOG — append-only audit trail
# ============================================================================
field DowntimeLog as log of string

# ============================================================================
# DOWNTIME EVENTS — key-value map of event type to count
# ============================================================================
field DowntimeEvents as lookup of string to integer

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule AvailabilityPercent >= 0 and AvailabilityPercent <= 100
    because "Availability percentage must be between 0% and 100%"

rule ScrapQuantity >= 0
    because "Scrap quantity must be non-negative"

# ============================================================================
# STATES — 5 total lifecycle positions
# ============================================================================
state Running initial
state Down
state Diagnosing
state Repairing
state Restored

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.EquipmentId != ""
    because "Equipment ID is required for tracking"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    EquipmentId as string notempty,
    EquipmentName as string optional,
    EquipmentType as choice of string("CNC","Laser","Assembly","Packaging","Conveyor","Other"),
    Location as string optional,
    InstalledDate as date optional) initial

event ReportDowntime(
    Reason as choice of string("PlannedMaintenance","UnplannedFailure","Changeover",
        "MaterialShortage","QualityIssue","ToolFailure","PowerOutage","Other"),
    Category as choice of string("Availability","Performance","Quality","Other"),
    Impact as string optional)

event StartDiagnosis
event CompleteDiagnosis(FailureRootCause as string notempty)
event StartRepair
event CompleteRepair(Description as string notempty, PartsUsed as string optional, Cost as decimal)
event RestoreEquipment
event LogRework(Quantity as integer)
event UpdateMetrics(
    TotalRunTime as duration,
    TotalDowntime as duration,
    PlannedProductionTime as duration)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Down ensure DowntimeStartedAt is set
    because "Down state requires downtime start timestamp"

in Diagnosing ensure DiagnosisStartedAt is set
    because "Diagnosing state requires diagnosis start timestamp"

in Repairing ensure RepairStartedAt is set
    because "Repairing state requires repair start timestamp"

in Restored ensure RestoredAt is set
    because "Restored state requires restoration timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — Running state setup
# --------------------------------------------------------------------------
from Running on Create
    -> set EquipmentId = Create.EquipmentId
    -> set EquipmentName = Create.EquipmentName
    -> set EquipmentType = Create.EquipmentType
    -> set Location = Create.Location
    -> set InstalledDate = Create.InstalledDate
    -> set CurrentStatus = "Running"
    -> set DowntimeReason = "Other"
    -> set DowntimeCategory = "Other"
    -> set ReworkRequired = false
    -> set ScrapQuantity = 0
    -> set TotalRunTime = '0 hours'
    -> set TotalDowntime = '0 hours'
    -> set PlannedProductionTime = '0 hours'
    -> set AvailabilityPercent = 100.0
    -> transition Running

# --------------------------------------------------------------------------
# REPORT DOWNTIME — Running → Down
# --------------------------------------------------------------------------
from Running on ReportDowntime
    -> set DowntimeReason = ReportDowntime.Reason
    -> set DowntimeCategory = ReportDowntime.Category
    -> set EstimatedImpact = ReportDowntime.Impact
    -> set DowntimeStartedAt = now()
    -> put DowntimeEvents "FailureCount" = 1
    -> set RepairCost = 0.0
    -> append DowntimeLog "Downtime reported"
    -> transition Down

# --------------------------------------------------------------------------
# START DIAGNOSIS — Down → Diagnosing
# --------------------------------------------------------------------------
from Down on StartDiagnosis
    -> set DiagnosisStartedAt = now()
    -> set CurrentStatus = "Diagnosing"
    -> append DowntimeLog "Diagnosis started"
    -> transition Diagnosing

# --------------------------------------------------------------------------
# COMPLETE DIAGNOSIS — identify root cause
# --------------------------------------------------------------------------
from Diagnosing on CompleteDiagnosis
    -> set RepairDescription = CompleteDiagnosis.FailureRootCause
    -> set RepairStartedAt = now()
    -> set CurrentStatus = "Repairing"
    -> append DowntimeLog "Diagnosis complete — failure identified"
    -> transition Repairing

# --------------------------------------------------------------------------
# START REPAIR — Diagnosing → Repairing
# --------------------------------------------------------------------------
from Diagnosing on StartRepair
    -> set RepairStartedAt = now()
    -> set CurrentStatus = "Repairing"
    -> append DowntimeLog "Repair started"
    -> transition Repairing

# --------------------------------------------------------------------------
# COMPLETE REPAIR — fix equipment
# --------------------------------------------------------------------------
from Repairing on CompleteRepair
    -> set RepairDescription = CompleteRepair.Description
    -> set PartsUsed = CompleteRepair.PartsUsed
    -> set RepairCost = CompleteRepair.Cost
    -> set RestoredAt = now()
    -> set CurrentStatus = "Restored"
    -> append DowntimeLog "Repair completed"
    -> transition Restored

# --------------------------------------------------------------------------
# RESTORE EQUIPMENT — back to Running
# --------------------------------------------------------------------------
from Restored on RestoreEquipment
    -> set RestoredAt = now()
    -> set CurrentStatus = "Running"
    -> append DowntimeLog "Equipment restored to running"
    -> transition Running

# --------------------------------------------------------------------------
# LOG REWORK — track quality impact
# --------------------------------------------------------------------------
from Down on LogRework when LogRework.Quantity <= 0
    -> reject "Rework quantity must be positive"
from Down on LogRework
    -> set ReworkRequired = true
    -> set ScrapQuantity = LogRework.Quantity
    -> append DowntimeLog "Rework logged"
    -> no transition

# --------------------------------------------------------------------------
# UPDATE METRICS — recalculate availability
# Demonstrates: duration types and availability calculation.
# Note: proof engine does not propagate guards through arithmetic.
# Store 0.0; external computation used for actual percentage.
# --------------------------------------------------------------------------
from Running on UpdateMetrics
    -> set TotalRunTime = UpdateMetrics.TotalRunTime
    -> set TotalDowntime = UpdateMetrics.TotalDowntime
    -> set PlannedProductionTime = UpdateMetrics.PlannedProductionTime
    -> set AvailabilityPercent = 0.0
    -> append DowntimeLog "Metrics updated"
    -> no transition