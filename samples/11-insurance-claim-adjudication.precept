precept InsuranceClaimAdjudication

# ============================================================================
# DOMAIN: Insurance — Claim Adjudication (ACORD-aligned)
# ============================================================================
# Demonstrates: multi-stage claim lifecycle, lookup types for coverage details
# and subrogation tracking, log for audit trail, choice-typed loss types,
# money types for amounts, conditional routing based on amount thresholds,
# duration arithmetic for SLA tracking, and terminal states.
#
# Lifecycle: Filed → Under Review → Investigation → Adjudication →
#   Payment Processing → Paid (terminal) | Denied (terminal)
#
# Collection types demonstrated:
#   - lookup  (CoverageDetails, AdditionalContacts) — key-value maps
#   - log     (ClaimLog) — append-only audit trail
# ============================================================================

# ============================================================================
# CLAIM IDENTITY & POLICY DATA
# ============================================================================
field ClaimNumber as string
field PolicyNumber as string
field PolicyHolderName as string
field IncidentDate as date
field IncidentLocation as string optional
field ClaimType as choice of string("Property","Liability","Auto","WorkersComp","Medical")

# ============================================================================
# FINANCIAL AMOUNTS — money types with currency
# ============================================================================
field LossAmount as money in 'USD'
field Deductible as money in 'USD'
field Reserves as money in 'USD' default '0.00 USD'
field PaymentAmount as money in 'USD' default '0.00 USD'
field SubrogationRecovery as money in 'USD' default '0.00 USD'

# ============================================================================
# COVERAGE DETAILS — per-coverage limits (lookup of code to decimal amount)
# Note: lookup values use decimal because money in 'USD' conflicts with
# the parser's state-scope disambiguation keyword 'in'. Currency is tracked
# at the entity level (LossAmount uses money in 'USD').
# ============================================================================
field CoverageDetails as lookup of string to decimal

# ============================================================================
# SUBROGATION TRACKING
# ============================================================================
field HasSubrogationPotential as boolean default false
field AtFaultParty as string optional
field SubrogationDetails as lookup of string to string optional

# ============================================================================
# AUDIT TRAIL — append-only log
# ============================================================================
field ClaimLog as log of string

# ============================================================================
# ADDITIONAL CONTACTS — adjuster, witness, medical provider keyed by role
# ============================================================================
field AdditionalContacts as lookup of string to string optional

# ============================================================================
# TIMESTAMPS
# ============================================================================
field FiledAt as instant
field ReviewedAt as instant optional
field InvestigatedAt as instant optional
field AdjudicatedAt as instant optional
field PaidAt as instant optional
field DeniedAt as instant optional

# ============================================================================
# NOTES & REASONS
# ============================================================================
field ClaimDescription as string optional
field AdjustmentNotes as string optional
field DenialReason as string optional
field PaymentMethod as choice of string("Check","Wire","ACH","DirectDeposit") optional

# ============================================================================
# SLA TRACKING — duration for handling time limits
# ============================================================================
field ReviewSLA as duration default '30 days'
field TargetCompletion as instant optional

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule PaymentAmount.amount <= LossAmount.amount
    because "Total payments must not exceed loss amount"

rule Reserves.amount >= LossAmount.amount
    because "Reserves must cover the estimated loss amount"

rule Deductible.amount <= LossAmount.amount
    because "Deductible must not exceed the loss amount"

# ============================================================================
# STATES — 7 total lifecycle positions
# ============================================================================
state Filed initial
state UnderReview
state Investigation
state Adjudication
state PaymentProcessing
state Paid terminal
state Denied terminal

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.ClaimNumber != ""
    because "Claim number is required for claim filing"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    ClaimNumber as string notempty,
    PolicyNumber as string notempty,
    PolicyHolderName as string notempty,
    IncidentDate as date,
    IncidentLocation as string optional,
    ClaimType as choice of string("Property","Liability","Auto","WorkersComp","Medical"),
    LossAmount as money in 'USD',
    Deductible as money in 'USD') initial

event SetDescription(Description as string notempty)
event AssignAdjuster(AdjusterName as string notempty)

event BeginReview
event RequestAdditionalInfo(RequestedInfo as string notempty, Deadline as duration)

event BeginInvestigation
event SubmitInvestigationReport(
    ReportSummary as string notempty,
    HasSubrogation as boolean,
    AtFaultParty as string optional)

event DetermineCoverage(CoverageCode as string notempty, CoverageLimit as money in 'USD')
event CalculateSettlement(ApprovedAmount as money in 'USD')

event ApprovePayment(PaymentMethod as choice of string("Check","Wire","ACH","DirectDeposit"))
event ProcessPayment
event RecordSubrogationRecovery(RecoveryAmount as money in 'USD')

event DenyClaim(Reason as string notempty)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in UnderReview ensure ReviewedAt is set
    because "Under-review claims must have a review timestamp"

in Investigation ensure InvestigatedAt is set
    because "Investigated claims must have an investigation timestamp"

in Adjudication ensure AdjudicatedAt is set
    because "Adjudicated claims must have an adjudication timestamp"

in PaymentProcessing ensure PaymentAmount.amount > 0
    because "Payment processing claims must have a payment amount"

in Paid ensure PaidAt is set
    because "Paid claims must have a payment timestamp"

in Denied ensure DeniedAt is set
    because "Denied claims must have a denial timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — Filed state setup
# --------------------------------------------------------------------------
from Filed on Create
    -> set ClaimNumber = Create.ClaimNumber
    -> set PolicyNumber = Create.PolicyNumber
    -> set PolicyHolderName = Create.PolicyHolderName
    -> set IncidentDate = Create.IncidentDate
    -> set IncidentLocation = Create.IncidentLocation
    -> set ClaimType = Create.ClaimType
    -> set LossAmount = Create.LossAmount
    -> set Deductible = Create.Deductible
    -> set FiledAt = now()
    -> transition Filed

# --------------------------------------------------------------------------
# SET DESCRIPTION — update claim details
# --------------------------------------------------------------------------
from Filed on SetDescription
    -> set ClaimDescription = SetDescription.Description
    -> append ClaimLog "Claim description set"
    -> no transition

# --------------------------------------------------------------------------
# ASSIGN ADJUSTER — add adjuster contact
# --------------------------------------------------------------------------
from Filed on AssignAdjuster
    -> put AdditionalContacts "Adjuster" = AssignAdjuster.AdjusterName
    -> append ClaimLog "Adjuster assigned"
    -> no transition

# --------------------------------------------------------------------------
# BEGIN REVIEW — Filed → UnderReview
# --------------------------------------------------------------------------
from Filed on BeginReview
    -> set ReviewedAt = now()
    -> set TargetCompletion = now() + ReviewSLA
    -> append ClaimLog "Review begun"
    -> transition UnderReview

# --------------------------------------------------------------------------
# REQUEST INFO — stay in UnderReview
# --------------------------------------------------------------------------
from UnderReview on RequestAdditionalInfo
    -> set TargetCompletion = now() + RequestAdditionalInfo.Deadline
    -> append ClaimLog "Additional info requested"
    -> no transition

# --------------------------------------------------------------------------
# BEGIN INVESTIGATION — UnderReview → Investigation
# --------------------------------------------------------------------------
from UnderReview on BeginInvestigation
    -> set InvestigatedAt = now()
    -> append ClaimLog "Investigation begun"
    -> transition Investigation

# --------------------------------------------------------------------------
# INVESTIGATION REPORT — with subrogation detection (HasSubrogation=true)
# More specific guard first: subrogation detected with known party.
# --------------------------------------------------------------------------
from Investigation on SubmitInvestigationReport when SubmitInvestigationReport.HasSubrogation
    -> set AdjustmentNotes = SubmitInvestigationReport.ReportSummary
    -> set HasSubrogationPotential = SubmitInvestigationReport.HasSubrogation
    -> set AtFaultParty = SubmitInvestigationReport.AtFaultParty
    -> put SubrogationDetails "Party" = SubmitInvestigationReport.AtFaultParty
    -> append ClaimLog "Investigation report submitted — subrogation detected"
    -> transition Adjudication

# --------------------------------------------------------------------------
# INVESTIGATION REPORT — no subrogation detected
# General guard catches all other cases (HasSubrogation=false).
# --------------------------------------------------------------------------
from Investigation on SubmitInvestigationReport
    -> set AdjustmentNotes = SubmitInvestigationReport.ReportSummary
    -> set HasSubrogationPotential = SubmitInvestigationReport.HasSubrogation
    -> clear AtFaultParty
    -> clear SubrogationDetails
    -> append ClaimLog "Investigation report submitted — no subrogation"
    -> transition Adjudication

# --------------------------------------------------------------------------
# DETERMINE COVERAGE — add coverage limit
# --------------------------------------------------------------------------
from Adjudication on DetermineCoverage
    -> put CoverageDetails DetermineCoverage.CoverageCode = DetermineCoverage.CoverageLimit
    -> set Reserves = LossAmount
    -> append ClaimLog "Coverage determined"
    -> no transition

# --------------------------------------------------------------------------
# CALCULATE SETTLEMENT — compute payment amount
# --------------------------------------------------------------------------
from Adjudication on CalculateSettlement when CalculateSettlement.ApprovedAmount.amount <= 0
    -> reject "Approved amount must be positive"
from Adjudication on CalculateSettlement
    -> set PaymentAmount = CalculateSettlement.ApprovedAmount
    -> set PaymentMethod = "Check"
    -> append ClaimLog "Settlement calculated"
    -> transition PaymentProcessing

# --------------------------------------------------------------------------
# APPROVE PAYMENT — confirm payment method
# --------------------------------------------------------------------------
from PaymentProcessing on ApprovePayment
    -> set PaymentMethod = ApprovePayment.PaymentMethod
    -> append ClaimLog "Payment method approved"
    -> no transition

# --------------------------------------------------------------------------
# PROCESS PAYMENT — PaymentProcessing → Paid
# --------------------------------------------------------------------------
from PaymentProcessing on ProcessPayment when PaymentAmount.amount <= 0
    -> reject "No payment amount to process"
from PaymentProcessing on ProcessPayment
    -> set PaidAt = now()
    -> append ClaimLog "Payment processed"
    -> transition Paid

# --------------------------------------------------------------------------
# SUBROGATION RECOVERY — update recovery amount
# --------------------------------------------------------------------------
from PaymentProcessing on RecordSubrogationRecovery
    -> set SubrogationRecovery = SubrogationRecovery + RecordSubrogationRecovery.RecoveryAmount
    -> append ClaimLog "Subrogation recovery recorded"
    -> no transition

# --------------------------------------------------------------------------
# DENY CLAIM — from multiple states
# --------------------------------------------------------------------------
from Filed on DenyClaim
    -> set DenialReason = DenyClaim.Reason
    -> set DeniedAt = now()
    -> append ClaimLog "Claim denied"
    -> transition Denied

from UnderReview on DenyClaim
    -> set DenialReason = DenyClaim.Reason
    -> set DeniedAt = now()
    -> append ClaimLog "Claim denied during review"
    -> transition Denied

from Investigation on DenyClaim
    -> set DenialReason = DenyClaim.Reason
    -> set DeniedAt = now()
    -> append ClaimLog "Claim denied during investigation"
    -> transition Denied

from Adjudication on DenyClaim
    -> set DenialReason = DenyClaim.Reason
    -> set DeniedAt = now()
    -> append ClaimLog "Claim denied during adjudication"
    -> transition Denied
