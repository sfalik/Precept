precept InsuranceUnderwriting

# ============================================================================
# DOMAIN: Insurance — Underwriting (ACORD-aligned)
# ============================================================================
# Demonstrates: multi-stage underwriting workflow, numeric risk scoring,
# conditional routing based on risk category, choice-typed decisions,
# lookup for risk factors, log for audit trail, and premium rating.
#
# Lifecycle: Received → Information Gathering → Risk Assessment →
#   Quote Generated → Approved/Declined/Modified
#
# Collection types demonstrated:
#   - lookup  (RiskFactors) — key-value map of scored risk factors
#   - log     (UnderwritingLog) — append-only audit trail
# ============================================================================

# ============================================================================
# APPLICATION IDENTITY
# ============================================================================
field ApplicationNumber as string
field ApplicantName as string
field ApplicantDateOfBirth as date
field ApplicantGender as string optional
field Occupation as string optional
field AnnualIncome as decimal default 0.0 nonnegative

# ============================================================================
# POLICY REQUEST
# ============================================================================
field PolicyType as choice of string("Life","Health","Disability","Annuity","LongTermCare")
field CoverageAmount as money in 'USD'
field PremiumRating as choice of string("Standard","Preferred","PreferredPlus","SuperPreferred","TableRating")
field PolicyTerm as integer default 0 nonnegative

# ============================================================================
# RISK ASSESSMENT — numeric scoring system
# Demonstrates: lookup of string to decimal for individual factor scores.
# Demonstrates: computed risk score from accumulated factors.
# ============================================================================
field RiskFactors as lookup of string to decimal
field RiskScore as decimal default 0.0 nonnegative
field RiskCategory as choice of string("Preferred","Standard","Substandard","HighRisk","Decline") default "Standard"

# ============================================================================
# UNDERWRITING DECISION
# ============================================================================
field UnderwritingDecision as choice of string("Approved","Declined","Modified","Postponed","Deferred")
field ApprovedCoverage as money in 'USD'
field ApprovedPremium as money in 'USD'
field ApprovedTerm as integer default 0 nonnegative
field RatingMultiplier as decimal default 1.0 nonnegative

# ============================================================================
# MEDICAL INFORMATION
# ============================================================================
field HasMedicalExam as boolean default false
field MedicalExamDate as date optional
field ExamResult as string optional
field PrescribedMedications as string optional
field FamilyHistory as string optional
field TobaccoUse as choice of string("Never","Former","Current") optional
field TobaccoYearsQuit as integer optional

# ============================================================================
# RISK MODIFIERS
# ============================================================================
field HazardousHobbies as boolean default false
field HazardousOccupation as boolean default false
field TravelToHighRiskCountries as boolean default false
field AviationActivity as boolean default false

# ============================================================================
# UNDERWRITING LOG — append-only audit trail
# ============================================================================
field UnderwritingLog as log of string

# ============================================================================
# TIMESTAMPS
# ============================================================================
field ReceivedAt as instant
field InformationCompleteAt as instant optional
field RiskAssessedAt as instant optional
field QuoteGeneratedAt as instant optional
field DecidedAt as instant optional

# ============================================================================
# NOTES & COMMENTS
# ============================================================================
field UnderwriterNotes as string optional
field DecisionReason as string optional
field RequiredConditions as string optional

# ============================================================================
# RULES — Domain Invariants
# ============================================================================
rule RiskScore >= 0.0 and RiskScore <= 100.0
    because "Risk score must be between 0 and 100"

rule ApprovedCoverage.amount <= CoverageAmount.amount
    because "Approved coverage must not exceed requested coverage"

# ============================================================================
# STATES — 6 total lifecycle positions
# ============================================================================
state Received initial
state InformationGathering
state RiskAssessment
state QuoteGenerated
state Approved terminal
state Declined terminal
state Modified terminal

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.ApplicationNumber != ""
    because "Application number is required for underwriting"

# ============================================================================
# EVENT DECLARATIONS
# ============================================================================
event Create(
    ApplicationNumber as string notempty,
    ApplicantName as string notempty,
    ApplicantDateOfBirth as date,
    PolicyType as choice of string("Life","Health","Disability","Annuity","LongTermCare"),
    CoverageAmount as money in 'USD',
    PolicyTerm as integer) initial

event RequestInformation(InformationType as string notempty)
event SubmitMedicalExam(ExamDate as date, Result as string notempty)
event SubmitInformation(DocumentType as string notempty, Content as string notempty)

event CompleteInformationGathering

event AddRiskFactor(FactorName as string notempty, FactorScore as decimal)
event CompleteRiskAssessment

event GenerateQuote(
    RatingMultiplier as decimal,
    AdjustedPremium as money in 'USD',
    UnderwriterNotes as string optional)

event Approve
event Decline(Reason as string notempty, Conditions as string optional)
event Modify(
    NewCoverage as money in 'USD',
    NewPremium as money in 'USD',
    NewTerm as integer,
    Conditions as string notempty)

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in InformationGathering ensure InformationCompleteAt is set
    because "Information gathering must have a completion timestamp"

in RiskAssessment ensure RiskAssessedAt is set
    because "Risk assessment must have a completion timestamp"

in QuoteGenerated ensure QuoteGeneratedAt is set
    because "Quote generation must have a timestamp"

in Approved ensure DecidedAt is set
    because "Approved applications must have a decision timestamp"

in Declined ensure DecidedAt is set
    because "Declined applications must have a decision timestamp"

in Modified ensure DecidedAt is set
    because "Modified applications must have a decision timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — Received state setup
# --------------------------------------------------------------------------
from Received on Create
    -> set ApplicationNumber = Create.ApplicationNumber
    -> set ApplicantName = Create.ApplicantName
    -> set ApplicantDateOfBirth = Create.ApplicantDateOfBirth
    -> set PolicyType = Create.PolicyType
    -> set CoverageAmount = Create.CoverageAmount
    -> set PremiumRating = "Standard"
    -> set PolicyTerm = Create.PolicyTerm
    -> set ApprovedCoverage = '0.00 USD'
    -> set ApprovedPremium = '0.00 USD'
    -> set RiskScore = 0.0
    -> set RiskCategory = "Standard"
    -> set UnderwritingDecision = "Postponed"
    -> set RatingMultiplier = 1.0
    -> set ReceivedAt = now()
    -> set DecisionReason = ""
    -> transition Received

# --------------------------------------------------------------------------
# REQUEST INFORMATION — stay in Received or InformationGathering
# --------------------------------------------------------------------------
from Received on RequestInformation
    -> append UnderwritingLog "Information requested: " + RequestInformation.InformationType
    -> transition InformationGathering

from InformationGathering on RequestInformation
    -> append UnderwritingLog "Additional information requested: " + RequestInformation.InformationType
    -> no transition

# --------------------------------------------------------------------------
# SUBMIT MEDICAL EXAM — record exam results
# --------------------------------------------------------------------------
from Received on SubmitMedicalExam
    -> set HasMedicalExam = true
    -> set MedicalExamDate = SubmitMedicalExam.ExamDate
    -> set ExamResult = SubmitMedicalExam.Result
    -> append UnderwritingLog "Medical exam submitted"
    -> transition InformationGathering

from InformationGathering on SubmitMedicalExam
    -> set HasMedicalExam = true
    -> set MedicalExamDate = SubmitMedicalExam.ExamDate
    -> set ExamResult = SubmitMedicalExam.Result
    -> append UnderwritingLog "Medical exam results received"
    -> no transition

# --------------------------------------------------------------------------
# SUBMIT DOCUMENT — add supporting documentation
# --------------------------------------------------------------------------
from InformationGathering on SubmitInformation
    -> append UnderwritingLog "Document submitted: " + SubmitInformation.DocumentType
    -> no transition

# --------------------------------------------------------------------------
# COMPLETE INFORMATION — InformationGathering → RiskAssessment
# --------------------------------------------------------------------------
from InformationGathering on CompleteInformationGathering
    -> set InformationCompleteAt = now()
    -> append UnderwritingLog "Information gathering complete"
    -> transition RiskAssessment

# --------------------------------------------------------------------------
# ADD RISK FACTOR — accumulate scores in lookup
# --------------------------------------------------------------------------
from RiskAssessment on AddRiskFactor
    -> put RiskFactors AddRiskFactor.FactorName = AddRiskFactor.FactorScore
    -> no transition

# --------------------------------------------------------------------------
# COMPLETE RISK ASSESSMENT — compute aggregate risk category
# Demonstrates: specific guards first, then general case.
# --------------------------------------------------------------------------
from RiskAssessment on CompleteRiskAssessment
    -> set RiskAssessedAt = now()
    -> set RiskScore = 0.0
    -> append UnderwritingLog "Risk assessment completed"
    -> transition QuoteGenerated

# --------------------------------------------------------------------------
# GENERATE QUOTE — compute rating and premium
# Demonstrates: specific guards before general, with conditional outcomes.
# --------------------------------------------------------------------------
from QuoteGenerated on GenerateQuote when GenerateQuote.RatingMultiplier > 2.0
    -> reject "Rating multiplier cannot exceed 2.0"
from QuoteGenerated on GenerateQuote when GenerateQuote.AdjustedPremium.amount <= 0
    -> reject "Adjusted premium must be positive"
from QuoteGenerated on GenerateQuote
    -> set RatingMultiplier = GenerateQuote.RatingMultiplier
    -> set ApprovedPremium = GenerateQuote.AdjustedPremium
    -> set ApprovedCoverage = CoverageAmount
    -> set ApprovedTerm = PolicyTerm
    -> set UnderwriterNotes = GenerateQuote.UnderwriterNotes
    -> set QuoteGeneratedAt = now()
    -> append UnderwritingLog "Quote generated with multiplier"
    -> transition QuoteGenerated

# --------------------------------------------------------------------------
# APPROVE — QuoteGenerated → Approved
# --------------------------------------------------------------------------
from QuoteGenerated on Approve
    -> set UnderwritingDecision = "Approved"
    -> set DecidedAt = now()
    -> set RequiredConditions = ""
    -> set RiskCategory = "Preferred"
    -> append UnderwritingLog "Application approved"
    -> transition Approved

# --------------------------------------------------------------------------
# DECLINE — multi-outcome rejection with reason and conditions
# --------------------------------------------------------------------------
from QuoteGenerated on Decline when Decline.Conditions == ""
    -> set UnderwritingDecision = "Declined"
    -> set DecisionReason = Decline.Reason
    -> set DecidedAt = now()
    -> set RiskCategory = "Decline"
    -> append UnderwritingLog "Application declined: " + Decline.Reason
    -> transition Declined

# --------------------------------------------------------------------------
# MODIFY — adjust coverage, premium, and terms
# --------------------------------------------------------------------------
from QuoteGenerated on Modify when Modify.NewCoverage.amount > CoverageAmount.amount
    -> reject "Modified coverage must not exceed requested coverage"
from QuoteGenerated on Modify when Modify.NewPremium.amount <= 0
    -> reject "Modified premium must be positive"
from QuoteGenerated on Modify
    -> set UnderwritingDecision = "Modified"
    -> set ApprovedCoverage = Modify.NewCoverage
    -> set ApprovedPremium = Modify.NewPremium
    -> set ApprovedTerm = Modify.NewTerm
    -> set RequiredConditions = Modify.Conditions
    -> set DecisionReason = "Coverage and premium adjusted"
    -> set DecidedAt = now()
    -> set RiskCategory = "Standard"
    -> append UnderwritingLog "Application modified — new terms applied"
    -> transition Modified