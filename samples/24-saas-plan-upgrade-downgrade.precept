precept SaasPlanUpgradeAndDowngrade

# ============================================================================
# DOMAIN: SaaS Plan Management — Upgrade/Downgrade
# ============================================================================
# Demonstrates: choice-typed plan tiers, money types for proration, lookup
# for feature access, log for audit trail, guarded transitions with
# specific-before-general ordering, state constraints, conditional rules,
# and a rich state machine covering plan change lifecycle.
#
# Lifecycle:
#   Requested → Validated → Processing → Active/Rejected → EffectiveDatePending
#
# Key Precept features demonstrated:
#   - Choice-typed plan tiers and change types
#   - Money types for proration and fees
#   - Lookup for usage limits and feature access
#   - Log for audit trail
#   - Guarded transitions with specific-before-general ordering
#   - Event ensure constraints
#   - State constraints (plan limits enforcement)
#   - Conditional rules (proration calculations)

# ============================================================================
# SUBSCRIPTION IDENTIFICATION
# ============================================================================
field SubscriptionId as string
field CustomerName as string
field CustomerEmail as string

# ============================================================================
# PLAN CONFIGURATION
# ============================================================================
field CurrentPlan as choice of string("Free", "Pro Starter", "Pro", "Enterprise")
field TargetPlan as choice of string("Free", "Pro Starter", "Pro", "Enterprise")
field ChangeType as choice of string("Upgrade", "Downgrade")
field ChangeStatus as choice of string(
    "Requested",
    "Validated",
    "Processing",
    "Active",
    "Rejected",
    "EffectiveDatePending"
) default "Requested"
field EffectiveDate as instant optional
field RequestedAt as instant optional
field CompletedAt as instant optional
field RejectionReason as string
field ChangeDescription as string optional

# ============================================================================
# PRICING AND PRORATION
# ============================================================================
field Currency as currency default 'USD'
field CurrentMonthlyFee as money in 'USD' default '0.00 USD'
field NewMonthlyFee as money in 'USD' default '0.00 USD'
field ProrationAmount as money in 'USD' default '0.00 USD'
field ProrationCredit as money in 'USD' default '0.00 USD'
field TotalDue as money in 'USD' default '0.00 USD'
field DaysInPeriod as integer default 30 positive
field RemainingDays as integer default 0 nonnegative
field BillingCycleStart as instant optional

# ============================================================================
# DURATION FIELDS
# ============================================================================
field DeferralPeriod as duration default '30 days'

# ============================================================================
# USAGE LIMITS — lookup of metric to limit value
# ============================================================================
field CurrentLimits as lookup of string to integer
field TargetLimits as lookup of string to integer

# ============================================================================
# AUDIT LOG
# ============================================================================
field ChangeLog as log of string
field ChangeRequestNumber as integer default 0 nonnegative

# ============================================================================
# FEATURES
# ============================================================================
field FeatureAccess as lookup of string to boolean
field PendingFeatureAccess as lookup of string to boolean

# ============================================================================
# STATES
# ============================================================================
state Requested initial
state Validated
state Processing
state Active terminal
state Rejected terminal
state EffectiveDatePending

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================
in Validated ensure TargetPlan == "Free" or TargetPlan == "Pro Starter" or TargetPlan == "Pro" or TargetPlan == "Enterprise"
    because "Validated changes must have a valid target plan"
in Processing ensure NewMonthlyFee > '0.00 USD'
    because "Processing changes must have a calculated fee"
in Rejected ensure RejectionReason != ""
    because "Rejected changes must have a reason"
in EffectiveDatePending ensure EffectiveDate is set
    because "Pending changes must have an effective date"
in Active ensure CompletedAt is set
    because "Active changes must have a completion timestamp"

# ============================================================================
# EVENTS
# ============================================================================

# Entity construction
event Create(
    SubscriptionId as string notempty,
    CustomerName as string notempty,
    CustomerEmail as string notempty,
    CurrentPlan as choice of string("Free", "Pro Starter", "Pro", "Enterprise"),
    MonthlyFee as money in 'USD',
    TargetPlan as choice of string("Free", "Pro Starter", "Pro", "Enterprise"),
    ChangeType as choice of string("Upgrade", "Downgrade"),
    RejectionReason as string) initial

# Request a plan change
event RequestChange(
    TargetPlan as choice of string("Free", "Pro Starter", "Pro", "Enterprise"),
    ChangeDescription as string notempty,
    EffectiveDateAsInstant as instant)
on RequestChange ensure RequestChange.EffectiveDateAsInstant > now()
    because "Effective date must be in the future"

# Validate the change
event ValidateChange

# Reject the change
event RejectChange(Reason as string notempty)

# Approve and process
event ApproveChange

# Apply changes with proration
event ApplyProration(DaysRemaining as integer)

# Activate the change
event ActivateChange

# ============================================================================
# RULES
# ============================================================================
rule ProrationAmount >= '0.00 USD'
    because "Proration amount cannot be negative"
rule ProrationCredit >= '0.00 USD'
    because "Proration credit cannot be negative"
rule TotalDue >= '0.00 USD'
    because "Total due cannot be negative"

# ============================================================================
# TRANSITIONS
# ============================================================================

# CONSTRUCTION — Requested → Requested
from Requested on Create
    -> set SubscriptionId = Create.SubscriptionId
    -> set CustomerName = Create.CustomerName
    -> set CustomerEmail = Create.CustomerEmail
    -> set CurrentPlan = Create.CurrentPlan
    -> set CurrentMonthlyFee = Create.MonthlyFee
    -> set TargetPlan = Create.TargetPlan
    -> set ChangeType = Create.ChangeType
    -> set RejectionReason = Create.RejectionReason
    -> append ChangeLog "Subscription created: " + Create.SubscriptionId
    -> transition Requested

# Request change — Requested → Requested
from Requested on RequestChange
    -> set TargetPlan = RequestChange.TargetPlan
    -> set ChangeType = "Upgrade"
    -> set ChangeStatus = "Requested"
    -> set EffectiveDate = RequestChange.EffectiveDateAsInstant
    -> set RequestedAt = now()
    -> set ChangeRequestNumber = ChangeRequestNumber + 1
    -> set ChangeDescription = RequestChange.ChangeDescription
    -> append ChangeLog "Plan change requested"
    -> no transition

# Validate — Requested → Validated
from Requested on ValidateChange
    -> set ChangeStatus = "Validated"
    -> set NewMonthlyFee = '49.00 USD'
    -> set ProrationAmount = '0.00 USD'
    -> set ProrationCredit = '0.00 USD'
    -> set TotalDue = '0.00 USD'
    -> append ChangeLog "Change validated"
    -> transition Validated

# Reject from Requested
from Requested on RejectChange
    -> set ChangeStatus = "Rejected"
    -> set RejectionReason = RejectChange.Reason
    -> set CompletedAt = now()
    -> append ChangeLog "Change rejected"
    -> transition Rejected

# Process from Validated
from Validated on ApproveChange
    -> set ChangeStatus = "Processing"
    -> append ChangeLog "Change approved — processing"
    -> transition Processing

# Apply proration — Processing → Active
from Processing on ApplyProration
    -> set RemainingDays = ApplyProration.DaysRemaining
    -> set NewMonthlyFee = '49.00 USD'
    -> set ProrationCredit = CurrentMonthlyFee * RemainingDays / DaysInPeriod
    -> set TotalDue = '0.00 USD'
    -> set CurrentPlan = TargetPlan
    -> set CurrentMonthlyFee = NewMonthlyFee
    -> set CompletedAt = now()
    -> set ChangeStatus = "Active"
    -> append ChangeLog "Proration applied"
    -> transition Active

# Apply proration — Processing → EffectiveDatePending
from Processing on ApplyProration when RemainingDays > 0
    -> set RemainingDays = ApplyProration.DaysRemaining
    -> set EffectiveDate = now() + DeferralPeriod
    -> set ChangeStatus = "EffectiveDatePending"
    -> append ChangeLog "Deferred to effective date"
    -> transition EffectiveDatePending

# Activate pending changes
from EffectiveDatePending on ActivateChange
    -> set NewMonthlyFee = '49.00 USD'
    -> set CurrentPlan = TargetPlan
    -> set CurrentMonthlyFee = NewMonthlyFee
    -> set CompletedAt = now()
    -> set ChangeStatus = "Active"
    -> append ChangeLog "Changes activated on effective date"
    -> transition Active
