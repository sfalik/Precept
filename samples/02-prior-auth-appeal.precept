precept PriorAuthorizationAppeal

# ============================================================================
# HEALTHCARE APPEALS - FHIR-ALIGNED WORKFLOW
# Demonstrates: Multi-level review, document tracking, temporal deadlines,
# conditional routing, effective dating, appeal outcomes, CMS compliance
# ============================================================================

# ============================================================================
# ORIGINAL AUTHORIZATION REFERENCE
# ============================================================================
field OriginalAuthId as string notempty maxlength 50
field OriginalAuthDate as date
field OriginalProcedureCode as string notempty maxlength 20
field OriginalProcedureDescription as string notempty maxlength 500
field OriginalAuthorizedUnits as integer nonnegative
field OriginalAuthorizedAmount as money in 'USD'

# ============================================================================
# PATIENT IDENTIFICATION (FHIR Patient reference)
# ============================================================================
field PatientId as string notempty maxlength 50
field PatientName as string notempty maxlength 200
field DateOfBirth as date
field Gender as choice of string("Male", "Female", "Other")

# ============================================================================
# APPEAL IDENTIFICATION
# ============================================================================
field AppealId as string optional maxlength 50
field AppealType as choice of string("Internal", "External") ordered default "Internal"
field ReviewMechanism as choice of string("Peer-to-Peer", "Clinical", "Administrative") optional default "Administrative"
field AppealReason as choice of string(
    "Denied", "PartialDenial", "InsufficientAmount",
    "ProcedureNotCovered", "MedicalNecessityQuestion", "CodingError", "TimelyFiling",
    "OutOfNetwork", "StepTherapyNotMet", "PriorAuthorizationRequired",
    "FrequencyLimitExceeded", "ExperimentalInvestigational"
) ordered
field AppealDescription as string maxlength 2000

# ============================================================================
# CLINICAL EVIDENCE AND DOCUMENTATION (FHIR DocumentReference)
# ============================================================================
field ClinicalEvidence as set of string
field SupportingDocuments as log of string
field MedicalNecessityJustification as string optional maxlength 3000
field NewClinicalData as string optional maxlength 5000
field PeerToPeerNotes as string optional maxlength 2000
field ClinicalNotes as string optional maxlength 2000
field AppealStatus as string optional maxlength 100
field PeerToPeerCompletedAt as instant optional
field InformationRequestSentAt as instant optional
field InformationReceivedAt as instant optional
field ClinicalReviewStartedAt as instant optional
field AppealCompletedAt as instant optional

# ============================================================================
# TEMPORAL TRACKING - DEADLINES AND TIMELINES
# ============================================================================
field AppealFiledDate as instant
field AppealDeadline as instant
field ReviewStartDate as instant optional
field ClinicalReviewDate as instant optional
field DecisionDate as instant optional
field EffectiveDate as date optional
field ExpirationDate as date optional
field ResponseDeadline as instant
field ServiceDate as date optional
field UrgencyLevel as choice of string("Critical", "Urgent", "Standard", "Routine") ordered default "Standard"

# ============================================================================
# REVIEW PROCESS TRACKING
# ============================================================================
field AssignedReviewer as string optional maxlength 200
field ClinicalReviewer as string optional maxlength 200
field CaseManager as string optional maxlength 200
field ExternalReviewOrganization as string optional maxlength 200
field ReviewLevel as integer nonnegative default 1

# ============================================================================
# EXTERNAL REVIEW (IRO) TRACKING
# ============================================================================
field IROCaseNumber as string default ""
field ExternalReviewRequestedAt as instant default '1970-01-01T00:00:00Z'
field IRODecisionDate as instant default '1970-01-01T00:00:00Z'
field IROUpheldOriginalDecision as boolean optional

# ============================================================================
# PEER-TO-PEER PHYSICIAN DETAILS
# ============================================================================
field PeerToPeerPhysicianNPI as string optional maxlength 20
field PeerToPeerSpecialty as string optional maxlength 100

# ============================================================================
# RETROACTIVE APPROVAL FIELDS
# ============================================================================
field RetroactiveApprovalIndicator as boolean default false
field RetroactiveEffectiveDate as date optional
field RetroactiveAuthorizedUnits as integer nonnegative optional

# ============================================================================
# APPEAL OUTCOME
# ============================================================================
field AppealDecision as choice of string("Approved", "PartiallyApproved", "Denied", "Withdrawn") optional
field AppealDecisionCode as choice of string(
    "AU01", "AU02", "AD01", "AD02", "AD03", "AD04", "AD05", "WR01"
) optional
field DecisionRationale as string optional maxlength 3000
field ApprovedUnits as integer nonnegative default 0
field ApprovedAmount as money in 'USD' default '0.00 USD'
field CoverageLimit as money in 'USD' optional

# ============================================================================
# REQUESTED AMOUNTS (What the appellant is seeking)
# ============================================================================
field RequestedUnits as integer nonnegative optional
field RequestedAmount as money in 'USD' optional

# ============================================================================
# ICD-10 DIAGNOSIS CODES (Medical Necessity Support)
# ============================================================================
field ICD10Codes as set of string optional

# ============================================================================
# RULES - BASIC VALIDATION
# ============================================================================
rule OriginalAuthId != "" because "Original authorization ID is required"
rule PatientId != "" because "Patient identification is required"
rule PatientName != "" because "Patient name is required"
rule AppealFiledDate <= AppealDeadline because "Appeal filed date must be before or equal to the deadline"
rule ResponseDeadline >= AppealFiledDate because "Response deadline must be after or equal to the appeal filed date"    
rule ReviewLevel > 0 because "Review level must be a positive integer"

# ============================================================================
# CMS REGULATORY TIMEFRAME ENFORCEMENT RULES
# ============================================================================
# Urgent appeals (Critical or Urgent urgency level) must be decided within 72 hours (3 days)
rule AppealDeadline - AppealFiledDate <= '72 hours' when UrgencyLevel == "Critical" or UrgencyLevel == "Urgent" because "Urgent appeals must be decided within 72 hours per CMS requirements"

# Standard appeals must be decided within 15 calendar days per CMS MA requirements
rule AppealDeadline - AppealFiledDate <= '15 days' when UrgencyLevel == "Standard" because "Standard appeals must be decided within 15 calendar days per CMS MA requirements"

# Routine appeals must be decided within 14 calendar days per CMS Part D requirements
rule AppealDeadline - AppealFiledDate <= '14 days' when UrgencyLevel == "Routine" because "Routine appeals must be decided within 14 calendar days per CMS Part D requirements"

# ============================================================================
# IRO DEADLINE ENFORCEMENT
# ============================================================================
# Independent Review Organization must render decision within 45 calendar days
rule IRODecisionDate - ExternalReviewRequestedAt <= '45 days' when IROCaseNumber != "" because "IRO must render decision within 45 calendar days per CMS"

# ============================================================================
# STATES - APPEAL WORKFLOW
# ============================================================================
state Filed initial
state UnderReview
state ClinicalReview
state PeerToPeerReview
state ExternalReview
state DecisionMade
state InformationRequested
state Approved terminal success
state PartiallyApproved terminal success
state Denied terminal
state Withdrawn terminal

# ============================================================================
# EVENTS
# ============================================================================

# Initial appeal submission
event FileAppeal(
    OriginalAuthId as string notempty,
    OriginalAuthDate as date,
    OriginalProcedureCode as string notempty,
    OriginalProcedureDescription as string notempty,
    OriginalAuthorizedUnits as integer nonnegative,
    OriginalAuthorizedAmount as money in 'USD',
    PatientId as string notempty,
    PatientName as string notempty,
    DateOfBirth as date,
    Gender as choice of string("Male", "Female", "Other"),
    AppealType as choice of string("Internal", "External"),
    ReviewMechanism as choice of string("Peer-to-Peer", "Clinical", "Administrative"),
    AppealReason as choice of string("Denied", "PartialDenial", "InsufficientAmount", "ProcedureNotCovered", 
"MedicalNecessityQuestion", "CodingError", "TimelyFiling", "OutOfNetwork", "StepTherapyNotMet", 
"PriorAuthorizationRequired", "FrequencyLimitExceeded", "ExperimentalInvestigational") ordered,
    AppealDescription as string,
    ResponseDeadline as instant,
    UrgencyLevel as choice of string("Critical", "Urgent", "Standard", "Routine"),
    RequestedUnits as integer nonnegative optional,
    RequestedAmount as money in 'USD' optional,
    ServiceDate as date optional,
    ICD10Codes as set of string optional
) initial

# Review progression events
event AssignReviewer(ReviewerName as string notempty)
event StartReview
event StartClinicalReview(ReviewerName as string notempty)
event SubmitClinicalEvidence(ClinicalNotes as string notempty, SupportingDocs as set of string)
event SchedulePeerToPeer(PhysicianNPI as string, Specialty as string, ScheduledDate as instant)
event CompletePeerToPeerReview(PhysicianName as string notempty, Outcome as string, Notes as string)
event StartExternalReview(Organization as string notempty)

# Information management
event RequestAdditionalInformation(InformationNeeded as string notempty, Deadline as instant)
event ReceiveAdditionalInformation(DocumentName as string notempty, DocumentContent as string)

# IRO events
event AssignIRO(IROCaseNumber as string notempty)
event RecordIRODecision(DecisionDate as instant, UpheldOriginalDecision as boolean)

# Decision events
event MakeDecision(
    Decision as choice of string("Approved", "PartiallyApproved", "Denied", "Withdrawn"),
    DecisionCode as choice of string("AU01", "AU02", "AD01", "AD02", "AD03", "AD04", "AD05", "WR01"),
    Rationale as string,
    ApprovedUnits as integer nonnegative default 0,
    ApprovedAmount as money in 'USD' default '0.00 USD',
    EffectiveDate as date optional,
    RetroactiveApprovalIndicator as boolean optional,
    RetroactiveEffectiveDate as date optional,
    RetroactiveAuthorizedUnits as integer nonnegative optional
)

# Withdrawal
event WithdrawAppeal(Reason as string)

# Terminal routing events
event ApproveOutcome
event DenyOutcome
event PartiallyApproveOutcome

# ============================================================================
# TRANSITIONS
# ============================================================================

# FileAppeal - initial event transitions to Filed state
on FileAppeal
    -> set OriginalAuthId = FileAppeal.OriginalAuthId
    -> set OriginalAuthDate = FileAppeal.OriginalAuthDate
    -> set OriginalProcedureCode = FileAppeal.OriginalProcedureCode
    -> set OriginalProcedureDescription = FileAppeal.OriginalProcedureDescription
    -> set OriginalAuthorizedUnits = FileAppeal.OriginalAuthorizedUnits
    -> set OriginalAuthorizedAmount = FileAppeal.OriginalAuthorizedAmount
    -> set PatientId = FileAppeal.PatientId
    -> set PatientName = FileAppeal.PatientName
    -> set DateOfBirth = FileAppeal.DateOfBirth
    -> set Gender = FileAppeal.Gender
    -> set AppealType = FileAppeal.AppealType
    -> set ReviewMechanism = FileAppeal.ReviewMechanism
    -> set AppealReason = FileAppeal.AppealReason
    -> set AppealDescription = FileAppeal.AppealDescription
    -> set ResponseDeadline = FileAppeal.ResponseDeadline
    -> set UrgencyLevel = FileAppeal.UrgencyLevel
    -> set RequestedUnits = FileAppeal.RequestedUnits
    -> set RequestedAmount = FileAppeal.RequestedAmount
    -> set ServiceDate = FileAppeal.ServiceDate
    -> set ICD10Codes = FileAppeal.ICD10Codes
    -> set AppealFiledDate = now()
    -> set AppealDeadline = FileAppeal.ResponseDeadline
    -> set ReviewLevel = 1

# From Filed - assign reviewer and start review
from Filed on AssignReviewer
    -> set AssignedReviewer = AssignReviewer.ReviewerName
    -> set AppealId = "APL-" + OriginalAuthId
    -> transition UnderReview

from Filed on StartReview
    -> set ReviewStartDate = now()
    -> transition UnderReview

# From UnderReview - various progression paths
from UnderReview on StartClinicalReview
    -> set ClinicalReviewer = StartClinicalReview.ReviewerName
    -> set ClinicalReviewDate = now()
    -> transition ClinicalReview

from UnderReview on SchedulePeerToPeer
    -> set PeerToPeerPhysicianNPI = SchedulePeerToPeer.PhysicianNPI
    -> set PeerToPeerSpecialty = SchedulePeerToPeer.Specialty
    -> set ReviewLevel = ReviewLevel + 1
    -> transition PeerToPeerReview

from UnderReview on SubmitClinicalEvidence
    -> set MedicalNecessityJustification = SubmitClinicalEvidence.ClinicalNotes
    -> no transition

# MakeDecision from UnderReview requires clinical evidence (F6: guard against bypass)
from UnderReview on MakeDecision when ClinicalReviewDate is set or PeerToPeerCompletedAt is set
    -> set AppealDecision = MakeDecision.Decision
    -> set AppealDecisionCode = MakeDecision.DecisionCode
    -> set DecisionRationale = MakeDecision.Rationale
    -> set ApprovedUnits = MakeDecision.ApprovedUnits
    -> set ApprovedAmount = MakeDecision.ApprovedAmount
    -> set EffectiveDate = MakeDecision.EffectiveDate
    -> set RetroactiveApprovalIndicator = MakeDecision.RetroactiveApprovalIndicator
    -> set RetroactiveEffectiveDate = MakeDecision.RetroactiveEffectiveDate
    -> set RetroactiveAuthorizedUnits = MakeDecision.RetroactiveAuthorizedUnits
    -> set DecisionDate = now()
    -> transition DecisionMade

from UnderReview on RequestAdditionalInformation
    -> set InformationRequestSentAt = now()
    -> transition InformationRequested

from UnderReview on WithdrawAppeal
    -> set AppealDecision = 'Withdrawn'
    -> set AppealDecisionCode = 'WR01'
    -> set DecisionDate = now()
    -> transition Withdrawn

# From ClinicalReview - multi-level review paths
from ClinicalReview on SubmitClinicalEvidence
    -> set MedicalNecessityJustification = SubmitClinicalEvidence.ClinicalNotes
    -> no transition

from ClinicalReview on SchedulePeerToPeer
    -> set PeerToPeerPhysicianNPI = SchedulePeerToPeer.PhysicianNPI
    -> set PeerToPeerSpecialty = SchedulePeerToPeer.Specialty
    -> set ReviewLevel = ReviewLevel + 1
    -> transition PeerToPeerReview

from ClinicalReview on CompletePeerToPeerReview when PeerToPeerPhysicianNPI is set
    -> set PeerToPeerNotes = CompletePeerToPeerReview.Notes
    -> set ClinicalReviewer = CompletePeerToPeerReview.PhysicianName
    -> set PeerToPeerCompletedAt = now()
    -> set ReviewLevel = ReviewLevel + 1
    -> transition ClinicalReview

from ClinicalReview on MakeDecision
    -> set AppealDecision = MakeDecision.Decision
    -> set AppealDecisionCode = MakeDecision.DecisionCode
    -> set DecisionRationale = MakeDecision.Rationale
    -> set ApprovedUnits = MakeDecision.ApprovedUnits
    -> set ApprovedAmount = MakeDecision.ApprovedAmount
    -> set EffectiveDate = MakeDecision.EffectiveDate
    -> set RetroactiveApprovalIndicator = MakeDecision.RetroactiveApprovalIndicator
    -> set RetroactiveEffectiveDate = MakeDecision.RetroactiveEffectiveDate
    -> set RetroactiveAuthorizedUnits = MakeDecision.RetroactiveAuthorizedUnits
    -> set DecisionDate = now()
    -> transition DecisionMade

from ClinicalReview on WithdrawAppeal
    -> set AppealDecision = 'Withdrawn'
    -> set AppealDecisionCode = 'WR01'
    -> set DecisionDate = now()
    -> transition Withdrawn

# From PeerToPeerReview - now reachable via SchedulePeerToPeer from UnderReview or ClinicalReview
from PeerToPeerReview on CompletePeerToPeerReview when PeerToPeerPhysicianNPI is set
    -> set PeerToPeerNotes = CompletePeerToPeerReview.Notes
    -> set ClinicalReviewer = CompletePeerToPeerReview.PhysicianName
    -> set PeerToPeerCompletedAt = now()
    -> set ReviewLevel = ReviewLevel + 1
    -> transition ClinicalReview

from PeerToPeerReview on MakeDecision
    -> set AppealDecision = MakeDecision.Decision
    -> set AppealDecisionCode = MakeDecision.DecisionCode
    -> set DecisionRationale = MakeDecision.Rationale
    -> set ApprovedUnits = MakeDecision.ApprovedUnits
    -> set ApprovedAmount = MakeDecision.ApprovedAmount
    -> set EffectiveDate = MakeDecision.EffectiveDate
    -> set RetroactiveApprovalIndicator = MakeDecision.RetroactiveApprovalIndicator
    -> set RetroactiveEffectiveDate = MakeDecision.RetroactiveEffectiveDate
    -> set RetroactiveAuthorizedUnits = MakeDecision.RetroactiveAuthorizedUnits
    -> set DecisionDate = now()
    -> transition DecisionMade

# From ExternalReview
from ExternalReview on MakeDecision
    -> set AppealDecision = MakeDecision.Decision
    -> set AppealDecisionCode = MakeDecision.DecisionCode
    -> set DecisionRationale = MakeDecision.Rationale
    -> set ApprovedUnits = MakeDecision.ApprovedUnits
    -> set ApprovedAmount = MakeDecision.ApprovedAmount
    -> set EffectiveDate = MakeDecision.EffectiveDate
    -> set RetroactiveApprovalIndicator = MakeDecision.RetroactiveApprovalIndicator
    -> set RetroactiveEffectiveDate = MakeDecision.RetroactiveEffectiveDate
    -> set RetroactiveAuthorizedUnits = MakeDecision.RetroactiveAuthorizedUnits
    -> set DecisionDate = now()
    -> transition DecisionMade

from ExternalReview on RecordIRODecision
    -> set IRODecisionDate = RecordIRODecision.DecisionDate
    -> set IROUpheldOriginalDecision = RecordIRODecision.UpheldOriginalDecision
    -> transition DecisionMade

# From InformationRequested
from InformationRequested on ReceiveAdditionalInformation
    -> set ClinicalNotes = ReceiveAdditionalInformation.DocumentContent
    -> set InformationReceivedAt = now()
    -> transition ClinicalReview

from InformationRequested on WithdrawAppeal
    -> set AppealDecision = 'Withdrawn'
    -> set AppealDecisionCode = 'WR01'
    -> set DecisionDate = now()
    -> transition Withdrawn

# Request information - transitions to InformationRequested
from ClinicalReview on RequestAdditionalInformation
    -> set AppealStatus = 'InformationRequested'
    -> set InformationRequestSentAt = now()
    -> transition InformationRequested

# External review initiation
from DecisionMade on StartExternalReview
    -> set ExternalReviewOrganization = StartExternalReview.Organization
    -> set ExternalReviewRequestedAt = now()
    -> transition ExternalReview

# IRO assignment - F4: only from DecisionMade (after internal process exhausted)
from DecisionMade on AssignIRO
    -> set IROCaseNumber = AssignIRO.IROCaseNumber
    -> set ExternalReviewRequestedAt = now()
    -> transition ExternalReview

from DecisionMade on ApproveOutcome
    -> set AppealDecision = 'Approved'
    -> transition Approved

from DecisionMade on PartiallyApproveOutcome
    -> set AppealDecision = 'PartiallyApproved'
    -> transition PartiallyApproved

from DecisionMade on DenyOutcome
    -> set AppealDecision = 'Denied'
    -> transition Denied

# ============================================================================
# STATE ACTIONS (Entry/Exit Hooks)
# ============================================================================

to Filed -> set AppealStatus = 'Filed'

to UnderReview -> set ReviewStartDate = now()

to ClinicalReview -> set ClinicalReviewStartedAt = now()

from DecisionMade -> set AppealCompletedAt = now()

# ============================================================================
# ACCESS MODES - Field visibility by state
# ============================================================================

in Filed modify AppealDescription editable
in UnderReview modify ClinicalNotes editable
in ClinicalReview modify MedicalNecessityJustification, NewClinicalData editable
in DecisionMade modify DecisionRationale editable