precept RefundRequest

# A customer refund request — the customer enriches order details, reason, and
# requested amount in Draft, submits for review, and the merchant approves or
# declines. Approved refunds require the returned merchandise to be received
# before the refund is finalized. Free-Construction Pattern: the customer fills
# in the order context progressively rather than supplying everything atomically.

# Identity and reason — filled progressively in Draft.
field OrderId as string optional maxlength 50
field CustomerEmail as string optional maxlength 200
field ReasonText as string optional maxlength 2000

# Monetary fields — money in 'USD' for exactness. Requested is set in Draft;
# Approved is meaningful only from AwaitingReturn onward.
field RequestedAmount as money in 'USD' default '0.00 USD'
field ApprovedAmount as money in 'USD' default '0.00 USD'

# Return tracking
field ReturnReceived as boolean default false

# Decision note — populated on every terminal transition.
field DecisionNote as string optional maxlength 2000

# Rules — approved cannot exceed requested. The omit in early states keeps the
# invariant scoped to states where both sides have business meaning.
rule ApprovedAmount <= RequestedAmount because "Approved amount {ApprovedAmount} cannot exceed the submitted request of {RequestedAmount}"

# States
state Draft initial
state Submitted
state AwaitingReturn
state Refunded terminal
state Declined terminal

# ApprovedAmount has no meaning before adjudication.
in Draft, Submitted omit ApprovedAmount

# Editable windows
in Draft modify OrderId, CustomerEmail, ReasonText, RequestedAmount editable
in Submitted modify ReasonText editable

# State ensures
in AwaitingReturn ensure ApprovedAmount > '0.00 USD' because "An awaiting-return refund must have a positive approved amount on record"
in Refunded ensure ReturnReceived because "A refunded request must have the returned merchandise on record — refunds without returns are unauthorized"

# Events
event Submit
on Submit ensure RequestedAmount > '0.00 USD' because "A refund must specify a positive requested amount before submission — zero-amount requests have no commercial meaning"

event Approve(Amount as money in 'USD', Note as string optional maxlength 2000)
on Approve ensure Approve.Amount > '0.00 USD' because "The approved refund amount must be positive — declines have their own event"

event Decline(Note as string notempty maxlength 2000)
event MarkReturnReceived
event Cancel(Reason as string optional maxlength 2000)

# Submit — full intake must be on record before review.
from Draft on Submit when OrderId is set and CustomerEmail is set and ReasonText is set
    -> transition Submitted
from Draft on Submit
    -> reject "Order ID, customer email, and reason are all required before submission — the merchant cannot triage without them"

# Approval — approved amount must not exceed the submitted request.
from Submitted on Approve when Approve.Amount <= RequestedAmount
    -> set ApprovedAmount = Approve.Amount
    -> set DecisionNote = Approve.Note
    -> transition AwaitingReturn
from Submitted on Approve
    -> reject "Cannot approve {Approve.Amount} — the submitted request is only {RequestedAmount}"

# Decline and cancellation — both terminate without refund.
from Submitted on Decline
    -> set DecisionNote = Decline.Note
    -> transition Declined
from Submitted on Cancel
    -> set DecisionNote = Cancel.Reason
    -> transition Declined

# Return confirmation completes the refund.
from AwaitingReturn on MarkReturnReceived
    -> set ReturnReceived = true
    -> transition Refunded
