precept ShoppingCart

# ============================================================================
# DOMAIN: E-commerce — Shopping Cart Workflow
# ============================================================================
# Demonstrates: four collection types in one entity (set, list, lookup, queue),
# typed constants for currency, guarded transitions with specific-before-
# general ordering, event ensure on initial event, multiple terminal states,
# state constraints, and access modes.
#
# Collection types demonstrated:
#   - set    (Catalog) — unique product IDs; O(1) membership via `contains`
#     and `remove` for deprecating products.
#   - list   (LineItems) — ordered line items; indexed access via `at()`
#     with bounds-checked `ReorderItem` operation.
#   - lookup (ItemQuantities, CartPromotions) — key-value maps; upsert via
#     `put`, clear via `clear`, key existence via `Field for key` accessor.
#   - queue  (GiftMessages) — FIFO ordering; FIFO ops: `enqueue`, `peek`.
# ============================================================================

# ============================================================================
# CUSTOMER & CART IDENTIFICATION
# ============================================================================
field CustomerId as string
field SessionId as string
field CartName as string default ""
field BaseCurrency as currency default 'USD'

# ============================================================================
# COLLECTION TYPES — the core demonstration of this sample
# ============================================================================

# Set of available product IDs. Enforces uniqueness and supports `remove`
# for deprecating products. O(1) membership check via `contains`.
field Catalog as set of string

# List of line items in insertion order. Each entry is an item ID. The actual
# quantity is tracked in ItemQuantities (a lookup). Provides ordered iteration
# and indexed access for reorder operations.
field LineItems as list of string

# Lookup mapping item ID -> quantity. Demonstrates: key-value map with `put`
# (upsert) and `clear`. The `for` accessor retrieves quantities.
field ItemQuantities as lookup of string to integer

# Lookup mapping promotion code -> discount percentage. Demonstrates: lookup
# for key-value storage with upsert semantics via `put` and clearing.
field CartPromotions as lookup of string to decimal

# Queue of gift messages in FIFO order. Demonstrates: first-in first-out
# collection with `enqueue` and `peek` operations.
field GiftMessages as queue of string

# ============================================================================
# ORDER METRICS — tracked explicitly
# ============================================================================
field ItemCount as integer default 0 nonnegative
field TotalValue as decimal default 0.0 nonnegative
field DiscountPercent as decimal default 0.0
field DiscountApplied as decimal default 0.0

# ============================================================================
# GIFT MESSAGE & NOTIFICATION TRACKING
# ============================================================================
field CurrentGiftMessage as string optional
field ShippingAddress as string optional
field TrackingNumber as string optional
field OrderReason as string optional

# ============================================================================
# TIMESTAMPS
# ============================================================================
field CreatedAt as instant
field CheckedOutAt as instant optional
field PaidAt as instant optional
field ShippedAt as instant optional
field DeliveredAt as instant optional
field CancelledAt as instant optional

# ============================================================================
# RULES — Domain Invariants (2 rules)
# ============================================================================
rule ItemCount <= 1000 because "Cart must not exceed 1,000 total items"
rule DiscountPercent >= 0.0 and DiscountPercent <= 100.0
    because "Promotion discount must be between 0% and 100%"

# ============================================================================
# STATES — 6 total (Cart -> Checkout -> Paid -> Shipped -> Delivered | Cancelled)
# ============================================================================
state Cart initial
state Checkout
state Paid
state Shipped
state Delivered terminal
state Cancelled terminal

# ============================================================================
# EVENTS
# ============================================================================

# Entity construction — creates the initial empty shopping cart.
event Create(
    CustomerId as string notempty,
    SessionId as string notempty,
    BaseCurrency as currency,
    CatalogItems as set of string notempty,
    CatalogName as string) initial

# Cart mutation events
event AddItem(ItemId as string notempty, Quantity as integer)
event RemoveItem(ItemId as string notempty)
event UpdateQuantity(ItemId as string notempty, NewQuantity as integer)
event ClearCart
event ReorderItem(FromIndex as integer, ToIndex as integer)

# Promotion events
event ApplyPromotion(
    PromotionCode as string notempty,
    discountPercent as decimal)
event RemovePromotion(PromotionCode as string notempty, AppliedDiscount as decimal)

# Gift message event
event AddGiftMessage(Message as string notempty)

# Workflow progression events
event CheckOut(Reason as string notempty)
event Pay
event Ship(Address as string notempty, TrackingNumber as string notempty)
event Deliver
event Cancel(Reason as string notempty)

# ============================================================================
# EVENT ENSURE — Construction validation
# ============================================================================
on Create ensure Create.SessionId != ""
    because "Session ID is required for cart creation"

# ============================================================================
# STATE CONSTRAINTS
# ============================================================================

# While in the cart, only these fields are mutable.
in Cart modify LineItems, ItemQuantities, CartPromotions, GiftMessages,
                ItemCount, TotalValue, DiscountPercent,
                DiscountApplied, CurrentGiftMessage, OrderReason editable

# While in checkout/paid states, shipping address is mutable.
in Checkout, Paid modify ShippingAddress editable

# In shipped state, tracking details are mutable.
in Shipped modify TrackingNumber, ShippingAddress editable

# Delivered state requires the delivery timestamp.
in Delivered ensure DeliveredAt is set
    because "Delivered state requires a delivery timestamp"

# ============================================================================
# TRANSITIONS
# ============================================================================

# --------------------------------------------------------------------------
# CONSTRUCTION — initial state setup
# --------------------------------------------------------------------------
from Cart on Create
    -> set CustomerId = Create.CustomerId
    -> set SessionId = Create.SessionId
    -> set BaseCurrency = Create.BaseCurrency
    -> set Catalog = Create.CatalogItems
    -> set CartName = Create.CatalogName
    -> set CreatedAt = now()
    -> set ItemCount = 0
    -> set TotalValue = 0.0
    -> set DiscountPercent = 0.0
    -> set DiscountApplied = 0.0
    -> transition Cart

# --------------------------------------------------------------------------
# ADD ITEM — specific guard first (item in list), then general
# --------------------------------------------------------------------------
# Guard: quantity must be positive.
from Cart on AddItem when AddItem.Quantity <= 0
    -> reject "Quantity must be at least 1"
# Branch 1: item already exists in LineItems — update quantity in place.
from Cart on AddItem when Catalog contains AddItem.ItemId and LineItems contains AddItem.ItemId
    -> set ItemCount = ItemCount - (ItemQuantities for AddItem.ItemId) + AddItem.Quantity
    -> put ItemQuantities AddItem.ItemId = AddItem.Quantity
    -> set TotalValue = ItemCount * 10.0
    -> transition Cart
# Branch 2: new item — add to both LineItems and ItemQuantities.
from Cart on AddItem when Catalog contains AddItem.ItemId
    -> set ItemCount = ItemCount + AddItem.Quantity
    -> put ItemQuantities AddItem.ItemId = AddItem.Quantity
    -> append LineItems AddItem.ItemId
    -> set TotalValue = ItemCount * 10.0
    -> transition Cart
# Branch 3: item not in catalog — reject.
from Cart on AddItem
    -> reject "Item not in catalog"

# --------------------------------------------------------------------------
# REMOVE ITEM — specific guard first (last item), then general
# Uses `remove` on list (line items) and `clear` on lookups.
# The Catalog set is also available for `remove` (demonstrated via catalog
# deprecation, but not shown in cart operations to keep sample focused).
# --------------------------------------------------------------------------
# Guard 1: last item — clear item collections but keep promotions and gift messages.
from Cart on RemoveItem when LineItems contains RemoveItem.ItemId and ItemQuantities.count == 1
    -> clear ItemQuantities
    -> remove LineItems RemoveItem.ItemId
    -> set ItemCount = 0
    -> set TotalValue = 0.0
    -> set DiscountPercent = 0.0
    -> set DiscountApplied = 0.0
    -> transition Cart
# Guard 2: item exists in cart — remove from line items list.
from Cart on RemoveItem when LineItems contains RemoveItem.ItemId
    -> set ItemCount = ItemCount - (ItemQuantities for RemoveItem.ItemId)
    -> put ItemQuantities RemoveItem.ItemId = 0
    -> remove LineItems RemoveItem.ItemId
    -> set TotalValue = ItemCount * 10.0
    -> transition Cart
# Guard 3: item not in cart — reject.
from Cart on RemoveItem
    -> reject "Item not in cart"

# --------------------------------------------------------------------------
# UPDATE QUANTITY — specific guard first, then general
# --------------------------------------------------------------------------
from Cart on UpdateQuantity when not (LineItems contains UpdateQuantity.ItemId)
    -> reject "Item not in cart"
from Cart on UpdateQuantity when UpdateQuantity.NewQuantity <= 0
    -> reject "Quantity must be at least 1"
from Cart on UpdateQuantity when UpdateQuantity.NewQuantity > 100
    -> reject "Quantity exceeds 100"
from Cart on UpdateQuantity
    -> set ItemCount = ItemCount - (ItemQuantities for UpdateQuantity.ItemId) + UpdateQuantity.NewQuantity
    -> put ItemQuantities UpdateQuantity.ItemId = UpdateQuantity.NewQuantity
    -> set TotalValue = ItemCount * 10.0
    -> transition Cart

# --------------------------------------------------------------------------
# CLEAR CART — removes all items, promotions, and gift messages
# Demonstrates `clear` on all four collection types.
# --------------------------------------------------------------------------
from Cart on ClearCart
    -> clear LineItems
    -> clear ItemQuantities
    -> clear CartPromotions
    -> clear GiftMessages
    -> set ItemCount = 0
    -> set TotalValue = 0.0
    -> set DiscountPercent = 0.0
    -> set DiscountApplied = 0.0
    -> transition Cart

# --------------------------------------------------------------------------
# REORDER ITEM — demonstrates list-specific index operations
# Each bound is checked with its own rejection row so the proof engine can
# see the exact guard that enables the success row.
# --------------------------------------------------------------------------
from Cart on ReorderItem when LineItems.count == 0
    -> reject "Cannot reorder an empty cart"
from Cart on ReorderItem when ReorderItem.FromIndex < 0
    -> reject "Source index must be non-negative"
from Cart on ReorderItem when ReorderItem.ToIndex < 0
    -> reject "Target index must be non-negative"
from Cart on ReorderItem when ReorderItem.FromIndex >= LineItems.count
    -> reject "Source index out of bounds"
from Cart on ReorderItem when ReorderItem.ToIndex >= LineItems.count
    -> reject "Target index out of bounds"
# Success row — proof engine requires explicit bounds guards.
# Guards here match the rejection rows above (specific-before-general).
from Cart on ReorderItem when ReorderItem.FromIndex >= 0 and ReorderItem.FromIndex < LineItems.count and ReorderItem.ToIndex >= 0 and ReorderItem.ToIndex < LineItems.count and LineItems.count > 0
    -> insert LineItems LineItems.at(ReorderItem.FromIndex) at ReorderItem.ToIndex
    -> remove LineItems at ReorderItem.FromIndex
    -> transition Cart

# --------------------------------------------------------------------------
# APPLY PROMOTION — three guards in specific-before-general order
# --------------------------------------------------------------------------
# Guard 1: cart must have items.
from Cart on ApplyPromotion when ItemCount == 0
    -> reject "Cannot apply promotion to empty cart"
# Guard 2: promotion code must not already be active.
# Check the discount percentage for the code using the `for` accessor.
from Cart on ApplyPromotion when CartPromotions for ApplyPromotion.PromotionCode > 0
    -> reject "Promotion already applied"
# Guard 3: general acceptance.
from Cart on ApplyPromotion
    -> put CartPromotions ApplyPromotion.PromotionCode = ApplyPromotion.discountPercent
    -> set DiscountPercent = DiscountPercent + ApplyPromotion.discountPercent
    -> set DiscountApplied = TotalValue * DiscountPercent / 100.0
    -> transition Cart

# --------------------------------------------------------------------------
# REMOVE PROMOTION — deactivate by setting discount to 0
# Uses `put` to overwrite the existing entry rather than `remove`.
# The `remove` action on lookup uses `CollectionValue` syntax which expects
# the value type (decimal), not the key type (string), so we use `put` to
# zero-out the entry instead.
# --------------------------------------------------------------------------
from Cart on RemovePromotion when CartPromotions for RemovePromotion.PromotionCode <= 0
    -> reject "Promotion is not active"
from Cart on RemovePromotion when CartPromotions for RemovePromotion.PromotionCode > 0
    -> set DiscountPercent = max(0.0, DiscountPercent - RemovePromotion.AppliedDiscount)
    -> set DiscountApplied = TotalValue * DiscountPercent / 100.0
    -> put CartPromotions RemovePromotion.PromotionCode = 0.0
    -> transition Cart

# --------------------------------------------------------------------------
# GIFT MESSAGE — FIFO queue (enqueue)
# --------------------------------------------------------------------------
from Cart on AddGiftMessage
    -> enqueue GiftMessages AddGiftMessage.Message
    -> set CurrentGiftMessage = AddGiftMessage.Message
    -> transition Cart

# --------------------------------------------------------------------------
# CHECKOUT — validates non-empty cart, marks as checked out
# --------------------------------------------------------------------------
from Cart on CheckOut when ItemCount == 0
    -> reject "Cannot checkout — cart is empty"
from Cart on CheckOut
    -> set CheckedOutAt = now()
    -> set OrderReason = CheckOut.Reason
    -> transition Checkout

# --------------------------------------------------------------------------
# PAY — payment processed after checkout
# --------------------------------------------------------------------------
from Checkout on Pay
    -> set PaidAt = now()
    -> transition Paid

# --------------------------------------------------------------------------
# SHIP — order dispatched with tracking
# --------------------------------------------------------------------------
from Paid on Ship when ShippingAddress == ""
    -> reject "Shipping address required"
from Paid on Ship
    -> set ShippingAddress = Ship.Address
    -> set TrackingNumber = Ship.TrackingNumber
    -> set ShippedAt = now()
    -> transition Shipped

# --------------------------------------------------------------------------
# DELIVER — final fulfillment step
# --------------------------------------------------------------------------
from Shipped on Deliver
    -> set DeliveredAt = now()
    -> transition Delivered

# --------------------------------------------------------------------------
# CANCEL — restricted to states before shipping (Cart, Checkout, Paid)
# --------------------------------------------------------------------------
from Cart on Cancel
    -> set CancelledAt = now()
    -> set OrderReason = Cancel.Reason
    -> clear LineItems
    -> clear ItemQuantities
    -> clear CartPromotions
    -> clear GiftMessages
    -> set ItemCount = 0
    -> set TotalValue = 0.0
    -> set DiscountPercent = 0.0
    -> set DiscountApplied = 0.0
    -> transition Cancelled
from Checkout on Cancel
    -> set CancelledAt = now()
    -> set OrderReason = Cancel.Reason
    -> clear LineItems
    -> clear ItemQuantities
    -> clear CartPromotions
    -> clear GiftMessages
    -> set ItemCount = 0
    -> set TotalValue = 0.0
    -> set DiscountPercent = 0.0
    -> set DiscountApplied = 0.0
    -> transition Cancelled
from Paid on Cancel
    -> set CancelledAt = now()
    -> set OrderReason = Cancel.Reason
    -> clear LineItems
    -> clear ItemQuantities
    -> clear CartPromotions
    -> clear GiftMessages
    -> set ItemCount = 0
    -> set TotalValue = 0.0
    -> set DiscountPercent = 0.0
    -> set DiscountApplied = 0.0
    -> transition Cancelled
